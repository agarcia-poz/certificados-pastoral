do a firmar…'); const k = await llamar('api_enviarAFirmar', cods, f.querySelector('#eMsg').value); cerrar(); aviso(k + ' certificado(s) enviados a firmar.'); P.etapa = 'firma'; vEnvios(); }\n            catch (e) { aviso(e.message); } finally { cargando(false); }\n          };\n        });\n      } else if (accion[0] === 'enviarAlumnado') {\n        if (!(await preguntar('Enviar al alumnado', 'Se enviará a ' + cods.length + ' persona(s) un correo privado con su código de descarga. El PDF no va adjunto: solo puede descargarlo quien tenga el código.', 'Enviar'))) return;\n        try { cargando(true, 'Enviando correos…'); const r = await llamar('api_enviarAlumnado', cods); aviso(r.enviados + ' enviado(s).' + (r.problemas.length ? ' ' + r.problemas.length + ' con problemas: ' + r.problemas.slice(0, 2).join(' · ') : '')); vEnvios(); }\n        catch (e) { aviso(e.message); } finally { cargando(false); }\n      } else if (accion[0] === 'reenviar') {\n        if (!(await preguntar('Reenviar el correo', 'Cada persona recibirá un código nuevo; el anterior dejará de servir.', 'Reenviar'))) return;\n        let k = 0; cargando(true, 'Reenviando…');\n        for (const c of cods) { try { await llamar('api_reenviar', c); k++; } catch (e) { aviso(c + ': ' + e.message); } }\n        cargando(false); aviso(k + ' reenviado(s).'); vEnvios();\n      }\n    };\n    v.querySelectorAll('[data-a]').forEach((b) => {\n      b.onclick = async () => {\n        const c = b.closest('tr').dataset.c, a = b.dataset.a;\n        const fila = lista.find((x) => x.codigo === c);\n        try {\n          if (a === 'pdf') { cargando(true); const r = await llamar('api_pdf', c); window.descargarArchivo(b64aBlob(r.base64, 'application/pdf'), r.nombre); }\n          if (a === 'corregir') modalCorregir({ persona: fila.persona, nombre: fila.nombre.split(' ')[0], apellidos: fila.nombre.split(' ').slice(1).join(' '), dniOculto: '', emailOculto: '' }, () => vEnvios());\n          if (a === 'rehacer' && await preguntar('¿Rehacer ' + c + '?', 'Se retira el PDF actual y vuelve a «Validada» para generarlo de nuevo con otro código.', 'Rehacer', true)) { await llamar('api_rehacer', c); vEnvios(); }\n          if (a === 'anular' && await preguntar('¿Anular ' + c + '?', 'La verificación pública dirá que no es válido y ya no se podrá descargar.', 'Anular', true)) { await llamar('api_anular', c); vEnvios(); }\n        } catch (e) { aviso(e.message); } finally { cargando(false); }\n      };\n    });\n  }\n\n  // ─────────── FIRMAR ───────────\n  async function vFirmar() {\n    const lista = await llamar('api_certificados', { misFirmas: true });\n    const u = P.usuario;\n    $('vFirmar').innerHTML = '<div class=\"pn-vista\">' + cab('Firmar', lista.length ? '<button class=\"boton primario\" id=\"descZip\">' + ic('descargar') + 'Descargar todos (ZIP)</button><button class=\"boton\" id=\"mailZip\">' + ic('correo') + 'Enviármelos por correo</button>' : '',\n      'Descarga los certificados, fírmalos con Autofirma (firma visible en tu hueco) y arrástralos aquí. No cambies el nombre de los archivos.') +\n      (!u.firmas.length && u.rol === 'admin' ? '<div class=\"nota\">' + ic('info') + '<div>No figuras como firmante en «Ajustes», pero como administración puedes subir PDF firmados por otra persona.</div></div>' : '') +\n      '<div class=\"rejilla r2\"><div class=\"caja\"><h2>' + ic('firma') + lista.length + ' certificado(s) esperan tu firma</h2>' +\n      (lista.length ? '<div class=\"lista-enlaces\">' + lista.map((c) => '<div><b>' + esc(c.nombre) + '<div class=\"ayuda\" style=\"font-weight:600\">' + esc(c.actividad) + ' · ' + esc(c.rol) + ' · ' + esc(c.codigo) + '</div></b><span class=\"chip c-magenta\">Firma ' + (c.firmas + 1) + ' de ' + c.totalFirmas + '</span></div>').join('') + '</div>'\n        : '<p class=\"ayuda\" style=\"margin:0\">Nada pendiente. Te avisaremos por correo cuando haya más.</p>') + '</div>' +\n      '<div><div class=\"soltar\" id=\"zona\" role=\"button\" tabindex=\"0\" aria-label=\"Subir los PDF firmados\">' + ic('subir') + '<b>Arrastra aquí los PDF firmados</b>o pulsa para elegirlos<input type=\"file\" id=\"archivos\" accept=\"application/pdf\" multiple class=\"oculto\"></div>' +\n      '<div id=\"resultados\" style=\"margin-top:14px\"></div></div></div></div>';\n    if ($('descZip')) $('descZip').onclick = () => descargarZip(lista);\n    if ($('mailZip')) $('mailZip').onclick = async () => { try { cargando(true, 'Preparando el correo…'); const n = await llamar('api_enviarmeZip'); aviso('Enviado: ' + n + ' PDF en un ZIP a tu correo.'); } catch (e) { aviso(e.message); } finally { cargando(false); } };\n    const zona = $('zona');\n    zona.onclick = () => $('archivos').click();\n    zona.onkeydown = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); $('archivos').click(); } };\n    $('archivos').onchange = (e) => subirFirmados([...e.target.files]);\n    zona.ondragover = (e) => { e.preventDefault(); zona.classList.add('encima'); };\n    zona.ondragleave = () => zona.classList.remove('encima');\n    zona.ondrop = (e) => { e.preventDefault(); zona.classList.remove('encima'); subirFirmados([...e.dataTransfer.files].filter((f) => /\\.pdf$/i.test(f.name))); };\n  }\n  async function descargarZip(lista) {\n    try {\n      cargando(true, 'Preparando el ZIP…');\n      const zip = new JSZip();\n      for (let k = 0; k < lista.length; k++) {\n        $('pnCargandoTxt').textContent = 'Preparando el ZIP… ' + (k + 1) + ' de ' + lista.length;\n        const r = await llamar('api_pdf', lista[k].codigo);\n        zip.file(r.nombre, r.base64, { base64: true });\n      }\n      window.descargarArchivo(await zip.generateAsync({ type: 'blob' }), 'Certificados para firmar.zip');\n      aviso('Descargado. Si no ves el archivo, usa «Enviármelos por correo».');\n    } catch (e) { aviso(e.message); } finally { cargando(false); }\n  }\n  async function subirFirmados(archivos) {\n    if (!archivos.length) return;\n    const res = $('resultados');\n    res.innerHTML = '<div class=\"caja\"><h3 id=\"resTitulo\">Subiendo ' + archivos.length + ' archivo(s)…</h3><div id=\"resLista\" aria-live=\"polite\"></div></div>';\n    let ok = 0;\n    for (const f of archivos) {\n      const linea = document.createElement('div'); linea.className = 'resultado'; linea.innerHTML = '<div class=\"girando\" style=\"width:16px;height:16px;border-width:2px\"></div><span>' + esc(f.name) + '…</span>'; $('resLista').appendChild(linea);\n      try {\n        const r = await llamar('api_subirFirmado', f.name, aBase64(await f.arrayBuffer()));\n        if (r.ok) { ok++; linea.className = 'resultado ok'; linea.innerHTML = ic('ok', 'peq') + '<span>' + esc(r.codigo) + (r.enviado ? ' · firmado y enviado al alumno/a' : r.firmado ? ' · firmas completas' : ' · pasa a ' + esc(r.siguiente)) + '</span>'; }\n        else { linea.className = 'resultado ko'; linea.innerHTML = ic('cerrar', 'peq') + '<span>' + esc(f.name) + ': ' + esc(r.motivo) + '</span>'; }\n      } catch (e) { linea.className = 'resultado ko'; linea.innerHTML = ic('cerrar', 'peq') + '<span>' + esc(f.name) + ': ' + esc(e.message) + '</span>'; }\n    }\n    try { await llamar('api_finSubida'); } catch (e) { }\n    $('resTitulo').textContent = 'Hecho: ' + ok + ' de ' + archivos.length + ' correcto(s).';\n    setTimeout(() => vFirmar().then(() => { $('resultados').replaceWith(res); }), 600);\n  }\n\n  // ─────────── VALORACIONES E INFORMES ───────────\n  function barras(filas, total) {\n    const max = Math.max(1, ...filas.map((f) => f[1]));\n    return '<div class=\"barras\">' + filas.map((f) => '<div class=\"fila-b\"><span>' + esc(f[0]) + '</span><span class=\"pista-b\"><i style=\"width:' + Math.round(f[1] / max * 100) + '%' + (f[2] ? ';background:' + f[2] : '') + '\"></i></span><span>' + f[1] + '</span></div>').join('') + '</div>';\n  }\n  function markdown(t) {\n    const lineas = esc(t).replace(/\\*\\*([^*]+)\\*\\*/g, '<b>$1</b>').split('\\n');\n    let html = '', enLista = false;\n    lineas.forEach((l) => {\n      const s = l.trim();\n      if (/^[-*•] /.test(s)) { if (!enLista) { html += '<ul>'; enLista = true; } html += '<li>' + s.replace(/^[-*•] /, '') + '</li>'; return; }\n      if (enLista) { html += '</ul>'; enLista = false; }\n      if (/^#{1,4} /.test(s)) html += '<h3>' + s.replace(/^#{1,4} /, '') + '</h3>';\n      else if (s) html += '<p>' + s + '</p>';\n    });\n    return html + (enLista ? '</ul>' : '');\n  }\n  async function vValoraciones(op) {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    if (op && op.act) P.actVal = op.act;\n    const sel = P.actVal && acts.some((a) => a.id === P.actVal) ? P.actVal : (acts.find((a) => a.nValoraciones) || acts[0] || {}).id || '';\n    P.actVal = sel;\n    if (!sel) { $('vValoraciones').innerHTML = '<div class=\"pn-vista\">' + cab('Valoraciones e informes') + vacio('grafico', 'Aún no hay actividades') + '</div>'; return; }\n    const [inf, lista] = await Promise.all([llamar('api_informe', sel), llamar('api_valoraciones', sel)]);\n    const e = inf.estadisticas;\n    const coment = lista.filter((v) => v.comentario), mejoras = lista.filter((v) => v.mejora);\n    const nEval = e.origen['evaluación'] || 0;\n    const part = e.inscritos && nEval ? Math.min(100, Math.round(nEval / e.inscritos * 100)) : null;\n    const COLORES = ['#E33229', '#F29100', '#C9B400', '#6DB33F', '#2BA962'];\n    $('vValoraciones').innerHTML = '<div class=\"pn-vista\">' + cab('Valoraciones e informes',\n      (inf.ia.configurada ? '<button class=\"boton ia\" id=\"vIa\">' + ic('ia') + (inf.guardado ? 'Rehacer el informe con IA' : 'Redactar informe con IA') + '</button>' : '') +\n      (lista.length ? '<button class=\"boton\" id=\"vDescargar\">' + ic('descargar') + 'Descargar informe</button>' : '') +\n      (coment.some((v) => v.citable) ? '<button class=\"boton\" id=\"vCitas\">' + ic('copiar') + 'Copiar citas para el boletín</button>' : ''),\n      'Las valoraciones son anónimas: nunca se guardan junto al nombre de quien responde.' + (inf.ia.configurada ? '' : ' Para redactar informes con IA, administración debe activarla en «Ajustes».')) +\n      '<div class=\"filtros\">' + selectorAct('vSel', acts, sel) + '<a href=\"#formularios\" class=\"boton fantasma\" id=\"vForm\">' + ic('formulario') + 'Editar la evaluación</a></div>' +\n      (!lista.length ? vacio('estrella', 'Aún no hay valoraciones', 'Abre la evaluación de la actividad y comparte el enlace (también llega en el correo del certificado).') :\n        '<div class=\"tiles\">' +\n          '<div class=\"tile t-azul\" style=\"cursor:default\"><span class=\"icono-tile\">' + ic('personas') + '</span><span class=\"n\">' + e.n + '</span><span class=\"t\">Respuestas' + (part != null ? ' · evaluación respondida por el ' + part + ' %' : '') + '</span></div>' +\n          '<div class=\"tile t-naranja\" style=\"cursor:default\"><span class=\"icono-tile\">' + ic('estrella') + '</span><span class=\"n\">' + (e.media == null ? '—' : num(e.media.toFixed(1))) + '</span><span class=\"t\">Valoración general (sobre 5)</span></div>' +\n          '<div class=\"tile t-verde\" style=\"cursor:default\"><span class=\"icono-tile\">' + ic('formulario') + '</span><span class=\"n\">' + e.comentarios + '</span><span class=\"t\">Comentarios</span></div>' +\n          '<div class=\"tile t-indigo\" style=\"cursor:default\"><span class=\"icono-tile\">' + ic('rayo') + '</span><span class=\"n\">' + e.mejoras + '</span><span class=\"t\">Propuestas de mejora</span></div></div>' +\n        (inf.guardado ? '<div class=\"caja informe\"><h2>' + ic('ia') + 'Informe<span class=\"acciones\"><span class=\"ayuda\">' + esc(inf.guardado.fecha) + ' · ' + inf.guardado.n + ' respuestas' + (inf.guardado.conComentarios ? '' : ' · sin comentarios') + '</span>' +\n          '<button class=\"boton peq\" id=\"vCopiarInf\">' + ic('copiar', 'peq') + 'Copiar</button></span></h2>' + markdown(inf.guardado.texto) +\n          '<p class=\"ayuda\" style=\"margin-top:14px\">Redactado con IA a partir de los datos y de comentarios anonimizados. Revísalo antes de compartirlo.</p></div>' : '') +\n        '<div class=\"rejilla r2\"><div class=\"caja\"><h3>Valoración general</h3>' + barras([5, 4, 3, 2, 1].map((n) => [n + ' de 5', e.dist[n - 1], COLORES[n - 1]])) + '</div>' +\n          e.preguntas.filter((q) => q.id !== 'general' && (q.tipo === 'escala' || q.opciones)).map((q) => '<div class=\"caja\"><h3>' + esc(q.texto) + '</h3>' +\n            (q.tipo === 'escala' ? '<p style=\"margin:0 0 6px\"><span class=\"grande\" style=\"font-size:30px\">' + (q.media == null ? '—' : num(q.media)) + '</span> <span class=\"ayuda\">media · ' + q.n + ' respuestas</span></p>' + barras([5, 4, 3, 2, 1].map((n) => [n + ' de 5', q.dist[n - 1], COLORES[n - 1]]))\n              : barras(q.opciones.map((o) => [o.o, o.n]))) + '</div>').join('') + '</div>' +\n        '<div class=\"rejilla r2\"><div class=\"caja\"><h3>' + ic('formulario') + 'Lo que se llevan (' + coment.length + ')</h3>' + (coment.length ? coment.map((v) => '<div class=\"cita\">' + esc(v.comentario) + '<small>' + (v.valor ? v.valor + ' de 5 · ' : '') + esc(v.fecha) + (v.citable ? ' · <b>se puede citar</b>' : '') + '</small></div>').join('') : '<p class=\"ayuda\">Sin comentarios.</p>') + '</div>' +\n          '<div class=\"caja\"><h3>' + ic('rayo') + 'Propuestas de mejora (' + mejoras.length + ')</h3>' + (mejoras.length ? mejoras.map((v) => '<div class=\"cita mejora\">' + esc(v.mejora) + '<small>' + esc(v.fecha) + '</small></div>').join('') : '<p class=\"ayuda\">Sin propuestas.</p>') + '</div></div>') + '</div>';\n    $('vSel').onchange = () => { P.actVal = $('vSel').value; vValoraciones(); };\n    $('vForm').onclick = (ev) => { ev.preventDefault(); ir('formularios', { act: sel, tipo: 'evaluacion' }); };\n    if ($('vCitas')) $('vCitas').onclick = () => copiar(coment.filter((v) => v.citable).map((v) => '«' + v.comentario + '»').join('\\n\\n'));\n    if ($('vCopiarInf')) $('vCopiarInf').onclick = () => copiar(inf.guardado.texto);\n    if ($('vIa')) $('vIa').onclick = async () => {\n      const ok = await preguntar('Redactar el informe con IA', 'Se enviarán a Groq las estadísticas' + (inf.ia.comentarios ? ' y los comentarios <b>anonimizados</b> (sin correos, DNI, teléfonos ni nombres de las personas inscritas)' : '') + '. Tarda unos segundos.', 'Redactar');\n      if (!ok) return;\n      try { cargando(true, 'La IA está analizando las valoraciones…'); await llamar('api_iaInforme', sel); vValoraciones(); } catch (x) { aviso(x.message); } finally { cargando(false); }\n    };\n    if ($('vDescargar')) $('vDescargar').onclick = () => {\n      const act = inf.actividad;\n      const html = '<!DOCTYPE html><html lang=\"es\"><head><meta charset=\"UTF-8\"><title>Informe · ' + esc(act.nombre) + '</title><style>body{font-family:Arial,sans-serif;max-width:780px;margin:30px auto;color:#1B2733;line-height:1.6;padding:0 16px}h1{font-size:24px;margin:0}h3{color:#0E5680}.franja{display:flex;height:6px;margin-bottom:20px}.franja i{flex:1}.dato{display:inline-block;margin:0 24px 10px 0}.dato b{font-size:26px;display:block}blockquote{border-left:3px solid #F29100;margin:8px 0;padding:4px 12px;background:#fffcf6}</style></head><body>' +\n        '<div class=\"franja\">' + ['#136EA1', '#E33229', '#F29100', '#2BA962', '#E3007C', '#33228A', '#925F2F'].map((c) => '<i style=\"background:' + c + '\"></i>').join('') + '</div>' +\n        '<h1>Informe de valoraciones</h1><p>' + esc(act.nombre) + (act.fechas ? ' · ' + esc(act.fechas) : '') + '<br>Servicio de Pastoral y Compromiso Solidario · C.U. «Sagrada Familia» · ' + new Date().toLocaleDateString('es-ES') + '</p>' +\n        '<div class=\"dato\"><b>' + e.n + '</b>respuestas</div><div class=\"dato\"><b>' + (e.media == null ? '—' : num(e.media.toFixed(1))) + '</b>valoración media</div><div class=\"dato\"><b>' + (part == null ? '—' : part + ' %') + '</b>participación</div>' +\n        '<h3>Reparto de la valoración general</h3><p>' + [5, 4, 3, 2, 1].map((n) => n + ' de 5: ' + e.dist[n - 1]).join(' · ') + '</p>' +\n        e.preguntas.filter((q) => q.id !== 'general' && (q.tipo === 'escala' || q.opciones)).map((q) => '<h3>' + esc(q.texto) + '</h3><p>' + (q.tipo === 'escala' ? 'Media: ' + (q.media == null ? '—' : num(q.media)) : q.opciones.map((o) => esc(o.o) + ': ' + o.n).join(' · ')) + '</p>').join('') +\n        (inf.guardado ? '<hr>' + markdown(inf.guardado.texto) : '') +\n        (coment.length ? '<h3>Lo que se llevan</h3>' + coment.map((v) => '<blockquote>' + esc(v.comentario) + '</blockquote>').join('') : '') +\n        (mejoras.length ? '<h3>Propuestas de mejora</h3><ul>' + mejoras.map((v) => '<li>' + esc(v.mejora) + '</li>').join('') + '</ul>' : '') + '</body></html>';\n      window.descargarArchivo(new Blob([html], { type: 'text/html' }), 'Informe ' + act.nombre.replace(/[^\\wáéíóúñü ]+/gi, ' ').trim().slice(0, 60) + '.html');\n      aviso('Descargado. Ábrelo en el navegador y usa «Imprimir › Guardar como PDF» si lo quieres en PDF.');\n    };\n  }\n\n  // ─────────── EQUIPO ───────────\n  async function vEquipo() {\n    const lista = await llamar('api_equipo');\n    const roles = { admin: 'Administración', coordinacion: 'Coordinación', firmante: 'Firmante' };\n    $('vEquipo').innerHTML = '<div class=\"pn-vista\">' + cab('Equipo', '<button class=\"boton primario\" id=\"nuevoM\">' + ic('mas') + 'Añadir persona</button>',\n      'Quién puede entrar y qué puede hacer. Cada persona entra con un código que recibe en su correo.') +\n      '<div class=\"rejilla r3\" style=\"margin-bottom:16px\"><div class=\"caja\" style=\"margin:0\"><h3>' + ic('escudo') + 'Administración</h3><p class=\"ayuda\" style=\"margin:0\">Todo, incluidos el equipo, la IA y el registro.</p></div>' +\n      '<div class=\"caja\" style=\"margin:0\"><h3>' + ic('calendario') + 'Coordinación</h3><p class=\"ayuda\" style=\"margin:0\">Actividades, formularios, inscripciones, diseño, envíos e informes.</p></div>' +\n      '<div class=\"caja\" style=\"margin:0\"><h3>' + ic('firma') + 'Firmante</h3><p class=\"ayuda\" style=\"margin:0\">Solo firmar los certificados que le tocan.</p></div></div>' +\n      '<div class=\"tabla-env\"><table class=\"tabla\"><thead><tr><th>Persona</th><th>Papel</th><th>Estado</th><th></th></tr></thead><tbody>' +\n      lista.map((m) => '<tr data-e=\"' + esc(m.email) + '\"><td><b>' + esc(m.nombre) + '</b><div class=\"ayuda\">' + esc(m.email) + '</div></td><td>' + esc(m.rolNombre) + '</td><td>' + (m.activo ? '<span class=\"chip c-verde\">Activa</span>' : '<span class=\"chip c-gris\">Sin acceso</span>') + '</td><td class=\"acc\"><button class=\"boton peq\">' + ic('lapiz', 'peq') + 'Editar</button></td></tr>').join('') +\n      '</tbody></table></div></div>';\n    const editar = (m) => modal('<h2>' + (m.email ? 'Editar persona' : 'Añadir persona') + '</h2>' +\n      '<label class=\"etq\" for=\"eEmail\">Correo</label><input type=\"email\" id=\"eEmail\" value=\"' + esc(m.email || '') + '\"' + (m.email ? ' readonly' : '') + '>' +\n      '<label class=\"etq\" for=\"eNombre\">Nombre</label><input type=\"text\" id=\"eNombre\" value=\"' + esc(m.nombre || '') + '\">' +\n      '<label class=\"etq\" for=\"eRol\">Papel</label><select id=\"eRol\">' + Object.keys(roles).map((r) => '<option value=\"' + r + '\"' + (r === (m.rol || 'coordinacion') ? ' selected' : '') + '>' + roles[r] + '</option>').join('') + '</select>' +\n      '<div style=\"margin-top:12px\">' + interruptor('eActivo', m.activo !== false, 'Puede entrar') + '</div>' +\n      (m.email ? '' : '<p class=\"ayuda\">Le llegará un correo de bienvenida con el enlace a la aplicación.</p>') +\n      '<div class=\"pie\"><button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"eGuardar\">Guardar</button></div>', (f, cerrar) => {\n      f.querySelector('#eGuardar').onclick = async () => {\n        try { await llamar('api_guardarMiembro', { email: f.querySelector('#eEmail').value, nombre: f.querySelector('#eNombre').value, rol: f.querySelector('#eRol').value, activo: f.querySelector('#eActivo').checked }); cerrar(); aviso('Guardado.'); vEquipo(); }\n        catch (e) { aviso(e.message); }\n      };\n    });\n    $('nuevoM').onclick = () => editar({});\n    $('vEquipo').querySelectorAll('tr[data-e] button').forEach((b) => { b.onclick = () => editar(lista.find((m) => m.email === b.closest('tr').dataset.e)); });\n  }\n\n  // ─────────── AJUSTES ───────────\n  async function vAjustes() {\n    const a = await llamar('api_ajustes');\n    const admin = P.usuario.rol === 'admin';\n    const equipo = admin ? await llamar('api_equipo') : [];\n    const opcionesEmail = (sel) => '<option value=\"\">— sin asignar —</option>' + equipo.filter((m) => m.activo).map((m) => '<option value=\"' + esc(m.email) + '\"' + (m.email === sel ? ' selected' : '') + '>' + esc(m.nombre) + ' · ' + esc(m.email) + '</option>').join('');\n    const filaF = (f, i) => '<div class=\"preg firm\"><div class=\"preg-cab\"><span class=\"n\">' + (i + 1) + '</span><b>Firma ' + (i + 1) + '</b>' + (admin ? '<span class=\"der\"><button class=\"boton peq peligro quitarF\">' + ic('papelera', 'peq') + 'Quitar</button></span>' : '') + '</div><div class=\"fila3\">' +\n      '<div><label class=\"etq\">Cargo</label><input type=\"text\" class=\"fCargo\" value=\"' + esc(f.cargo) + '\"' + (admin ? '' : ' readonly') + '></div>' +\n      '<div><label class=\"etq\">Nombre en el certificado</label><input type=\"text\" class=\"fNombre\" value=\"' + esc(f.nombre) + '\"' + (admin ? '' : ' readonly') + '></div>' +\n      '<div><label class=\"etq\">Quién firma <small>(del equipo)</small></label>' + (admin ? '<select class=\"fEmail\">' + opcionesEmail(f.email) + '</select>' : '<input type=\"text\" readonly value=\"' + esc(f.email || '—') + '\">') + '</div></div></div>';\n    const ia = a.ia;\n    $('vAjustes').innerHTML = '<div class=\"pn-vista\">' + cab('Ajustes') +\n      '<div class=\"caja\"><h2>' + ic('firma') + 'Firmantes, en orden de firma</h2>' +\n      '<p class=\"ayuda\" style=\"margin:-4px 0 12px\">Cada certificado pasa por estas personas en este orden. Quien firma tiene que estar en «Equipo».</p>' +\n      '<div id=\"listaF\">' + a.firmantes.map(filaF).join('') + '</div>' +\n      (admin ? '<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"boton\" id=\"masF\">' + ic('mas') + 'Añadir firmante</button><button class=\"boton primario\" id=\"guardarF\">Guardar firmantes</button></div>' : '') + '</div>' +\n      '<div class=\"caja\"><h2>' + ic('ia') + 'Inteligencia artificial (Groq)<span class=\"acciones\">' + (ia.configurada ? '<span class=\"chip c-verde\">' + ic('ok', 'peq') + 'Activada · clave ' + esc(ia.terminacion) + '</span>' : '<span class=\"chip c-gris\">Sin activar</span>') + '</span></h2>' +\n        '<p class=\"ayuda\" style=\"margin-top:-4px\">Redacta el texto de los certificados, propone formularios y escribe los informes de valoraciones. La clave se guarda cifrada en las propiedades privadas del script: no se muestra, no va al navegador y no está en el código.</p>' +\n        (admin ? '<div class=\"fila2\"><div><label class=\"etq\" for=\"iaClave\">' + (ia.configurada ? 'Cambiar la clave' : 'Clave de la API de Groq') + '</label><input type=\"password\" id=\"iaClave\" autocomplete=\"off\" placeholder=\"gsk_…\"></div>' +\n          '<div><label class=\"etq\" for=\"iaModelo\">Modelo</label><input type=\"text\" id=\"iaModelo\" value=\"' + esc(ia.modelo) + '\"></div></div>' +\n          '<div style=\"margin-top:10px\">' + interruptor('iaComent', ia.comentarios, 'Incluir los comentarios del alumnado (anonimizados) en los informes') + '</div>' +\n          '<div class=\"aviso\" style=\"margin-top:10px\">' + ic('aviso') + '<div>Groq es un proveedor de EE. UU. Antes de enviar los comentarios se quitan correos, DNI, teléfonos y los nombres de las personas inscritas. Conviene que el Delegado de Protección de Datos valide este uso; puedes desactivar el envío de comentarios con el interruptor.</div></div>' +\n          '<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"boton primario\" id=\"iaGuardar\">' + ic('llave') + 'Guardar</button>' + (ia.configurada ? '<button class=\"boton peligro\" id=\"iaBorrar\">Borrar la clave</button>' : '') + '</div>'\n          : '<p class=\"ayuda\" style=\"margin:0\">Solo administración puede cambiar estos ajustes.</p>') + '</div>' +\n      '<div class=\"caja\"><h2>' + ic('enlace') + 'Enlaces</h2><div class=\"lista-enlaces\">' + enlaceFila('Panel del equipo', a.urlApp) + enlaceFila('Inscripción general (todas las abiertas)', a.urlApp + '?p=inscripcion') + enlaceFila('Verificación pública', a.urlApp + '?p=verificar') + '</div>' +\n        '<p class=\"ayuda\" style=\"margin:10px 0 0\">Correos que Google te deja enviar hoy: <b>' + a.cuotaCorreo + '</b>.</p></div>' +\n      (admin ? '<div class=\"caja\"><h2>' + ic('candado') + 'Privacidad · cierre de curso</h2><p class=\"ayuda\" style=\"margin-top:0\">Sustituye los nombres por iniciales, borra de la bóveda a quien no tenga actividad en cursos posteriores (y sus respuestas), anula los códigos de descarga y retira los PDF de ese curso. La verificación sigue funcionando. No se puede deshacer.</p>' +\n        '<div class=\"enlace-copia\" style=\"max-width:440px\"><input type=\"text\" id=\"cursoAnon\" placeholder=\"2025-26\" aria-label=\"Curso\"><button class=\"boton peligro\" id=\"anonimizar\">Anonimizar curso</button></div></div>' : '') +\n      '<p class=\"ayuda\" style=\"margin-top:24px\">Versión ' + esc(a.version) + ' · <a href=\"' + esc(a.repo) + '\" target=\"_blank\" rel=\"noopener\">código fuente</a></p></div>';\n    enlazarEnlaces($('vAjustes'));\n    if (!admin) return;\n    const enlazarQuitar = () => $('listaF').querySelectorAll('.quitarF').forEach((b) => { b.onclick = () => b.closest('.firm').remove(); });\n    enlazarQuitar();\n    $('masF').onclick = () => { $('listaF').insertAdjacentHTML('beforeend', filaF({ cargo: '', nombre: '', email: '' }, $('listaF').children.length)); enlazarQuitar(); };\n    $('guardarF').onclick = async () => {\n      const lista = [...$('listaF').querySelectorAll('.firm')].map((d) => ({ cargo: d.querySelector('.fCargo').value, nombre: d.querySelector('.fNombre').value, email: d.querySelector('.fEmail').value }));\n      try { await llamar('api_guardarFirmantes', lista); aviso('Firmantes guardados.'); const u = await llamar('api_yo'); P.usuario = u; pintarMenu({}); vAjustes(); } catch (e) { aviso(e.message); }\n    };\n    $('iaGuardar').onclick = async () => {\n      try { cargando(true, 'Comprobando con Groq…'); await llamar('api_iaGuardar', { clave: $('iaClave').value.trim(), modelo: $('iaModelo').value.trim(), comentarios: $('iaComent').checked }); $('iaClave').value = ''; aviso('Ajustes de IA guardados.'); vAjustes(); }\n      catch (e) { aviso(e.message); } finally { cargando(false); }\n    };\n    if ($('iaBorrar')) $('iaBorrar').onclick = async () => { if (!(await preguntar('¿Borrar la clave de Groq?', 'La IA dejará de estar disponible hasta que guardes otra.', 'Borrar', true))) return; try { await llamar('api_iaGuardar', { borrar: true }); vAjustes(); } catch (e) { aviso(e.message); } };\n    $('anonimizar').onclick = async () => {\n      const c = $('cursoAnon').value.trim();\n      if (!(await preguntar('¿Anonimizar el curso ' + esc(c) + '?', 'Se aplicará a ese curso y a los anteriores. No se puede deshacer.', 'Anonimizar', true))) return;\n      try { aviso(await llamar('api_anonimizar', c)); } catch (e) { aviso(e.message); }\n    };\n  }\n\n  // ─────────── REGISTRO ───────────\n  async function vRegistro() {\n    const lista = await llamar('api_registro', 300);\n    $('vRegistro').innerHTML = '<div class=\"pn-vista\">' + cab('Registro', '', 'Las últimas 300 acciones. No guarda DNI ni correos del alumnado.') +\n      '<div class=\"tabla-env\"><table class=\"tabla\"><thead><tr><th>Fecha</th><th>Quién</th><th>Acción</th><th>Detalle</th></tr></thead><tbody>' +\n      lista.map((r) => '<tr><td style=\"white-space:nowrap\">' + esc(r.fecha) + '</td><td>' + esc(r.usuario) + '</td><td><b>' + esc(r.accion) + '</b></td><td class=\"ayuda\">' + esc(r.detalle) + '</td></tr>').join('') +\n      '</tbody></table></div></div>';\n  }\n\n  arrancar();\n})();\n</script>\n</body>\n</html>\n", "Editor": "<!-- Editor de diseño y generación: vista incrustada en el panel (Panel.html). -->\n<style>\n  /* Todo el estilo del editor va acotado a #vistaEditor para no pisar el del panel. */\n  #vistaEditor { position: relative; height: 100vh; font-size: 14px; }\n  #vistaEditor .app { display: grid; grid-template-rows: auto 1fr; height: 100vh; }\n  #vistaEditor header { display: flex; align-items: center; gap: 14px; padding: 12px 18px; background: #fff; border-bottom: 1px solid var(--borde); flex-wrap: wrap; }\n  #vistaEditor header h1 { font-size: 19px; margin: 0; }\n  #vistaEditor header select { width: auto; min-width: 300px; max-width: 100%; }\n  #vistaEditor .pestanas { display: inline-flex; gap: 4px; padding: 4px; background: #e9eef2; border-radius: 11px; margin-left: auto; }\n  #vistaEditor .pestanas button { border: 0; background: none; min-height: 38px; padding: 6px 14px; border-radius: 8px; font-weight: 700; cursor: pointer; color: var(--suave); display: inline-flex; align-items: center; gap: 8px; }\n  #vistaEditor .pestanas button.activa { background: #fff; color: var(--azul-osc); box-shadow: 0 1px 3px rgba(16,40,64,.14); }\n  #vistaEditor .contador { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 20px; padding: 0 6px; border-radius: 10px; background: var(--aviso-claro); color: var(--aviso); font-size: 12px; }\n  #vistaEditor main { display: grid; grid-template-columns: 450px 1fr; min-height: 0; }\n  #vistaEditor .panel { overflow-y: auto; background: #fff; border-right: 1px solid var(--borde); display: flex; flex-direction: column; min-height: 0; }\n  #vistaEditor .panel-scroll { flex: 1; overflow-y: auto; padding: 4px 18px 18px; }\n  #vistaEditor .panel-pie { border-top: 1px solid var(--borde); padding: 12px 18px; background: #fbfcfd; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n  #vistaEditor details { border-bottom: 1px solid var(--borde); padding: 12px 0; }\n  #vistaEditor summary { font-family: var(--titulos); font-weight: 600; cursor: pointer; color: var(--texto); font-size: 15.5px; list-style: none; display: flex; align-items: center; gap: 8px; min-height: 32px; }\n  #vistaEditor summary::-webkit-details-marker { display: none; }\n  #vistaEditor summary::after { content: ''; margin-left: auto; width: 8px; height: 8px; border-right: 2px solid var(--suave); border-bottom: 2px solid var(--suave); transform: rotate(45deg); transition: transform .15s ease; }\n  #vistaEditor details[open] summary::after { transform: rotate(-135deg); }\n  #vistaEditor label.e { display: block; font-weight: 700; margin: 12px 0 5px; font-size: 13px; color: var(--texto); }\n  #vistaEditor input[type=text], #vistaEditor textarea, #vistaEditor select { min-height: 40px; padding: 8px 10px; font-size: 14px; }\n  #vistaEditor textarea { min-height: 62px; }\n  #vistaEditor .fila { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n  #vistaEditor .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }\n  #vistaEditor .chip-campo { border: 1px solid var(--azul-borde); background: #fff; color: var(--azul-osc); border-radius: 12px; padding: 3px 9px; font-size: 12px; cursor: pointer; font-family: ui-monospace, Menlo, monospace; }\n  #vistaEditor .chip-campo:hover { background: var(--azul-claro); }\n  #vistaEditor .plantillas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }\n  #vistaEditor .plantilla { border: 2px solid var(--borde); border-radius: 10px; padding: 7px 4px 6px; cursor: pointer; text-align: center; font-size: 11.5px; background: #fff; color: var(--suave); font-weight: 600; }\n  #vistaEditor .plantilla:hover { border-color: var(--azul-borde); }\n  #vistaEditor .plantilla.activa { border-color: var(--azul); color: var(--azul-osc); }\n  #vistaEditor .plantilla canvas { display: block; margin: 0 auto 4px; border: 1px solid #e5ebf0; }\n  #vistaEditor .colores { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }\n  #vistaEditor .muestra { width: 32px; height: 26px; border-radius: 7px; cursor: pointer; border: 1px solid rgba(0,0,0,.15); position: relative; overflow: hidden; padding: 0; }\n  #vistaEditor .muestra span { position: absolute; right: 0; bottom: 0; width: 40%; height: 40%; }\n  #vistaEditor input[type=color] { width: 46px; height: 34px; padding: 2px; border: 1px solid var(--borde-fuerte); border-radius: 8px; background: #fff; min-height: 0; }\n  #vistaEditor .casilla { display: flex; align-items: center; gap: 10px; margin: 10px 0; font-weight: 600; font-size: 14px; cursor: pointer; }\n  #vistaEditor .casilla input { width: 18px; height: 18px; accent-color: var(--azul); }\n  #vistaEditor .vista-prev { display: flex; flex-direction: column; min-height: 0; background: #eef2f6; }\n  #vistaEditor .vista-barra { display: flex; gap: 10px; align-items: center; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--borde); flex-wrap: wrap; }\n  #vistaEditor .vista-barra select { width: auto; min-width: 190px; }\n  #vistaEditor .lienzo { flex: 1; overflow: auto; display: flex; justify-content: center; align-items: flex-start; padding: 20px; }\n  #vistaEditor .lienzo canvas { box-shadow: 0 10px 30px rgba(20,40,60,.18); background: #fff; border-radius: 2px; }\n  #vistaEditor .avisos { font-size: 13px; color: var(--aviso); font-weight: 600; flex-basis: 100%; min-height: 0; }\n  #vistaEditor .avisos:empty { display: none; }\n  #vistaEditor .estado-guardado { font-size: 13px; color: var(--suave); font-weight: 600; }\n  #vistaEditor .estado-guardado.sin { color: var(--aviso); }\n  #vistaEditor .ia-caja { background: linear-gradient(135deg, #f3f1fb, #eef6fb); border: 1px solid #dcd7f1; border-radius: 12px; padding: 12px; margin-top: 10px; }\n  #vistaEditor .ia-caja h4 { margin: 0 0 6px; font-size: 14px; color: var(--indigo); display: flex; align-items: center; gap: 6px; }\n  #vistaEditor .ia-caja textarea { min-height: 50px; }\n  #vistaEditor .persona { display: grid; grid-template-columns: 24px 1fr 1fr 36px; gap: 6px; align-items: center; padding: 10px 8px; border: 1px solid var(--borde); border-radius: 10px; margin-bottom: 8px; }\n  #vistaEditor .persona input[type=text], #vistaEditor .persona select { min-height: 36px; padding: 5px 8px; font-size: 13px; }\n  #vistaEditor .persona .sel { grid-row: span 2; width: 18px; height: 18px; accent-color: var(--azul); }\n  #vistaEditor .persona .ver { grid-row: span 2; height: 100%; min-height: 0; }\n  #vistaEditor .persona.mal input.dni { border-color: var(--mal); background: #fff6f5; }\n  #vistaEditor .persona.hecho { opacity: .5; }\n  #vistaEditor .persona .aviso-email { grid-column: 2 / span 2; font-size: 12px; color: var(--mal); font-weight: 600; }\n  #vistaEditor .barra-progreso { height: 10px; background: #e5ebf0; border-radius: 6px; overflow: hidden; margin: 10px 0 6px; }\n  #vistaEditor .barra-progreso div { height: 100%; width: 0; background: var(--ok); transition: width .2s; }\n  #vistaEditor .registro { font-size: 12.5px; max-height: 170px; overflow: auto; background: var(--fondo); border-radius: 8px; padding: 8px 10px; white-space: pre-wrap; }\n  #vistaEditor .vacio-e { padding: 30px 10px; text-align: center; color: var(--suave); }\n  #vistaEditor .cargando { position: absolute; inset: 0; background: rgba(244,247,250,.88); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 10px; z-index: 10; font-weight: 700; color: var(--azul-osc); text-align: center; padding: 20px; }\n  #vistaEditor .nota { margin: 10px 0; font-size: 13px; display: block; }\n  @media (max-width: 1000px) {\n    #vistaEditor, #vistaEditor .app { height: auto; }\n    #vistaEditor main { grid-template-columns: 1fr; }\n    #vistaEditor .lienzo { min-height: 520px; }\n    #vistaEditor header select { min-width: 0; width: 100%; }\n    #vistaEditor .pestanas { margin-left: 0; }\n  }\n</style>\n<section id=\"vistaEditor\" class=\"vista oculto\">\n<div class=\"app\">\n  <header>\n    <h1>Diseñar y generar</h1>\n    <select id=\"actividad\" aria-label=\"Actividad\"></select>\n    <span class=\"estado-guardado\" id=\"estadoGuardado\"></span>\n    <div class=\"pestanas\">\n      <button id=\"tabDiseno\" class=\"activa\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-paleta\"/></svg>Diseño</button>\n      <button id=\"tabGenerar\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-certificado\"/></svg>Generar <span class=\"contador\" id=\"contador\">0</span></button>\n    </div>\n  </header>\n  <main>\n    <!-- ───────────── PANEL DISEÑO ───────────── -->\n    <section class=\"panel\" id=\"panelDiseno\">\n      <div class=\"panel-scroll\">\n        <details open>\n          <summary>Estilo</summary>\n          <label class=\"e\">Plantilla</label>\n          <div class=\"plantillas\" id=\"plantillas\"></div>\n          <label class=\"e\">Colores</label>\n          <div class=\"fila\" style=\"flex:0\">\n            <div style=\"flex:0\"><input type=\"color\" id=\"color\" title=\"Color principal\"></div>\n            <div style=\"flex:0\"><input type=\"color\" id=\"acento\" title=\"Color de acento\"></div>\n            <div class=\"ayuda\" style=\"flex:1\">Principal (banda, nombre) y acento (filetes).<br>O elige una combinación:</div>\n          </div>\n          <div class=\"colores\" id=\"presets\"></div>\n          <label class=\"e\">Tipografía</label>\n          <select id=\"tipografia\"></select>\n          <div id=\"bloqueBanda\">\n            <label class=\"e\">Texto de la banda lateral</label>\n            <input type=\"text\" id=\"textoBanda\">\n          </div>\n        </details>\n\n        <details>\n          <summary>Fondo, logos y QR</summary>\n          <label class=\"e\">Fondo de página (imagen creada con otra IA, por ejemplo)</label>\n          <div class=\"fila\">\n            <button class=\"boton peq\" id=\"btnFondo\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-subir\"/></svg>Subir fondo…</button>\n            <button class=\"boton peq\" id=\"btnQuitarFondo\">Quitar fondo</button>\n          </div>\n          <input type=\"file\" id=\"archivoFondo\" accept=\"image/png,image/jpeg,image/webp\" class=\"oculto\">\n          <div class=\"ayuda\">Se recorta y adapta solo a A4 vertical. Consejo: con un fondo propio, la plantilla «Limpio» suele quedar mejor.</div>\n          <label class=\"e\">Velo blanco bajo el texto: <span id=\"veloValor\">0</span> %</label>\n          <input type=\"range\" id=\"velo\" min=\"0\" max=\"90\" step=\"5\" style=\"width:100%\">\n          <div class=\"ia-caja\">\n            <h4><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-ia\"/></svg>Crear el fondo con otra IA de imágenes</h4>\n            <input type=\"text\" id=\"ideaFondo\" placeholder=\"Idea: acuarela suave de olivos y luz de amanecer…\">\n            <div class=\"fila\" style=\"margin-top:6px\"><button class=\"boton peq\" id=\"btnPromptFondo\">Copiar instrucción para la IA</button></div>\n            <textarea id=\"promptFondo\" class=\"oculto\" readonly></textarea>\n          </div>\n          <label class=\"casilla\"><input type=\"checkbox\" id=\"logoSuperior\"> Logo superior</label>\n          <div class=\"fila\">\n            <button class=\"boton peq\" id=\"btnLogo\">Cambiar logo superior…</button>\n            <button class=\"boton peq\" id=\"btnLogoOriginal\">Volver al logo de Pastoral</button>\n          </div>\n          <input type=\"file\" id=\"archivoLogo\" accept=\"image/png,image/jpeg\" class=\"oculto\">\n          <label class=\"casilla\"><input type=\"checkbox\" id=\"logosPie\"> Logos SAFA y UJA al pie</label>\n          <label class=\"casilla\"><input type=\"checkbox\" id=\"qr\"> Código QR de verificación</label>\n        </details>\n\n        <details open>\n          <summary>Textos del certificado</summary>\n          <div class=\"nota\">Escribe <b>**así**</b> para negrita y <i>*así*</i> para cursiva. Los campos entre llaves se rellenan solos: pulsa uno para insertarlo donde está el cursor.\n            <div class=\"chips\" id=\"chips\"></div></div>\n          <label class=\"e\">Rótulo superior (opcional)</label><input type=\"text\" id=\"etiqueta\">\n          <label class=\"e\">Título</label><input type=\"text\" id=\"titulo\">\n          <label class=\"e\">Frase de entrada</label><input type=\"text\" id=\"intro\">\n          <label class=\"e\">Línea del DNI</label><input type=\"text\" id=\"lineaDni\">\n          <label class=\"e\">Párrafo principal</label><textarea id=\"cuerpo\"></textarea>\n          <label class=\"e\">Texto sobre la actividad (cada línea, un párrafo)</label>\n          <textarea id=\"descripcion\" style=\"min-height:120px\" placeholder=\"Pega aquí el texto generado con IA…\"></textarea>\n          <div class=\"ia-caja\">\n            <h4><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-ia\"/></svg>Texto con IA</h4>\n            <textarea id=\"notasIA\" placeholder=\"Qué se hizo, con quién, objetivos… (cuanto más concreto, mejor texto)\"></textarea>\n            <div class=\"ayuda\" id=\"iaContexto\"></div><div class=\"fila\" style=\"margin-top:8px\"><button class=\"boton peq ia\" id=\"btnIaTexto\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-ia\"/></svg>Redactar con IA</button><button class=\"boton peq\" id=\"btnPromptTexto\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-copiar\"/></svg>Copiar instrucción para otra IA</button></div>\n            <textarea id=\"promptTexto\" class=\"oculto\" readonly></textarea>\n            <div class=\"ayuda\">El texto aparece arriba, en «Texto sobre la actividad»: revísalo siempre antes de generar.</div>\n          </div>\n          <label class=\"e\">Frase de horas (solo si la actividad tiene horas)</label><textarea id=\"textoHoras\"></textarea>\n          <label class=\"e\">Frase de ECTS (solo si la actividad tiene ECTS)</label><textarea id=\"textoEcts\"></textarea>\n          <label class=\"e\">Cierre (opcional, por ejemplo con la fecha)</label>\n          <textarea id=\"cierre\" placeholder=\"Y para que así conste, se expide el presente certificado en Úbeda, a {fecha}.\"></textarea>\n        </details>\n\n        <details>\n          <summary>Frase según el rol</summary>\n          <div class=\"ayuda\">Es lo que sustituye a <code>{verbo}</code>.</div>\n          <div id=\"verbos\"></div>\n        </details>\n\n        <details>\n          <summary>Firmas</summary>\n          <div class=\"ayuda\">Por defecto salen los firmantes de la hoja «Ajustes». Aquí puedes cambiar cómo aparecen en esta actividad (el orden y quién firma no cambian).</div>\n          <div id=\"firmas\"></div>\n          <button class=\"boton peq\" id=\"btnFirmasAjustes\" style=\"margin-top:8px\">Volver a los de «Ajustes»</button>\n        </details>\n      </div>\n      <div class=\"panel-pie\">\n        <button class=\"boton primario\" id=\"btnGuardar\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-ok\"/></svg>Guardar diseño</button>\n        <label class=\"casilla\" style=\"margin:0\"><input type=\"checkbox\" id=\"comoBase\"> usar también como base</label>\n        <button class=\"boton peq fantasma\" id=\"btnBase\" title=\"Descarta los cambios no guardados\">Deshacer cambios</button>\n      </div>\n    </section>\n\n    <!-- ───────────── PANEL GENERAR ───────────── -->\n    <section class=\"panel oculto\" id=\"panelGenerar\">\n      <div class=\"panel-scroll\">\n        <div class=\"nota\">Aquí están las personas <b>validadas</b> en «Inscripciones» para esta actividad. Puedes corregir nombre, apellidos, DNI y rol antes de generar: las correcciones se guardan en la bóveda.</div>\n        <div id=\"sinPendientes\" class=\"vacio-e oculto\">No hay certificados pendientes en esta actividad.<br>Valida a las personas en «Inscripciones».</div>\n        <div id=\"tablaCola\">\n          <label class=\"casilla\"><input type=\"checkbox\" id=\"todos\" checked> Seleccionar todas</label>\n          <div id=\"listaCola\"></div>\n        </div>\n        <div id=\"progreso\" class=\"oculto\">\n          <div class=\"barra-progreso\"><div id=\"barra\"></div></div>\n          <div id=\"textoProgreso\" class=\"ayuda\"></div>\n          <div class=\"registro\" id=\"registro\"></div>\n        </div>\n      </div>\n      <div class=\"panel-pie\">\n        <button class=\"boton exito\" id=\"btnGenerar\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-certificado\"/></svg>Generar aquí</button>\n        <button class=\"boton\" id=\"btnServidor\" title=\"Los genera el servidor: puedes cerrar la ventana\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-rayo\"/></svg>En segundo plano</button>\n        <span class=\"ayuda\" style=\"flex-basis:100%\">«Generar aquí» ve el progreso (no cierres la ventana). «En segundo plano» lo hace el servidor y te avisa por correo.</span>\n      </div>\n    </section>\n\n    <!-- ───────────── VISTA PREVIA ───────────── -->\n    <section class=\"vista-prev\">\n      <div class=\"vista-barra\">\n        <strong>Vista previa con</strong>\n        <select id=\"verCon\" aria-label=\"Persona de la vista previa\"></select>\n        <select id=\"verRol\" aria-label=\"Rol de la vista previa\"></select>\n        <button class=\"boton peq\" id=\"btnPrueba\"><svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-descargar\"/></svg>PDF de prueba</button>\n        <span class=\"avisos\" id=\"avisos\"></span>\n      </div>\n      <div class=\"lienzo\" id=\"lienzo\"><canvas id=\"canvas\"></canvas></div>\n    </section>\n  </main>\n</div>\n<div class=\"cargando\" id=\"cargando\"><div class=\"girando\"></div><div>Cargando el editor…</div><div class=\"ayuda\" id=\"cargandoDetalle\"></div></div>\n<textarea id=\"portapapeles\" style=\"position:fixed;left:-9999px;top:0\"></textarea>\n</section>\n\n<script>\n(function () {\n  'use strict';\n  const $ = (id) => document.getElementById(id);\n  const PRESETS = [\n    ['Verde Pastoral', '#2e7d4f', '#f2c14e'], ['Azul Pastoral', '#136EA1', '#F29100'], ['Azul SAFA', '#2a6096', '#f2a33a'], ['Adviento', '#5b2c83', '#c9a227'], ['Navidad', '#a61e2a', '#d4af37'],\n    ['Cuaresma', '#6b3f86', '#a7a9ac'], ['Pascua', '#b8860b', '#2a6096'], ['Ordinario', '#3f8f3a', '#e8d8a8'],\n    ['Solidaridad', '#c0392b', '#2a6096'], ['Voluntariado', '#d35400', '#2a6096'], ['Mar', '#0f6c81', '#9bd0d8'],\n    ['Sobrio', '#33414c', '#b08d57']\n  ];\n  const CAMPOS_TEXTO = ['etiqueta', 'titulo', 'intro', 'lineaDni', 'cuerpo', 'descripcion', 'textoHoras', 'textoEcts', 'cierre', 'textoBanda', 'notasIA'];\n  const CHIPS = ['{nombre}', '{dni}', '{actividad}', '{fechas}', '{lugar}', '{verbo}', '{horas}', '{ects}', '{creditos}', '{rol}', '{curso}', '{fecha}', '{codigo}'];\n\n  const S = {\n    ini: null, act: null, diseno: null, guardado: '', cola: [], fuentes: {}, imgs: {}, ultimoCampo: null,\n    pestana: 'diseno', generando: false\n  };\n\n  // ─────────── servidor ───────────\n  function llamar(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise(function (ok, ko) {\n      google.script.run.withSuccessHandler(ok).withFailureHandler(function (e) { const err = e && e.message ? e : new Error(String(e)); if (/^SESION/.test(err.message) && window.sesionCaducada) window.sesionCaducada(); ko(err); })[fn].apply(null, [window.TOKEN].concat(args));\n    });\n  }\n  function aviso(t) {\n    if (window.avisoPanel) return window.avisoPanel(t);\n    const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.appendChild(d);\n    setTimeout(() => d.remove(), 3600);\n  }\n  const ICO = (n) => '<svg class=\"ic peq\" aria-hidden=\"true\"><use href=\"#i-' + n + '\"/></svg>';\n  function cargando(si, detalle) { $('cargando').classList.toggle('oculto', !si); $('cargandoDetalle').textContent = detalle || ''; }\n\n  // ─────────── recursos (fuentes e imágenes) ───────────\n  async function fuente(tipo) {\n    if (S.fuentes[tipo]) return S.fuentes[tipo];\n    const bytes = {}, css = {};\n    await Promise.all(Object.keys(Motor.ESTILOS).map(async (estilo) => {\n      try {\n        const r = await fetch(Motor.urlFuente(tipo, estilo));\n        if (!r.ok) throw new Error(r.status);\n        bytes[estilo] = new Uint8Array(await r.arrayBuffer());\n        const nombre = 'CP_' + tipo + '_' + estilo;\n        const ff = new FontFace(nombre, bytes[estilo]);\n        await ff.load(); document.fonts.add(ff); css[estilo] = nombre;\n      } catch (e) { css[estilo] = 'Helvetica'; }\n    }));\n    const medir = await Motor.crearMedidor(PDFLib, window.fontkit, bytes);\n    S.fuentes[tipo] = { bytes, css, medir };\n    return S.fuentes[tipo];\n  }\n\n  function dataUriABytes(uri) {\n    const b64 = uri.split(',')[1], bin = atob(b64), u = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);\n    return u;\n  }\n  function bytesABase64(u8) {\n    let s = ''; const paso = 0x8000;\n    for (let i = 0; i < u8.length; i += paso) s += String.fromCharCode.apply(null, u8.subarray(i, i + paso));\n    return btoa(s);\n  }\n  function imagenDesdeUri(uri) {\n    return new Promise((ok, ko) => { const im = new Image(); im.onload = () => ok(im); im.onerror = ko; im.src = uri; });\n  }\n  async function registrarImagen(clave, uri) {\n    const el = await imagenDesdeUri(uri);\n    S.imgs[clave] = { el, w: el.naturalWidth, h: el.naturalHeight, bytes: dataUriABytes(uri), tipo: uri.indexOf('image/png') > -1 ? 'png' : 'jpg' };\n  }\n  async function imagenDrive(clave, id) {\n    if (!id) { delete S.imgs[clave]; return; }\n    if (S.imgs[clave] && S.imgs[clave].id === id) return;\n    const r = await llamar('api_imagen', id);\n    await registrarImagen(clave, 'data:' + r.mime + ';base64,' + r.base64);\n    S.imgs[clave].id = id;\n  }\n  async function prepararImagenes() {\n    await imagenDrive('fondo', S.diseno.fondoId);\n    await imagenDrive('logoPropio', S.diseno.logoId);\n  }\n  function imagenesPara(d) {\n    const r = {};\n    if (S.imgs.safa) r.safa = S.imgs.safa;\n    if (S.imgs.uja) r.uja = S.imgs.uja;\n    const sup = d.logoId && S.imgs.logoPropio ? S.imgs.logoPropio : S.imgs.pastoral;\n    if (sup) r.pastoral = sup;\n    if (d.fondoId && S.imgs.fondo) r.fondo = S.imgs.fondo;\n    return r;\n  }\n\n  function matrizQr(texto) {\n    if (typeof qrcode === 'undefined') return null;\n    const q = qrcode(0, 'M'); q.addData(texto); q.make();\n    const n = q.getModuleCount(), m = [];\n    for (let r = 0; r < n; r++) { m.push([]); for (let c = 0; c < n; c++) m[r].push(q.isDark(r, c)); }\n    return m;\n  }\n\n  // ─────────── datos para dibujar ───────────\n  function hoyLargo() {\n    const M = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];\n    const d = new Date(); return d.getDate() + ' de ' + M[d.getMonth()] + ' de ' + d.getFullYear();\n  }\n  function datosDe(persona, rol, codigo) {\n    const a = S.act;\n    return {\n      nombre: persona.nombre, apellidos: persona.apellidos, dni: persona.dni,\n      actividad: a.nombre, fechas: a.fechas, lugar: a.lugar || S.ini.lugarPorDefecto, horas: a.horas, ects: a.ects,\n      rol: rol || persona.rol || 'Participante', curso: a.curso, fecha: hoyLargo(),\n      codigo: codigo || 'SAFA-PAS-' + String(a.curso || '').replace(/^20(\\d\\d)-(\\d\\d)$/, '$1$2') + '-XXXXXX',\n      url: S.ini.url || 'https://script.google.com/…/exec', firmantes: S.ini.firmantes\n    };\n  }\n  const EJEMPLO = { nombre: 'María José', apellidos: 'Valero Moro', dni: '12345678Z', rol: 'Participante' };\n\n  function personaVista() {\n    const v = $('verCon').value;\n    if (v === '_ej') return EJEMPLO;\n    const fila = S.cola.find((p) => p.reg === v);\n    return fila ? leerFilaEditada(fila) : EJEMPLO;\n  }\n\n  // ─────────── vista previa ───────────\n  let temporizador = null;\n  function programarVista() { clearTimeout(temporizador); temporizador = setTimeout(dibujarVista, 180); }\n\n  async function dibujarVista() {\n    if (!S.diseno || !S.act) return;\n    const d = Motor.mezclar(S.diseno);\n    const f = await fuente(d.tipografia);\n    const imgs = imagenesPara(d);\n    const per = personaVista();\n    const r = Motor.componer(d, datosDe(per, $('verRol').value), f.medir, imgs, matrizQr);\n    $('avisos').textContent = r.avisos.join(' ');\n    const lienzo = $('lienzo'), canvas = $('canvas');\n    const alto = Math.max(300, lienzo.clientHeight - 36);\n    const escalaVista = alto / Motor.ALTO, dpr = window.devicePixelRatio || 1;\n    canvas.style.height = alto + 'px'; canvas.style.width = (Motor.ANCHO * escalaVista) + 'px';\n    canvas.width = Math.round(Motor.ANCHO * escalaVista * dpr); canvas.height = Math.round(alto * dpr);\n    const els = {}; Object.keys(imgs).forEach((k) => { els[k] = imgs[k].el; });\n    Motor.aCanvas(canvas.getContext('2d'), r.ops, escalaVista * dpr, f.css, els);\n  }\n\n  async function pdfDe(persona, rol, codigo) {\n    const d = Motor.mezclar(S.diseno);\n    const f = await fuente(d.tipografia);\n    const imgs = imagenesPara(d);\n    const r = Motor.componer(d, datosDe(persona, rol, codigo), f.medir, imgs, matrizQr);\n    const bytesImg = {}; Object.keys(imgs).forEach((k) => { bytesImg[k] = { bytes: imgs[k].bytes, tipo: imgs[k].tipo }; });\n    return Motor.aPdf(PDFLib, window.fontkit, r.ops, f.bytes, bytesImg,\n      { titulo: d.titulo + ' · ' + S.act.nombre, asunto: codigo || 'Prueba de diseño' });\n  }\n\n  // ─────────── formulario de diseño ───────────\n  function miniPlantillas() {\n    const cont = $('plantillas'); cont.innerHTML = '';\n    Object.keys(Motor.PLANTILLAS).forEach((k) => {\n      const b = document.createElement('div'); b.className = 'plantilla'; b.dataset.k = k;\n      const c = document.createElement('canvas'); c.width = 54; c.height = 76;\n      b.appendChild(c); b.appendChild(document.createTextNode(Motor.PLANTILLAS[k].split(' (')[0]));\n      b.onclick = () => { S.diseno.plantilla = k; refrescarControles(); cambio(); };\n      cont.appendChild(b);\n    });\n  }\n  function pintarMinis() {\n    document.querySelectorAll('.plantilla').forEach((b) => {\n      b.classList.toggle('activa', b.dataset.k === S.diseno.plantilla);\n      const c = b.querySelector('canvas'), x = c.getContext('2d'), C = S.diseno.color || '#2a6096', A = S.diseno.acento || '#f2a33a';\n      x.fillStyle = '#fff'; x.fillRect(0, 0, 54, 76);\n      const k = b.dataset.k;\n      if (k === 'banda') { x.fillStyle = C; x.fillRect(0, 0, 8, 76); x.fillStyle = A; x.fillRect(8, 0, 1, 76); }\n      if (k === 'marco') { x.strokeStyle = C; x.lineWidth = 1.5; x.strokeRect(3, 3, 48, 70); x.strokeStyle = A; x.lineWidth = .6; x.strokeRect(6, 6, 42, 64); }\n      if (k === 'cabecera') { x.fillStyle = C; x.fillRect(0, 0, 54, 4); x.fillRect(0, 74, 54, 2); x.fillStyle = A; x.fillRect(0, 4, 54, 1); }\n      x.fillStyle = '#c5ced6'; [20, 30, 36, 42, 48].forEach((y, i) => x.fillRect(k === 'banda' ? 14 : 10, y, i === 0 ? 30 : 34, 2));\n      x.fillStyle = C; x.fillRect(18, 25, 20, 2.5);\n    });\n  }\n\n  function refrescarControles() {\n    const d = Motor.mezclar(S.diseno);\n    CAMPOS_TEXTO.forEach((k) => { if (document.activeElement !== $(k)) $(k).value = d[k] || ''; });\n    $('color').value = d.color; $('acento').value = d.acento; $('tipografia').value = d.tipografia;\n    $('velo').value = d.velo; $('veloValor').textContent = d.velo;\n    $('logoSuperior').checked = !!d.logoSuperior; $('logosPie').checked = !!d.logosPie; $('qr').checked = !!d.qr;\n    $('bloqueBanda').classList.toggle('oculto', d.plantilla !== 'banda');\n    $('btnQuitarFondo').disabled = !d.fondoId;\n    $('btnLogoOriginal').disabled = !d.logoId;\n    const vb = $('verbos'); vb.innerHTML = '';\n    S.ini.roles.forEach((rol) => {\n      vb.insertAdjacentHTML('beforeend', '<label class=\"e\">' + rol + '</label>');\n      const i = document.createElement('input'); i.type = 'text'; i.value = d.verbos[rol] || '';\n      i.oninput = () => { S.diseno.verbos = Object.assign({}, Motor.mezclar(S.diseno).verbos, { [rol]: i.value }); cambio(); };\n      vb.appendChild(i);\n    });\n    const fi = $('firmas'); fi.innerHTML = '';\n    const lista = d.firmas && d.firmas.length ? d.firmas : S.ini.firmantes;\n    S.ini.firmantes.forEach((_, n) => {\n      const f = lista[n] || S.ini.firmantes[n];\n      fi.insertAdjacentHTML('beforeend', '<label class=\"e\">Firma ' + (n + 1) + ' · cargo y nombre</label>');\n      const t = document.createElement('textarea'); t.value = f.titulo; t.style.minHeight = '38px';\n      const nom = document.createElement('input'); nom.type = 'text'; nom.value = f.nombre; nom.style.marginTop = '4px';\n      const leer = () => {\n        const actual = (S.diseno.firmas && S.diseno.firmas.length ? S.diseno.firmas : S.ini.firmantes).map((x) => ({ titulo: x.titulo, nombre: x.nombre }));\n        actual[n] = { titulo: t.value, nombre: nom.value };\n        S.diseno.firmas = actual; cambio();\n      };\n      t.oninput = leer; nom.oninput = leer;\n      fi.appendChild(t); fi.appendChild(nom);\n    });\n    pintarMinis();\n  }\n\n  function cambio() { marcarGuardado(); programarVista(); pintarMinis(); }\n  function marcarGuardado() {\n    const sin = JSON.stringify(S.diseno) !== S.guardado;\n    $('estadoGuardado').textContent = sin ? 'Cambios sin guardar' : (S.act && S.act.conDiseno ? 'Diseño guardado' : 'Usando el diseño base');\n    $('estadoGuardado').classList.toggle('sin', sin);\n  }\n\n  function enlazarControles() {\n    CAMPOS_TEXTO.forEach((k) => {\n      $(k).addEventListener('input', () => { S.diseno[k] = $(k).value; cambio(); });\n      $(k).addEventListener('focus', () => { S.ultimoCampo = $(k); });\n    });\n    $('color').oninput = () => { S.diseno.color = $('color').value; cambio(); };\n    $('acento').oninput = () => { S.diseno.acento = $('acento').value; cambio(); };\n    $('tipografia').onchange = () => { S.diseno.tipografia = $('tipografia').value; cambio(); };\n    $('velo').oninput = () => { S.diseno.velo = Number($('velo').value); $('veloValor').textContent = $('velo').value; cambio(); };\n    ['logoSuperior', 'logosPie', 'qr'].forEach((k) => { $(k).onchange = () => { S.diseno[k] = $(k).checked; cambio(); }; });\n    $('verCon').onchange = programarVista; $('verRol').onchange = programarVista;\n    window.addEventListener('resize', programarVista);\n\n    const chips = $('chips');\n    CHIPS.forEach((c) => {\n      const b = document.createElement('button'); b.type = 'button'; b.className = 'chip-campo'; b.textContent = c;\n      b.onmousedown = (e) => e.preventDefault();\n      b.onclick = () => {\n        const el = S.ultimoCampo || $('cuerpo');\n        const ini = el.selectionStart || el.value.length, fin = el.selectionEnd || ini;\n        el.value = el.value.slice(0, ini) + c + el.value.slice(fin);\n        el.focus(); el.selectionStart = el.selectionEnd = ini + c.length;\n        el.dispatchEvent(new Event('input'));\n      };\n      chips.appendChild(b);\n    });\n    PRESETS.forEach((p) => {\n      const m = document.createElement('div'); m.className = 'muestra'; m.title = p[0];\n      m.style.background = p[1]; m.innerHTML = '<span style=\"background:' + p[2] + '\"></span>';\n      m.onclick = () => { S.diseno.color = p[1]; S.diseno.acento = p[2]; refrescarControles(); cambio(); };\n      $('presets').appendChild(m);\n    });\n    Object.keys(Motor.TIPOGRAFIAS).forEach((k) => {\n      $('tipografia').insertAdjacentHTML('beforeend', '<option value=\"' + k + '\">' + Motor.TIPOGRAFIAS[k].nombre + '</option>');\n    });\n\n    $('btnFondo').onclick = () => $('archivoFondo').click();\n    $('archivoFondo').onchange = (e) => subirImagen(e.target.files[0], 'fondo');\n    $('btnQuitarFondo').onclick = () => { S.diseno.fondoId = ''; refrescarControles(); cambio(); };\n    $('btnLogo').onclick = () => $('archivoLogo').click();\n    $('archivoLogo').onchange = (e) => subirImagen(e.target.files[0], 'logo');\n    $('btnLogoOriginal').onclick = () => { S.diseno.logoId = ''; refrescarControles(); cambio(); };\n    $('btnFirmasAjustes').onclick = () => { S.diseno.firmas = []; refrescarControles(); cambio(); };\n    $('btnPromptTexto').onclick = () => copiar(promptTexto(), 'promptTexto');\n    $('btnIaTexto').onclick = redactarConIa;\n    $('btnServidor').onclick = generarEnServidor;\n    $('btnPromptFondo').onclick = () => copiar(promptFondo(), 'promptFondo');\n    $('btnGuardar').onclick = guardar;\n    $('btnBase').onclick = restablecer;\n    $('btnPrueba').onclick = pdfPrueba;\n    $('actividad').onchange = cambiarActividad;\n    $('tabDiseno').onclick = () => pestana('diseno');\n    $('tabGenerar').onclick = () => pestana('generar');\n    $('btnGenerar').onclick = generar;\n    $('todos').onchange = () => document.querySelectorAll('#listaCola input.sel').forEach((c) => { c.checked = $('todos').checked; });\n  }\n\n  // ─────────── imágenes subidas ───────────\n  async function subirImagen(archivo, tipo) {\n    if (!archivo) return;\n    try {\n      cargando(true, 'Preparando la imagen…');\n      const uri = await new Promise((ok, ko) => { const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = ko; r.readAsDataURL(archivo); });\n      const im = await imagenDesdeUri(uri);\n      const c = document.createElement('canvas'), x = c.getContext('2d');\n      let salida, mime;\n      if (tipo === 'fondo') {\n        // Recorte «cubrir» a A4 vertical a 200 ppp\n        c.width = 1654; c.height = 2339;\n        const esc = Math.max(c.width / im.width, c.height / im.height);\n        const w = im.width * esc, h = im.height * esc;\n        x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height);\n        x.drawImage(im, (c.width - w) / 2, (c.height - h) / 2, w, h);\n        mime = 'image/jpeg'; salida = c.toDataURL(mime, 0.86);\n      } else {\n        const esc = Math.min(1, 1100 / im.width);\n        c.width = Math.round(im.width * esc); c.height = Math.round(im.height * esc);\n        x.drawImage(im, 0, 0, c.width, c.height);\n        mime = 'image/png'; salida = c.toDataURL(mime);\n      }\n      cargando(true, 'Subiendo a Drive…');\n      const id = await llamar('api_subirImagen', salida.split(',')[1], mime, (tipo === 'fondo' ? 'Fondo ' : 'Logo ') + S.act.nombre);\n      await registrarImagen(tipo === 'fondo' ? 'fondo' : 'logoPropio', salida);\n      S.imgs[tipo === 'fondo' ? 'fondo' : 'logoPropio'].id = id;\n      if (tipo === 'fondo') { S.diseno.fondoId = id; if (!S.diseno.velo) S.diseno.velo = 0; }\n      else { S.diseno.logoId = id; S.diseno.logoSuperior = true; }\n      refrescarControles(); cambio();\n      aviso(tipo === 'fondo' ? 'Fondo añadido. Recuerda guardar el diseño.' : 'Logo cambiado. Recuerda guardar el diseño.');\n    } catch (e) { alert('No se pudo usar la imagen: ' + e.message); }\n    finally { cargando(false); $('archivoFondo').value = ''; $('archivoLogo').value = ''; }\n  }\n\n  // ─────────── IA ───────────\n  function promptTexto() {\n    const a = S.act, d = Motor.mezclar(S.diseno);\n    const frase = Motor.rellenar(d.cuerpo, datosDe({ nombre: '[nombre]', apellidos: '', dni: '' }, 'Participante'), d).replace(/\\*\\*/g, '');\n    return [\n      'Redacta el texto descriptivo de un certificado oficial del Servicio de Pastoral y Compromiso Solidario del Centro Universitario Sagrada Familia de Úbeda (centro de inspiración ignaciana adscrito a la Universidad de Jaén, que forma a futuros maestros y maestras de Educación Infantil y Primaria).',\n      '',\n      'Actividad: ' + a.nombre + (a.tipo ? ' (' + a.tipo.toLowerCase() + ')' : ''),\n      'Fechas: ' + (a.fechas || '—') + (a.horas ? ' · ' + a.horas + ' horas' : '') + (a.ects ? ' · ' + a.ects + ' ECTS' : ''),\n      'Lugar: ' + (a.lugar || S.ini.lugarPorDefecto),\n      'Qué se hizo y otros detalles: ' + ($('notasIA').value.trim() || '[escribe aquí qué se hizo, con qué entidades, objetivos…]'),\n      '',\n      'El texto irá justo después de esta frase del certificado: «' + frase + '»',\n      '',\n      'Requisitos:',\n      '- Dos párrafos, entre 80 y 130 palabras en total.',\n      '- Tercera persona e impersonal; no nombres a la persona certificada.',\n      '- Tono institucional, sobrio y cálido. Sin adjetivos grandilocuentes.',\n      '- Explica qué se trabajó y su objetivo formativo, y conéctalo con la futura labor docente; menciona la pedagogía ignaciana solo si encaja de forma natural.',\n      '- Sin lenguaje religioso explícito ni datos que yo no te haya dado.',\n      '- Si hay una entidad colaboradora, escríbela entre **dobles asteriscos** para que salga en negrita.',\n      '- Devuelve solo los dos párrafos, separados por un salto de línea, sin título ni comillas.',\n      '',\n      'Ejemplo del estilo buscado:',\n      'En dicho marco se han trabajado, desde la pedagogía ignaciana, la reflexión crítica sobre las desigualdades de género y la coeducación como clave para la construcción de una sociedad más justa, especialmente en el ámbito de la educación infantil y primaria.',\n      'Estas Jornadas han tenido como objetivo ofrecer herramientas concretas a los futuros y futuras docentes para integrar la perspectiva de género en el currículo, promoviendo contextos educativos inclusivos y corresponsables, en colaboración con la **ONG Entreculturas**.'\n    ].join('\\n');\n  }\n  function promptFondo() {\n    const d = Motor.mezclar(S.diseno);\n    return [\n      'Crea una imagen de fondo para un certificado en formato A4 vertical (proporción 1:1,414; idealmente 2480 × 3508 píxeles).',\n      'Idea: ' + ($('ideaFondo').value.trim() || 'decoración sobria y luminosa relacionada con «' + S.act.nombre + '»') + '.',\n      'Paleta: color principal ' + d.color + ' y acento ' + d.acento + ', sobre blanco o crema muy claro.',\n      'MUY IMPORTANTE: deja limpia y muy clara toda la zona central (del 12 % al 88 % del ancho y del 10 % al 90 % del alto), porque ahí irá el texto. Los motivos decorativos, solo en los bordes y esquinas, suaves y con poco contraste.',\n      'Sin texto, letras, números, logotipos, marcos de foto ni personas reconocibles. Estilo elegante, apto para un documento oficial universitario. Sin marcas de agua.'\n    ].join('\\n');\n  }\n  async function copiar(texto, idArea) {\n    const area = $(idArea); area.value = texto; area.classList.remove('oculto'); area.style.minHeight = '120px';\n    try { await navigator.clipboard.writeText(texto); aviso('Instrucción copiada. Pégala en la IA.'); }\n    catch (e) {\n      const p = $('portapapeles'); p.value = texto; p.select();\n      try { document.execCommand('copy'); aviso('Instrucción copiada. Pégala en la IA.'); }\n      catch (e2) { area.select(); aviso('Selecciona el texto y cópialo con Ctrl/Cmd + C.'); }\n    }\n  }\n\n  function pintarIa() {\n    const hay = S.ini && S.ini.ia;\n    $('btnIaTexto').classList.toggle('oculto', !hay);\n    const ctx = (S.act && S.act.contexto) || '';\n    $('iaContexto').innerHTML = hay ? (ctx ? 'Usará el contexto de la actividad: «' + esc(ctx.slice(0, 140)) + (ctx.length > 140 ? '…' : '') + '» y estas notas.'\n      : 'Escribe aquí qué se hizo (o el contexto en «Actividades › Editar») y pulsa «Redactar con IA».') : 'La IA de la app no está activada: copia la instrucción y pégala en otra IA.';\n  }\n  async function redactarConIa() {\n    const d = Motor.mezclar(S.diseno);\n    const frase = Motor.rellenar(d.cuerpo, datosDe({ nombre: '[nombre]', apellidos: '', dni: '' }, 'Participante'), d).replace(/\\*\\*/g, '');\n    if ($('descripcion').value.trim() && !confirm('Se sustituirá el «Texto sobre la actividad» actual. ¿Continuar?')) return;\n    try {\n      $('btnIaTexto').disabled = true; cargando(true, 'La IA está redactando el texto…');\n      const r = await llamar('api_iaTextoCertificado', S.act.id, $('notasIA').value, frase);\n      S.diseno.descripcion = r.texto; $('descripcion').value = r.texto; cambio();\n      aviso('Texto listo. Revísalo y guarda el diseño.');\n    } catch (e) { alert(e.message); }\n    finally { $('btnIaTexto').disabled = false; cargando(false); }\n  }\n  async function generarEnServidor() {\n    if (!S.cola.length) return;\n    if (/no cabe/.test($('avisos').textContent)) { alert('El texto no cabe en una página. Acórtalo antes de generar.'); return; }\n    if (JSON.stringify(S.diseno) !== S.guardado && !(await guardar())) return;\n    if (!confirm('El servidor generará los ' + S.cola.length + ' certificado(s) pendientes de «' + S.act.nombre + '» con el diseño guardado (los cambios de esta lista no se aplican). Puedes cerrar la ventana: te avisaremos por correo.\\n\\n¿Continuar?')) return;\n    try { const r = await llamar('api_generarEnServidor', S.act.id); aviso('Encargado: ' + r.n + ' certificado(s). Empezará en uno o dos minutos.'); }\n    catch (e) { alert(e.message); }\n  }\n\n  // ─────────── guardar / cargar ───────────\n  async function guardar() {\n    try {\n      $('btnGuardar').disabled = true;\n      await llamar('api_guardarDiseno', S.act.id, S.diseno, $('comoBase').checked);\n      S.guardado = JSON.stringify(S.diseno); S.act.conDiseno = true;\n      if ($('comoBase').checked) S.ini.hayBase = true;\n      marcarGuardado(); aviso('Diseño guardado.');\n      return true;\n    } catch (e) { alert('No se pudo guardar: ' + e.message); return false; }\n    finally { $('btnGuardar').disabled = false; }\n  }\n  async function restablecer() {\n    if (!confirm(\"¿Descartar los cambios no guardados?\")) return;\n    S.diseno = JSON.parse(JSON.stringify(S.base || {}));\n    await prepararImagenes(); refrescarControles(); cambio();\n  }\n\n  async function cambiarActividad() {\n    if (S.diseno && JSON.stringify(S.diseno) !== S.guardado && !confirm('Hay cambios sin guardar. ¿Cambiar de actividad igualmente?')) {\n      $('actividad').value = S.act.id; return;\n    }\n    await cargarActividad($('actividad').value);\n  }\n\n  async function cargarActividad(id) {\n    cargando(true, 'Cargando la actividad…');\n    try {\n      S.act = S.ini.actividades.find((a) => a.id === id);\n      const [diseno, cola] = await Promise.all([llamar('api_diseno', id), llamar('api_cola', id)]);\n      S.diseno = Object.assign({}, diseno || {}); S.base = diseno || {};\n      S.guardado = JSON.stringify(S.diseno);\n      S.cola = cola || [];\n      await prepararImagenes();\n      refrescarControles(); pintarCola(); opcionesVista(); marcarGuardado(); pintarIa();\n      await dibujarVista();\n    } catch (e) { alert('Error al cargar: ' + e.message); }\n    finally { cargando(false); }\n  }\n\n  function opcionesVista() {\n    const v = $('verCon'); const antes = v.value; v.innerHTML = '<option value=\"_ej\">Datos de ejemplo</option>';\n    S.cola.forEach((p) => v.insertAdjacentHTML('beforeend', '<option value=\"' + p.reg + '\">' + esc(p.nombre + ' ' + p.apellidos) + '</option>'));\n    if ([...v.options].some((o) => o.value === antes)) v.value = antes;\n    const r = $('verRol'); const rAntes = r.value; r.innerHTML = '';\n    S.ini.roles.forEach((x) => r.insertAdjacentHTML('beforeend', '<option>' + x + '</option>'));\n    if (rAntes) r.value = rAntes;\n    $('contador').textContent = S.cola.length;\n  }\n\n  function pestana(p) {\n    S.pestana = p;\n    $('tabDiseno').classList.toggle('activa', p === 'diseno'); $('tabGenerar').classList.toggle('activa', p === 'generar');\n    $('panelDiseno').classList.toggle('oculto', p !== 'diseno'); $('panelGenerar').classList.toggle('oculto', p !== 'generar');\n  }\n\n  // ─────────── generar ───────────\n  function esc(t) { return String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c])); }\n  function dniValido(dni) {\n    const m = String(dni).toUpperCase().replace(/[\\s.\\-]/g, '').match(/^([0-9XYZ])(\\d{7})([A-Z])$/);\n    if (!m) return false;\n    const n = Number(({ X: '0', Y: '1', Z: '2' }[m[1]] || m[1]) + m[2]);\n    return 'TRWAGMYFPDXBNJZSQVHLCKE'.charAt(n % 23) === m[3];\n  }\n  function pintarCola() {\n    const tb = $('listaCola'); tb.innerHTML = '';\n    $('sinPendientes').classList.toggle('oculto', S.cola.length > 0);\n    $('tablaCola').classList.toggle('oculto', S.cola.length === 0);\n    $('btnGenerar').disabled = S.cola.length === 0;\n    S.cola.forEach((p) => {\n      const tr = document.createElement('div'); tr.className = 'persona'; tr.dataset.reg = p.reg;\n      tr.innerHTML = '<input type=\"checkbox\" class=\"sel\" checked>' +\n        '<input type=\"text\" class=\"nombre\" value=\"' + esc(p.nombre) + '\" placeholder=\"Nombre\">' +\n        '<input type=\"text\" class=\"apellidos\" value=\"' + esc(p.apellidos) + '\" placeholder=\"Apellidos\">' +\n        '<button class=\"boton peq icono ver\" title=\"Ver en la vista previa\" aria-label=\"Ver en la vista previa\">' + ICO('ojo') + '</button>' +\n        '<input type=\"text\" class=\"dni\" value=\"' + esc(p.dni) + '\" placeholder=\"DNI/NIE\">' +\n        '<select class=\"rol\">' + S.ini.roles.map((r) => '<option' + (r === p.rol ? ' selected' : '') + '>' + r + '</option>').join('') + '</select>' +\n        (p.tieneEmail ? '' : '<div class=\"aviso-email\">Sin correo en la bóveda: añádelo en «Inscripciones › Corregir» para poder enviárselo.</div>');\n      tr.querySelectorAll('input[type=text], select').forEach((el) => el.addEventListener('input', () => {\n        tr.classList.toggle('mal', !dniValido(tr.querySelector('.dni').value));\n        if ($('verCon').value === p.reg) programarVista();\n      }));\n      tr.querySelector('.ver').onclick = () => { $('verCon').value = p.reg; $('verRol').value = tr.querySelector('.rol').value; programarVista(); };\n      tb.appendChild(tr);\n    });\n  }\n  function leerFilaEditada(p) {\n    const tr = document.querySelector('.persona[data-reg=\"' + p.reg + '\"]');\n    if (!tr) return p;\n    return { reg: p.reg, nombre: tr.querySelector('.nombre').value.trim(), apellidos: tr.querySelector('.apellidos').value.trim(),\n      dni: tr.querySelector('.dni').value.toUpperCase().replace(/[\\s.\\-]/g, ''), rol: tr.querySelector('.rol').value };\n  }\n\n  async function generar() {\n    if (S.generando) return;\n    const elegidos = S.cola.filter((p) => { const tr = document.querySelector('.persona[data-reg=\"' + p.reg + '\"]'); return tr && tr.querySelector('.sel').checked; });\n    if (!elegidos.length) { alert('Selecciona al menos una persona.'); return; }\n    const malos = elegidos.filter((p) => !dniValido(leerFilaEditada(p).dni));\n    if (malos.length) { alert('Hay ' + malos.length + ' DNI/NIE no válidos (en rojo). Corrígelos o desmárcalos.'); return; }\n    const avisos = $('avisos').textContent;\n    if (/no cabe/.test(avisos)) { alert('El texto no cabe en una página. Acórtalo antes de generar.'); return; }\n    if (!confirm('Se van a generar ' + elegidos.length + ' certificado(s) de «' + S.act.nombre + '» con el diseño actual.\\n\\n¿Continuar?')) return;\n    if (JSON.stringify(S.diseno) !== S.guardado && !(await guardar())) return;\n\n    S.generando = true; $('btnGenerar').disabled = true;\n    $('progreso').classList.remove('oculto'); $('registro').textContent = '';\n    const log = (t) => { $('registro').textContent += t + '\\n'; $('registro').scrollTop = 1e9; };\n    let hechos = 0, fallos = 0;\n    try {\n      const codigos = await llamar('api_reservar', elegidos.map((p) => p.reg));\n      for (let i = 0; i < elegidos.length; i++) {\n        const orig = elegidos[i], p = leerFilaEditada(orig), codigo = codigos[orig.reg];\n        $('textoProgreso').textContent = 'Generando ' + (i + 1) + ' de ' + elegidos.length + '…';\n        try {\n          if (!codigo) throw new Error('ya no estaba pendiente');\n          const bytes = await pdfDe(p, p.rol, codigo);\n          const cambios = {};\n          if (p.nombre !== orig.nombre) cambios.nombre = p.nombre;\n          if (p.apellidos !== orig.apellidos) cambios.apellidos = p.apellidos;\n          if (p.dni !== orig.dni) cambios.dni = p.dni;\n          if (p.rol !== orig.rol) cambios.rol = p.rol;\n          await llamar('api_guardarPdf', orig.reg, codigo, bytesABase64(bytes), Object.keys(cambios).length ? cambios : null);\n          hechos++; log('✓ ' + p.nombre + ' ' + p.apellidos + ' · ' + codigo);\n          const tr = document.querySelector('.persona[data-reg=\"' + orig.reg + '\"]'); if (tr) tr.classList.add('hecho');\n        } catch (e) { fallos++; log('✗ ' + p.nombre + ' ' + p.apellidos + ': ' + e.message); }\n        $('barra').style.width = Math.round((i + 1) * 100 / elegidos.length) + '%';\n      }\n      const fin = await llamar('api_finTanda', hechos, S.act.id);\n      $('textoProgreso').textContent = 'Terminado: ' + hechos + ' generado(s)' + (fallos ? ', ' + fallos + ' con error' : '') +\n        (fin && fin.aFirma ? '. Se han enviado a firmar automáticamente.' : '. Están en «Envíos»: revísalos y pulsa «Enviar a firmar».');\n    } catch (e) { log('✗ ' + e.message); }\n    finally {\n      S.generando = false; $('btnGenerar').disabled = false;\n      S.cola = await llamar('api_cola', S.act.id); S.act.pendientes = S.cola.length;\n      pintarCola(); opcionesVista(); actualizarSelector();\n    }\n  }\n\n  async function pdfPrueba() {\n    try {\n      $('btnPrueba').disabled = true;\n      const per = personaVista();\n      const bytes = await pdfDe(per, $('verRol').value, null);\n      const nombre = 'Prueba ' + S.act.nombre.replace(/[^\\wáéíóúñü ]+/gi, ' ').trim().slice(0, 60) + '.pdf';\n      if (window.descargarArchivo) window.descargarArchivo(new Blob([bytes], { type: 'application/pdf' }), nombre, bytesABase64(bytes));\n      aviso('PDF de prueba descargado.');\n    } catch (e) { alert('No se pudo crear el PDF de prueba: ' + e.message); }\n    finally { $('btnPrueba').disabled = false; }\n  }\n\n  function actualizarSelector() {\n    const s = $('actividad'), v = s.value; s.innerHTML = '';\n    S.ini.actividades.forEach((a) => s.insertAdjacentHTML('beforeend', '<option value=\"' + a.id + '\">' +\n      esc(a.nombre) + (a.pendientes ? '  · ' + a.pendientes + ' por generar' : '') + (a.conDiseno ? '  · diseño propio' : '') + '</option>'));\n    if (v) s.value = v;\n  }\n\n  // ─────────── arranque ───────────\n  async function arrancar(preferida) {\n    try {\n      if (typeof PDFLib === 'undefined') throw new Error('No se han podido cargar las librerías (¿sin conexión?).');\n      cargando(true, 'Preparando logos y tipografías…');\n      await Promise.all([registrarImagen('pastoral', LOGOS.pastoral), registrarImagen('safa', LOGOS.safa), registrarImagen('uja', LOGOS.uja)]);\n      S.ini = await llamar('api_inicioEditor');\n      if (!S.ini.actividades.length) { cargando(true, 'Todavía no hay actividades. Créalas en «Actividades» y vuelve aquí.'); S.ini = null; return; }\n      miniPlantillas(); enlazarControles(); actualizarSelector();\n      const primera = S.ini.actividades.find((a) => a.id === preferida) || S.ini.actividades.find((a) => a.pendientes) || S.ini.actividades[0];\n      $('actividad').value = primera.id;\n      await fuente('opensans');\n      await cargarActividad(primera.id);\n      if (primera.pendientes) pestana('diseno');\n    } catch (e) { cargando(true, 'Error: ' + e.message); }\n  }\n  /** El panel abre el editor en una actividad y pestaña concretas. */\n  window.abrirEditor = async function (actId, tab) {\n    if (!S.ini) { await arrancar(actId); }\n    else {\n      S.ini = await llamar('api_inicioEditor'); actualizarSelector();\n      if (actId && (!S.act || actId !== S.act.id)) { $('actividad').value = actId; await cargarActividad(actId); }\n      else if (S.act) { S.cola = await llamar('api_cola', S.act.id); pintarCola(); opcionesVista(); }\n    }\n    if (tab && S.ini) pestana(tab);\n    programarVista();\n  };\n})();\n</script>\n\n", "Publico": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<base target=\"_top\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<?!= incluir_('Logos') ?>\n<?!= incluir_('Estilos') ?>\n<style>\n  body { background: var(--fondo); }\n  .hero { --c: #136EA1; background: var(--c); color: #fff; padding: 0 0 64px; position: relative; overflow: hidden; }\n  .hero::after { content: ''; position: absolute; right: -80px; top: -60px; width: 300px; height: 300px; border-radius: 50%; background: rgba(255,255,255,.07); }\n  .hero::before { content: ''; position: absolute; left: -60px; bottom: -120px; width: 260px; height: 260px; border-radius: 50%; background: rgba(255,255,255,.06); }\n  .hero .dentro { position: relative; z-index: 1; max-width: 680px; margin: 0 auto; padding: 22px 20px 0; }\n  .marca { display: inline-flex; align-items: center; background: #fff; border-radius: 14px; padding: 8px 14px; box-shadow: 0 4px 14px rgba(0,0,0,.12); }\n  .marca img { height: 38px; display: block; }\n  .hero small { display: block; margin-top: 22px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; font-size: 12.5px; opacity: .9; }\n  .hero h1 { color: #fff; font-size: clamp(26px, 6vw, 34px); line-height: 1.15; margin: 6px 0 10px; }\n  .hero p { margin: 0; font-size: 16px; line-height: 1.55; opacity: .96; max-width: 560px; }\n  .hero .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }\n  .hero .meta span { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.16); border-radius: 999px; padding: 5px 12px; font-size: 13.5px; font-weight: 600; }\n  .contenedor { max-width: 680px; margin: -44px auto 0; padding: 0 14px; position: relative; z-index: 2; }\n  .tarjeta { background: #fff; border-radius: 18px; padding: 24px 22px; margin-bottom: 14px; box-shadow: var(--sombra); border: 1px solid var(--borde); }\n  .tarjeta > h2 { font-size: 19px; margin: 0 0 4px; display: flex; align-items: center; gap: 10px; }\n  .tarjeta > h2 .paso { width: 28px; height: 28px; border-radius: 50%; background: var(--azul-claro); color: var(--azul-osc); font-size: 15px; display: inline-flex; align-items: center; justify-content: center; flex: none; }\n  .tarjeta .sub { color: var(--suave); font-size: 14.5px; margin: 0 0 14px; }\n  .fila2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }\n  .enviar { width: 100%; min-height: 54px; font-size: 17px; border-radius: 12px; margin-top: 18px; }\n  .act { border: 1.5px solid var(--borde-fuerte); border-radius: 14px; padding: 14px; margin-bottom: 10px; transition: border-color .15s ease, background-color .15s ease; }\n  .act.marcada { border-color: var(--azul); background: #f8fbfd; }\n  .act .top { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }\n  .act input[type=checkbox] { width: 22px; height: 22px; margin-top: 1px; accent-color: var(--azul); flex: none; }\n  .act b { display: block; font-size: 16px; }\n  .act small { color: var(--suave); font-size: 13.5px; }\n  .act .det { margin: 12px 0 0 34px; }\n  .roles { display: flex; flex-wrap: wrap; gap: 6px; }\n  .roles label { position: relative; }\n  .roles input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n  .roles span { display: inline-flex; align-items: center; min-height: 42px; padding: 8px 14px; border-radius: 999px; border: 1.5px solid var(--borde-fuerte); font-weight: 700; font-size: 14px; cursor: pointer; background: #fff; transition: all .15s ease; }\n  .roles input:checked + span { background: var(--c, var(--azul)); border-color: var(--c, var(--azul)); color: #fff; }\n  .roles input:focus-visible + span { box-shadow: var(--foco); }\n  .estrellas { display: inline-flex; gap: 2px; vertical-align: middle; }\n  .estrellas button { border: 0; background: none; cursor: pointer; padding: 4px; color: #c3ccd5; min-width: 40px; min-height: 40px; border-radius: 8px; }\n  .estrellas button .ic { width: 26px; height: 26px; }\n  .estrellas button.on { color: #F29100; }\n  .estrellas button.on .ic { fill: #F29100; }\n  .check { display: flex; gap: 12px; align-items: flex-start; margin: 12px 0; font-size: 14.5px; line-height: 1.5; cursor: pointer; }\n  .check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--azul); flex: none; }\n  details.priv { font-size: 13.5px; color: var(--suave); line-height: 1.55; margin: 4px 0 6px; background: var(--fondo); border-radius: 10px; padding: 10px 12px; }\n  details.priv summary { cursor: pointer; color: var(--azul-osc); font-weight: 700; min-height: 28px; }\n  .resultado-final { text-align: center; padding: 30px 22px; }\n  .resultado-final .circulo { width: 72px; height: 72px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; }\n  .resultado-final .circulo .ic { width: 36px; height: 36px; }\n  .resultado-final h2 { font-size: 23px; margin: 6px 0 8px; justify-content: center; }\n  .resultado-final p { color: var(--suave); line-height: 1.6; margin: 0 auto 10px; max-width: 460px; }\n  .c-bien { background: var(--ok-claro); color: var(--ok); } .c-mal { background: var(--mal-claro); color: var(--mal); } .c-info { background: var(--azul-claro); color: var(--azul-osc); }\n  .codigo-entrada { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 26px !important; letter-spacing: 6px; text-align: center; text-transform: uppercase; min-height: 60px !important; }\n  .verif-form { display: flex; gap: 8px; }\n  .verif-form input { text-transform: uppercase; }\n  .estado { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 12px; margin: 16px 0 10px; font-weight: 700; }\n  .estado.bien { background: var(--ok-claro); color: var(--ok); } .estado.mal { background: var(--mal-claro); color: var(--mal); } .estado.medio { background: var(--aviso-claro); color: var(--aviso); }\n  table.datos { width: 100%; border-collapse: collapse; }\n  table.datos th { text-align: left; color: var(--suave); font-weight: 600; padding: 9px 12px 9px 0; vertical-align: top; width: 120px; font-size: 14px; }\n  table.datos td { padding: 9px 0; border-bottom: 1px solid #edf1f4; }\n  .pie { text-align: center; font-size: 12.5px; color: var(--suave); padding: 10px 16px 30px; line-height: 1.6; }\n  .trampa { position: absolute; left: -5000px; width: 1px; height: 1px; }\n  .cargando-pub { display: flex; align-items: center; gap: 12px; color: var(--suave); font-weight: 600; }\n  @media (max-width: 520px) { .fila2 { grid-template-columns: 1fr; } .act .det { margin-left: 0; } .tarjeta { padding: 20px 16px; } .verif-form { flex-direction: column; } }\n</style>\n</head>\n<body>\n<?!= incluir_('Iconos') ?>\n<header class=\"hero\" id=\"hero\">\n  <div class=\"franja-logo\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>\n  <div class=\"dentro\">\n    <span class=\"marca\"><img id=\"logo\" alt=\"Pastoral · Centro Universitario Sagrada Familia\"></span>\n    <small id=\"antetitulo\">Servicio de Pastoral y Compromiso Solidario</small>\n    <h1 id=\"titulo\">Pastoral</h1>\n    <p id=\"intro\"></p>\n    <div class=\"meta\" id=\"meta\"></div>\n  </div>\n</header>\n<main class=\"contenedor\" id=\"contenido\"><div class=\"tarjeta\"><div class=\"cargando-pub\"><div class=\"girando\"></div>Cargando…</div></div></main>\n<footer class=\"pie\">Centro Universitario «Sagrada Familia» · Úbeda · Centro adscrito a la Universidad de Jaén<br><i>Libres para servir</i></footer>\n<?!= incluir_('FormVista') ?>\n\n<script>\n(function () {\n  'use strict';\n  const TIPO = <?!= tipoJs ?>;\n  const DATOS = <?!= datosJs ?>;\n  const URL_APP = <?!= urlJs ?>;\n  const $ = (id) => document.getElementById(id);\n  const esc = (t) => String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n  const ic = window.ic;\n  $('logo').src = LOGOS.pastoral;\n  const C = $('contenido');\n  const llamar = (fn, ...args) => new Promise((ok, ko) => { google.script.run.withSuccessHandler(ok).withFailureHandler((e) => ko(e && e.message ? e : new Error(String(e))))[fn].apply(null, args); });\n  function cabecera(o) {\n    if (o.color) { $('hero').style.setProperty('--c', o.color); document.body.style.setProperty('--c', o.color); }\n    if (o.antetitulo) $('antetitulo').textContent = o.antetitulo;\n    $('titulo').textContent = o.titulo || 'Pastoral';\n    $('intro').textContent = o.intro || '';\n    $('meta').innerHTML = (o.meta || []).filter((m) => m[1]).map((m) => '<span>' + ic(m[0], 'peq') + esc(m[1]) + '</span>').join('');\n    document.title = (o.titulo || 'Pastoral') + ' · Pastoral C.U. SAFA';\n  }\n  function final(clase, icono, titulo, html) {\n    C.innerHTML = '<div class=\"tarjeta resultado-final\" role=\"status\"><div class=\"circulo ' + clase + '\">' + ic(icono) + '</div><h2>' + titulo + '</h2>' + html + '</div>';\n    window.scrollTo(0, 0);\n  }\n  function error(id, t) { const e = $(id); e.innerHTML = t ? ic('aviso') + '<div>' + esc(t) + '</div>' : ''; e.classList.toggle('oculto', !t); if (t) e.scrollIntoView({ block: 'center', behavior: 'smooth' }); }\n  function dniValido(d) {\n    const m = String(d).toUpperCase().replace(/[\\s.\\-]/g, '').match(/^([0-9XYZ])(\\d{7})([A-Z])$/);\n    if (!m) return false;\n    return 'TRWAGMYFPDXBNJZSQVHLCKE'.charAt(Number(({ X: '0', Y: '1', Z: '2' }[m[1]] || m[1]) + m[2]) % 23) === m[3];\n  }\n  function bloqueDatos(paso) {\n    return '<div class=\"tarjeta\"><h2>' + (paso ? '<span class=\"paso\">' + paso + '</span>' : '') + 'Tus datos para el certificado</h2><p class=\"sub\">Escríbelos tal como quieres que aparezcan. Solo los verá el equipo de Pastoral.</p>' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"nombre\">Nombre</label><input type=\"text\" id=\"nombre\" autocomplete=\"given-name\"></div><div><label class=\"etq\" for=\"apellidos\">Apellidos</label><input type=\"text\" id=\"apellidos\" autocomplete=\"family-name\"></div></div>' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"dni\">DNI / NIE</label><input type=\"text\" id=\"dni\" placeholder=\"12345678Z\" autocomplete=\"off\" autocapitalize=\"characters\"></div><div><label class=\"etq\" for=\"email\">Correo</label><input type=\"email\" id=\"email\" autocomplete=\"email\" inputmode=\"email\"></div></div>' +\n      '<p class=\"ayuda\" style=\"margin:8px 0 0\">Te escribiremos a este correo para confirmar y, cuando esté firmado, para que descargues tu certificado.</p>' +\n      '<input type=\"text\" id=\"web\" class=\"trampa\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\"></div>';\n  }\n  function bloquePrivacidad(info, paso, boton) {\n    return '<div class=\"tarjeta\"><h2>' + (paso ? '<span class=\"paso\">' + paso + '</span>' : '') + 'Protección de datos</h2>' +\n      '<details class=\"priv\"><summary>Leer la información sobre protección de datos</summary><p>' + esc(info.privacidad) + '</p></details>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"c1\"> He leído la información sobre protección de datos y acepto el tratamiento de mis datos para gestionar y expedir mi certificado.</label>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"c2\"> Consiento expresamente que se trate la información sobre mi participación en actividades del Servicio de Pastoral, que podría revelar convicciones religiosas (art. 9.2.a RGPD).</label>' +\n      '<div id=\"error\" class=\"error oculto\" role=\"alert\"></div><button class=\"boton primario enviar\" id=\"enviar\">' + ic('enviar') + boton + '</button>' +\n      '<p class=\"ayuda\" style=\"text-align:center;margin:12px 0 0\">Te enviaremos un correo para que confirmes el registro.</p></div>';\n  }\n  function datosPersonales() {\n    return { nombre: $('nombre').value, apellidos: $('apellidos').value, dni: $('dni').value, email: $('email').value,\n      consentimiento: $('c1').checked, consentimiento9: $('c2').checked, web: $('web').value };\n  }\n  function comprobarPersonales(d) {\n    const marca = (id, mal) => { $(id).setAttribute('aria-invalid', mal ? 'true' : 'false'); return mal; };\n    if (marca('nombre', !d.nombre.trim()) | marca('apellidos', !d.apellidos.trim())) return 'Escribe tu nombre y apellidos.';\n    if (marca('dni', !dniValido(d.dni))) return 'El DNI/NIE no es válido: revisa el número y la letra.';\n    if (marca('email', !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(d.email.trim()))) return 'Escribe un correo válido.';\n    if (!d.consentimiento || !d.consentimiento9) return 'Necesitamos tus dos consentimientos para expedir el certificado.';\n    return '';\n  }\n  function enviarInscripcion(datos, cierre) {\n    $('enviar').disabled = true; $('enviar').lastChild.textContent = 'Enviando…';\n    llamar('api_publicoInscribir', datos).then((r) => {\n      final('c-info', 'correo', 'Revisa tu correo', '<p>Te hemos enviado un mensaje a <b>' + esc(r.email) + '</b>. Pulsa «Confirmar mi registro» para que sea válido. Si no lo ves, mira en el correo no deseado.</p>' + (cierre ? '<p>' + esc(cierre) + '</p>' : ''));\n    }).catch((e) => { error('error', e.message); $('enviar').disabled = false; $('enviar').lastChild.textContent = 'Enviar inscripción'; });\n  }\n  function estrellas(cont, alCambiar) {\n    cont.innerHTML = [1, 2, 3, 4, 5].map((n) => '<button type=\"button\" data-v=\"' + n + '\" aria-label=\"' + n + ' de 5\" aria-pressed=\"false\">' + ic('estrella') + '</button>').join('');\n    cont.querySelectorAll('button').forEach((b) => { b.onclick = () => { const v = Number(b.dataset.v); alCambiar(v); cont.querySelectorAll('button').forEach((x) => { const on = Number(x.dataset.v) <= v; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(Number(x.dataset.v) === v)); }); }; });\n  }\n\n  // ─────────── Registro general (todas las actividades abiertas) ───────────\n  if (TIPO === 'inscripcion') {\n    cabecera({ titulo: 'Registro de participación', intro: 'Marca las actividades en las que has estado para recibir tu certificado firmado.' });\n    llamar('api_publicoActividades').then(pintarGeneral).catch((e) => { C.innerHTML = '<div class=\"tarjeta\"><div class=\"error\">' + esc(e.message) + '</div></div>'; });\n  }\n  function pintarGeneral(info) {\n    if (!info.actividades.length) return final('c-info', 'calendario', 'Ahora mismo no hay actividades abiertas', '<p>Vuelve cuando el equipo de Pastoral te lo indique.</p>');\n    const sel = {};\n    C.innerHTML = '<div class=\"tarjeta\"><h2><span class=\"paso\">1</span>¿En qué actividades has estado?</h2><p class=\"sub\">Marca cada una e indica cómo participaste. Si quieres, valórala: es anónimo.</p><div id=\"acts\"></div></div>' +\n      bloqueDatos(2) +\n      '<div class=\"tarjeta\"><h2><span class=\"paso\">3</span>¿Qué te ha aportado? <span class=\"ayuda\" style=\"font-family:var(--cuerpo)\">(opcional y anónimo)</span></h2>' +\n      '<label class=\"sr\" for=\"comentario\">Comentario</label><textarea id=\"comentario\" rows=\"3\" placeholder=\"Una frase, una experiencia, algo que te llevas…\"></textarea>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"citable\"> Podéis citar mi comentario en el boletín de Pastoral, siempre sin mi nombre.</label></div>' +\n      bloquePrivacidad(info, 4, 'Enviar registro');\n    info.actividades.forEach((a) => {\n      const d = document.createElement('div'); d.className = 'act';\n      d.innerHTML = '<div class=\"top\"><input type=\"checkbox\" id=\"a_' + a.id + '\"><label for=\"a_' + a.id + '\" style=\"cursor:pointer\"><b>' + esc(a.nombre) + '</b><small>' + esc([a.tipo, a.fechas].filter(Boolean).join(' · ')) + '</small></label></div>' +\n        '<div class=\"det oculto\"><div class=\"roles\" role=\"radiogroup\" aria-label=\"Cómo participaste\">' + info.roles.map((r, i) => '<label><input type=\"radio\" name=\"r_' + a.id + '\" value=\"' + esc(r) + '\"' + (i ? '' : ' checked') + '><span>' + esc(r) + '</span></label>').join('') + '</div>' +\n        '<div style=\"margin-top:10px;font-size:14px;color:var(--suave)\">Tu valoración: <span class=\"estrellas\"></span></div></div>';\n      const caja = d.querySelector('input[type=checkbox]'), det = d.querySelector('.det');\n      caja.onchange = () => { d.classList.toggle('marcada', caja.checked); det.classList.toggle('oculto', !caja.checked); if (caja.checked) sel[a.id] = sel[a.id] || { id: a.id, valor: null }; else delete sel[a.id]; };\n      estrellas(d.querySelector('.estrellas'), (v) => { if (sel[a.id]) sel[a.id].valor = v; });\n      $('acts').appendChild(d);\n    });\n    $('enviar').onclick = () => {\n      error('error', '');\n      const datos = Object.assign(datosPersonales(), { comentario: $('comentario').value, citable: $('citable').checked,\n        actividades: Object.values(sel).map((x) => ({ id: x.id, valor: x.valor, rol: (document.querySelector('input[name=\"r_' + x.id + '\"]:checked') || {}).value })) });\n      if (!datos.actividades.length) return error('error', 'Marca al menos una actividad.');\n      const mal = comprobarPersonales(datos);\n      if (mal) return error('error', mal);\n      enviarInscripcion(datos);\n    };\n  }\n\n  // ─────────── Formulario de inscripción de una actividad ───────────\n  if (TIPO === 'formulario') llamar('api_publicoFormulario', 'inscripcion', DATOS.actividad).then(pintarFormulario).catch((e) => final('c-mal', 'aviso', 'No se ha podido abrir', '<p>' + esc(e.message) + '</p>'));\n  function metaDe(a) { return [['calendario', a.fechas], ['inicio', a.lugar]]; }\n  function pintarFormulario(info) {\n    if (info.cerrado) {\n      cabecera({ titulo: info.actividad ? info.actividad.nombre : 'Inscripción', antetitulo: 'Inscripción' });\n      return final('c-info', 'candado', 'Inscripción cerrada', '<p>' + esc(info.mensaje) + '</p>');\n    }\n    const def = info.formulario, a = info.actividad;\n    cabecera({ titulo: def.titulo, intro: def.intro, color: def.color, antetitulo: 'Inscripción · ' + (a.tipo || 'Pastoral'), meta: metaDe(a) });\n    C.innerHTML = '<div class=\"tarjeta\"><h2><span class=\"paso\">1</span>¿Cómo participas?</h2><div class=\"roles\" role=\"radiogroup\" aria-label=\"Cómo participas\" style=\"--c:' + esc(def.color) + '\">' +\n      info.roles.map((r, i) => '<label><input type=\"radio\" name=\"rol\" value=\"' + esc(r) + '\"' + (i ? '' : ' checked') + '><span>' + esc(r) + '</span></label>').join('') + '</div></div>' +\n      bloqueDatos(2) +\n      (def.preguntas.length ? '<div class=\"tarjeta\"><h2><span class=\"paso\">3</span>Unas preguntas más</h2><div id=\"preguntas\"></div></div>' : '') +\n      bloquePrivacidad(info, def.preguntas.length ? 4 : 3, 'Enviar inscripción');\n    if (def.preguntas.length) window.FV.montar($('preguntas'), def);\n    $('enviar').style.background = def.color; $('enviar').style.borderColor = def.color;\n    $('enviar').onclick = () => {\n      error('error', '');\n      const datos = datosPersonales();\n      const rol = (document.querySelector('input[name=\"rol\"]:checked') || {}).value;\n      let resp = {};\n      if (def.preguntas.length) {\n        resp = window.FV.leer($('preguntas'), def);\n        const mal = window.FV.comprobar($('preguntas'), def, resp);\n        if (mal) { error('error', 'Te falta alguna pregunta obligatoria.'); mal.scrollIntoView({ block: 'center', behavior: 'smooth' }); return; }\n      }\n      const malP = comprobarPersonales(datos);\n      if (malP) return error('error', malP);\n      enviarInscripcion(Object.assign(datos, { formulario: a.id, actividades: [{ id: a.id, rol: rol }], respuestas: { [a.id]: resp } }), def.cierre);\n    };\n  }\n\n  // ─────────── Evaluación anónima ───────────\n  if (TIPO === 'evaluacion') llamar('api_publicoFormulario', 'evaluacion', DATOS.actividad).then(pintarEvaluacion).catch((e) => final('c-mal', 'aviso', 'No se ha podido abrir', '<p>' + esc(e.message) + '</p>'));\n  function pintarEvaluacion(info) {\n    if (info.cerrado) {\n      cabecera({ titulo: info.actividad ? info.actividad.nombre : 'Evaluación', antetitulo: 'Evaluación' });\n      return final('c-info', 'candado', 'Evaluación cerrada', '<p>' + esc(info.mensaje) + '</p>');\n    }\n    const def = info.formulario, a = info.actividad;\n    cabecera({ titulo: def.titulo, intro: def.intro, color: def.color, antetitulo: 'Evaluación anónima · ' + a.nombre, meta: metaDe(a) });\n    const hayComentario = def.preguntas.some((q) => q.clave === 'comentario');\n    C.innerHTML = '<div class=\"tarjeta\"><div id=\"preguntas\"></div>' +\n      (hayComentario ? '<label class=\"check\"><input type=\"checkbox\" id=\"citable\"> Podéis citar mi comentario en el boletín de Pastoral (siempre sin nombre).</label>' : '') +\n      '<input type=\"text\" id=\"web\" class=\"trampa\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">' +\n      '<div id=\"error\" class=\"error oculto\" role=\"alert\"></div><button class=\"boton primario enviar\" id=\"enviar\" style=\"background:' + esc(def.color) + ';border-color:' + esc(def.color) + '\">' + ic('enviar') + 'Enviar mi valoración</button>' +\n      '<p class=\"ayuda\" style=\"text-align:center;margin:12px 0 0\">' + ic('candado', 'peq') + ' No se guarda ningún dato que te identifique.</p></div>';\n    window.FV.montar($('preguntas'), def);\n    $('enviar').onclick = () => {\n      error('error', '');\n      const r = window.FV.leer($('preguntas'), def);\n      const mal = window.FV.comprobar($('preguntas'), def, r);\n      if (mal) { mal.scrollIntoView({ block: 'center', behavior: 'smooth' }); return; }\n      if (!Object.keys(r).length) return error('error', 'Responde al menos una pregunta.');\n      $('enviar').disabled = true; $('enviar').lastChild.textContent = 'Enviando…';\n      llamar('api_publicoEvaluar', a.id, r, { citable: $('citable') ? $('citable').checked : false, web: $('web').value })\n        .then((x) => final('c-bien', 'ok', '¡Gracias!', '<p>' + esc(x.cierre) + '</p>'))\n        .catch((e) => { error('error', e.message); $('enviar').disabled = false; $('enviar').lastChild.textContent = 'Enviar mi valoración'; });\n    };\n  }\n\n  // ─────────── Confirmación ───────────\n  if (TIPO === 'confirmar') {\n    cabecera({ titulo: 'Registro de participación' });\n    if (DATOS.ok) final('c-bien', 'ok', '¡Gracias, ' + esc(DATOS.nombre) + '!', '<p>Tu registro está confirmado:</p><p><b>' + DATOS.actividades.map(esc).join('</b><br><b>') + '</b></p>' +\n      '<p>Cuando el equipo de Pastoral lo revise y el certificado esté firmado, te llegará un correo con un código para descargarlo.</p>');\n    else final('c-mal', 'aviso', 'No se ha podido confirmar', '<p>' + esc(DATOS.mensaje) + '</p><p><a href=\"' + esc(URL_APP) + '?p=inscripcion\">Volver al registro</a></p>');\n  }\n\n  // ─────────── Descarga privada del certificado ───────────\n  if (TIPO === 'descargar') {\n    cabecera({ titulo: 'Tu certificado', intro: 'Escribe el código privado que te ha llegado por correo para descargarlo.' });\n    if (!DATOS.codigo) final('c-mal', 'aviso', 'Falta el certificado', '<p>Abre el enlace del correo que te enviamos.</p>');\n    else {\n      C.innerHTML = '<div class=\"tarjeta\"><h2>' + ic('candado') + 'Descarga privada</h2><p class=\"sub\">Certificado <b>' + esc(DATOS.codigo) + '</b>. El código de 8 caracteres está en el correo, en el recuadro «Tu código de descarga».</p>' +\n        '<label class=\"etq\" for=\"clave\">Código de descarga</label><input type=\"text\" id=\"clave\" class=\"codigo-entrada\" maxlength=\"9\" autocomplete=\"one-time-code\" autocapitalize=\"characters\" spellcheck=\"false\" placeholder=\"XXXX-XXXX\">' +\n        '<div id=\"error\" class=\"error oculto\" role=\"alert\" style=\"margin-top:12px\"></div><button class=\"boton primario enviar\" id=\"bajar\">' + ic('descargar') + 'Descargar mi certificado</button></div>';\n      $('clave').oninput = () => { let v = $('clave').value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8); if (v.length > 4) v = v.slice(0, 4) + '-' + v.slice(4); $('clave').value = v; };\n      $('clave').onkeydown = (e) => { if (e.key === 'Enter') $('bajar').click(); };\n      $('bajar').onclick = () => {\n        error('error', '');\n        if ($('clave').value.replace(/-/g, '').length !== 8) return error('error', 'El código tiene 8 caracteres.');\n        $('bajar').disabled = true; $('bajar').lastChild.textContent = 'Comprobando…';\n        llamar('api_publicoDescargar', DATOS.codigo, $('clave').value).then((r) => {\n          const bin = atob(r.base64), u = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);\n          const url = URL.createObjectURL(new Blob([u], { type: 'application/pdf' }));\n          final('c-bien', 'certificado', 'Aquí tienes tu certificado', '<p>' + esc(r.actividad) + '</p>' +\n            '<p><a class=\"boton primario enviar\" id=\"enlacePdf\" href=\"' + url + '\" download=\"' + esc(r.nombre) + '\">' + ic('descargar') + 'Guardar el PDF</a></p>' +\n            '<p class=\"ayuda\">Está firmado electrónicamente: guárdalo tal cual, sin imprimirlo ni editarlo, para que conserve su validez.</p>' +\n            (r.evaluacion ? '<div class=\"nota\" style=\"text-align:left;margin-top:16px\">' + ic('estrella') + '<div><b>¿Nos cuentas cómo lo has vivido?</b><br>La evaluación es anónima y nos ayuda a mejorar. <a href=\"' + esc(r.evaluacion) + '\">Responder ahora</a></div></div>' : ''));\n          setTimeout(() => { const a = $('enlacePdf'); if (a) a.click(); }, 300);\n        }).catch((e) => { error('error', e.message); $('bajar').disabled = false; $('bajar').lastChild.textContent = 'Descargar mi certificado'; });\n      };\n    }\n  }\n\n  // ─────────── Verificación ───────────\n  if (TIPO === 'verificar') {\n    cabecera({ titulo: 'Verificación de certificados', intro: 'Comprueba si un certificado del Servicio de Pastoral es auténtico.' });\n    const r = DATOS.r;\n    let res = '';\n    if (r && r.estado === 'ok') {\n      res = '<div class=\"estado bien\">' + ic('ok') + 'Certificado auténtico</div><table class=\"datos\">' +\n        '<tr><th>Código</th><td>' + esc(r.codigo) + '</td></tr><tr><th>Titular</th><td>' + esc(r.iniciales) + ' <small class=\"ayuda\">(solo iniciales, por privacidad)</small></td></tr>' +\n        '<tr><th>Actividad</th><td>' + esc(r.actividad) + '</td></tr><tr><th>Fechas</th><td>' + esc(r.fechas) + '</td></tr><tr><th>Condición</th><td>' + esc(r.rol) + '</td></tr>' +\n        (r.horas ? '<tr><th>Duración</th><td>' + String(r.horas).replace('.', ',') + ' horas</td></tr>' : '') + (r.ects ? '<tr><th>ECTS</th><td>' + String(r.ects).replace('.', ',') + '</td></tr>' : '') +\n        '<tr><th>Expedido</th><td>' + esc(r.expedido) + '</td></tr><tr><th>Firmado por</th><td>' + r.firmantes.map(esc).join('<br>') + '</td></tr></table>';\n    } else if (r && r.estado === 'anulado') res = '<div class=\"estado mal\">' + ic('cerrar') + 'Este certificado fue anulado y no tiene validez.</div>';\n    else if (r && r.estado === 'tramite') res = '<div class=\"estado medio\">' + ic('reloj') + 'Este certificado está en trámite y todavía no se ha expedido.</div>';\n    else if (r && r.estado === 'no') res = '<div class=\"estado mal\">' + ic('aviso') + 'No existe ningún certificado con el código ' + esc(DATOS.codigo) + '. Revisa que esté bien escrito.</div>';\n    C.innerHTML = '<div class=\"tarjeta\"><p class=\"sub\">Escribe el código que aparece al pie del certificado o escanea su QR.</p>' +\n      '<form class=\"verif-form\" method=\"get\" action=\"' + esc(URL_APP) + '\" target=\"_top\"><input type=\"hidden\" name=\"p\" value=\"verificar\"><label class=\"sr\" for=\"cv\">Código</label><input type=\"text\" id=\"cv\" name=\"c\" placeholder=\"SAFA-PAS-2627-XXXXXX\" value=\"' + esc(DATOS.codigo || '') + '\"><button class=\"boton primario\">Comprobar</button></form>' + res + '</div>';\n  }\n})();\n</script>\n</body>\n</html>\n", "Estilos": "<!-- Sistema visual común (panel y páginas públicas): paleta del logo de Pastoral, Outfit + Nunito Sans. -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&family=Outfit:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    /* Paleta del logo PASTORAL */\n    --azul: #136EA1; --azul-osc: #0E5680; --azul-claro: #E6F1F8; --azul-borde: #B9D7EA;\n    --rojo: #E33229; --naranja: #F29100; --verde: #2BA962; --magenta: #E3007C; --indigo: #33228A; --marron: #925F2F; --gris-logo: #545454;\n    /* Neutros y semántica (contraste AA sobre blanco) */\n    --texto: #1B2733; --suave: #56636F; --borde: #E1E7ED; --borde-fuerte: #CBD5DE; --fondo: #F4F7FA; --blanco: #fff;\n    --ok: #17693B; --ok-claro: #E3F4EA; --mal: #B01E17; --mal-claro: #FCE9E8; --aviso: #8A4B00; --aviso-claro: #FEF1DD;\n    --sombra: 0 1px 2px rgba(16,40,64,.06), 0 4px 16px rgba(16,40,64,.06);\n    --sombra-alta: 0 18px 50px rgba(16,40,64,.18);\n    --radio: 14px; --radio-p: 9px;\n    --titulos: 'Outfit', 'Nunito Sans', system-ui, sans-serif;\n    --cuerpo: 'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;\n    --foco: 0 0 0 3px rgba(19,110,161,.35);\n  }\n  * { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body { margin: 0; font-family: var(--cuerpo); color: var(--texto); background: var(--fondo); font-size: 15px; line-height: 1.5; }\n  h1, h2, h3, h4 { font-family: var(--titulos); font-weight: 600; letter-spacing: -.01em; color: var(--texto); }\n  a { color: var(--azul-osc); text-underline-offset: 2px; }\n  button { font: inherit; }\n  .oculto { display: none !important; }\n  .sr { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n  .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; vertical-align: middle; }\n  .ic.peq { width: 16px; height: 16px; }\n  .ic.gr { width: 26px; height: 26px; }\n\n  /* Franja con los colores del logo */\n  .franja-logo { display: flex; height: 6px; }\n  .franja-logo i { flex: 1; }\n  .franja-logo i:nth-child(1) { background: var(--azul); } .franja-logo i:nth-child(2) { background: var(--rojo); }\n  .franja-logo i:nth-child(3) { background: var(--naranja); } .franja-logo i:nth-child(4) { background: var(--verde); }\n  .franja-logo i:nth-child(5) { background: var(--magenta); } .franja-logo i:nth-child(6) { background: var(--indigo); }\n  .franja-logo i:nth-child(7) { background: var(--marron); }\n\n  /* Botones */\n  .boton { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 9px 16px; border-radius: var(--radio-p);\n    border: 1px solid var(--borde-fuerte); background: #fff; color: var(--texto); font-weight: 700; font-size: 14.5px; cursor: pointer; text-decoration: none;\n    transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease; white-space: nowrap; }\n  .boton:hover { background: var(--fondo); border-color: #b5c2ce; }\n  .boton:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible, summary:focus-visible { outline: none; box-shadow: var(--foco); }\n  .boton.primario { background: var(--azul); border-color: var(--azul); color: #fff; }\n  .boton.primario:hover { background: var(--azul-osc); border-color: var(--azul-osc); }\n  .boton.exito { background: var(--ok); border-color: var(--ok); color: #fff; }\n  .boton.exito:hover { background: #0f5530; }\n  .boton.suave { background: var(--azul-claro); border-color: transparent; color: var(--azul-osc); }\n  .boton.suave:hover { background: #d6e8f4; }\n  .boton.fantasma { background: transparent; border-color: transparent; color: var(--azul-osc); }\n  .boton.fantasma:hover { background: var(--azul-claro); }\n  .boton.peligro { color: var(--mal); }\n  .boton.peligro:hover { background: var(--mal-claro); border-color: #f0b9b6; }\n  .boton.ia { background: linear-gradient(135deg, #33228A, #136EA1); border-color: transparent; color: #fff; }\n  .boton.ia:hover { filter: brightness(1.08); }\n  .boton.peq { min-height: 34px; padding: 5px 11px; font-size: 13px; gap: 6px; }\n  .boton.icono { width: 42px; padding: 0; }\n  .boton.peq.icono { width: 34px; }\n  .boton:disabled, .boton[aria-disabled=\"true\"] { opacity: .5; cursor: not-allowed; }\n\n  /* Formularios */\n  label.etq, .etq { display: block; font-weight: 700; font-size: 13px; color: var(--texto); margin: 14px 0 6px; }\n  .etq small { font-weight: 600; color: var(--suave); font-size: 12.5px; }\n  input[type=text], input[type=email], input[type=number], input[type=password], input[type=url], input[type=search], select, textarea {\n    width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--borde-fuerte); border-radius: var(--radio-p); font: inherit; font-size: 15px;\n    color: var(--texto); background: #fff; transition: border-color .15s ease, box-shadow .15s ease; }\n  textarea { line-height: 1.5; resize: vertical; min-height: 90px; }\n  input:hover, select:hover, textarea:hover { border-color: #aebbc8; }\n  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--azul); box-shadow: var(--foco); }\n  input[readonly] { background: var(--fondo); color: var(--suave); }\n  .ayuda { font-size: 13px; color: var(--suave); line-height: 1.5; }\n  .err-campo { color: var(--mal); font-size: 13px; font-weight: 600; margin-top: 6px; }\n  input[aria-invalid=\"true\"], textarea[aria-invalid=\"true\"] { border-color: var(--mal); }\n\n  /* Interruptor */\n  .interruptor { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; min-height: 40px; }\n  .interruptor input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n  .interruptor .pista { position: relative; width: 42px; height: 24px; border-radius: 24px; background: #c3ccd5; transition: background-color .2s ease; flex: none; }\n  .interruptor .pista::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25); transition: transform .2s ease; }\n  .interruptor input:checked + .pista { background: var(--azul); }\n  .interruptor input:checked + .pista::after { transform: translateX(18px); }\n  .interruptor input:focus-visible + .pista { box-shadow: var(--foco); }\n\n  /* Avisos */\n  .aviso, .nota, .error, .exito-msg { display: flex; gap: 10px; align-items: flex-start; border-radius: 12px; padding: 12px 14px; font-size: 14px; line-height: 1.5; margin: 0 0 14px; }\n  .aviso { background: var(--aviso-claro); color: var(--aviso); }\n  .nota { background: var(--azul-claro); color: #12354d; }\n  .error { background: var(--mal-claro); color: var(--mal); }\n  .exito-msg { background: var(--ok-claro); color: var(--ok); }\n  .aviso .ic, .nota .ic, .error .ic, .exito-msg .ic { margin-top: 1px; }\n\n  .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: #14202b; color: #fff; padding: 12px 18px; border-radius: 12px;\n    font-size: 14px; z-index: 90; box-shadow: var(--sombra-alta); max-width: calc(100% - 32px); animation: entrar .18s ease-out; }\n  @keyframes entrar { from { opacity: 0; transform: translate(-50%, 8px); } to { opacity: 1; transform: translate(-50%, 0); } }\n  .girando { width: 22px; height: 22px; border-radius: 50%; border: 3px solid var(--azul-claro); border-top-color: var(--azul); animation: girar .8s linear infinite; }\n  @keyframes girar { to { transform: rotate(360deg); } }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }\n  }\n</style>\n", "Iconos": "<!-- Iconos SVG (trazo, 24×24). Uso: ic('nombre') devuelve el <svg>. Decorativos: aria-hidden. -->\n<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"position:absolute;width:0;height:0;overflow:hidden\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <symbol id=\"i-inicio\" viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5 9.5V21h14V9.5\"/><path d=\"M9.5 21v-6h5v6\"/></symbol>\n    <symbol id=\"i-calendario\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4.5\" width=\"18\" height=\"16.5\" rx=\"2\"/><path d=\"M3 9.5h18M8 2.5v4M16 2.5v4\"/></symbol>\n    <symbol id=\"i-personas\" viewBox=\"0 0 24 24\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20.5c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5\"/><path d=\"M16 4.6a3.5 3.5 0 0 1 0 6.8M18 15.3c2 .7 3.2 2.5 3.5 5.2\"/></symbol>\n    <symbol id=\"i-paleta\" viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4C21 6.6 17 3 12 3Z\"/><circle cx=\"7.5\" cy=\"11.5\" r=\"1.2\"/><circle cx=\"10\" cy=\"7.3\" r=\"1.2\"/><circle cx=\"15\" cy=\"7.5\" r=\"1.2\"/></symbol>\n    <symbol id=\"i-firma\" viewBox=\"0 0 24 24\"><path d=\"M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z\"/><path d=\"M13.5 6.5l4 4\"/></symbol>\n    <symbol id=\"i-certificado\" viewBox=\"0 0 24 24\"><path d=\"M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5Z\"/><path d=\"M14 3v5h5\"/><path d=\"m9 14.5 2 2 4-4\"/></symbol>\n    <symbol id=\"i-enviar\" viewBox=\"0 0 24 24\"><path d=\"M21 3 10.5 13.5\"/><path d=\"M21 3 14.5 21l-4-7.5L3 9.5 21 3Z\"/></symbol>\n    <symbol id=\"i-grafico\" viewBox=\"0 0 24 24\"><path d=\"M4 4v16h16\"/><path d=\"M8 16v-4M12 16V8M16 16v-6M20 16V6\"/></symbol>\n    <symbol id=\"i-formulario\" viewBox=\"0 0 24 24