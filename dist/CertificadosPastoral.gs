d=\"pnConfigar\">Configurar la aplicación</button>\n        <p class=\"ayuda\" style=\"margin-top:12px\">Se crearán en tu Drive, en la carpeta «Pastoral · Certificados (app)», los datos y la bóveda privada. Nadie más tiene acceso.</p>\n      </div>\n    </div>\n    <div id=\"pnErrorAcceso\" class=\"pn-error oculto\"></div>\n  </div>\n  <div class=\"pn-franja abajo\"></div>\n</div>\n\n<!-- ─────────── APLICACIÓN ─────────── -->\n<div class=\"pn-app oculto\" id=\"pnApp\">\n  <aside class=\"pn-lateral\">\n    <div class=\"franja\"></div>\n    <div class=\"logo\"><img id=\"pnLogoLateral\" alt=\"Pastoral\"><div>Certificados · Pastoral y Compromiso Solidario</div></div>\n    <nav class=\"pn-nav\" id=\"pnNav\"></nav>\n    <div class=\"pn-usuario\"><b id=\"pnUNombre\"></b><span id=\"pnURol\"></span> · <a href=\"#\" id=\"pnSalir\">Salir</a></div>\n  </aside>\n  <main class=\"pn-contenido\" id=\"pnContenido\">\n    <section class=\"vista\" id=\"vInicio\"></section>\n    <section class=\"vista oculto\" id=\"vActividades\"></section>\n    <section class=\"vista oculto\" id=\"vInscripciones\"></section>\n    <section class=\"vista oculto\" id=\"vFirmar\"></section>\n    <section class=\"vista oculto\" id=\"vCertificados\"></section>\n    <section class=\"vista oculto\" id=\"vValoraciones\"></section>\n    <section class=\"vista oculto\" id=\"vEquipo\"></section>\n    <section class=\"vista oculto\" id=\"vAjustes\"></section>\n    <section class=\"vista oculto\" id=\"vRegistro\"></section>\n    <!-- La vista del editor (vistaEditor) se mueve aquí al arrancar -->\n  </main>\n</div>\n<div class=\"cargando-pn oculto\" id=\"pnCargando\">Cargando…</div>\n<?!= incluir_('Editor') ?>\n\n<script>\n(function () {\n  'use strict';\n  const $ = (id) => document.getElementById(id);\n  const esc = (t) => String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n  const ESTADOS = { pendiente: 'Pendiente', validada: 'Validada', rechazada: 'Rechazada', generando: 'Generando', firma: 'En firma', enviado: 'Enviado', anulado: 'Anulado', revisar: 'Revisar' };\n  const P = { usuario: null, actividades: [], vista: 'inicio', actSel: '' };\n\n  // ─────────── sesión ───────────\n  function guardarToken(t) { window.TOKEN = t; try { if (t) sessionStorage.setItem('pn_token', t); else sessionStorage.removeItem('pn_token'); } catch (e) { } }\n  function tokenGuardado() { try { return sessionStorage.getItem('pn_token') || ''; } catch (e) { return ''; } }\n  function llamar(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise((ok, ko) => {\n      google.script.run.withSuccessHandler(ok).withFailureHandler((e) => {\n        const err = e && e.message ? e : new Error(String(e));\n        if (/^SESION/.test(err.message)) window.sesionCaducada();\n        err.message = err.message.replace(/^(SESION|SIN_PERMISO): /, '');\n        ko(err);\n      })[fn].apply(null, [window.TOKEN].concat(args));\n    });\n  }\n  function publico(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise((ok, ko) => { google.script.run.withSuccessHandler(ok).withFailureHandler((e) => ko(e && e.message ? e : new Error(String(e))))[fn].apply(null, args); });\n  }\n  window.sesionCaducada = function () { guardarToken(''); mostrarAcceso(); errorAcceso('Tu sesión ha caducado. Vuelve a entrar.'); };\n  function aviso(t) { const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.appendChild(d); setTimeout(() => d.remove(), 3200); }\n  function cargando(si, t) { $('pnCargando').classList.toggle('oculto', !si); $('pnCargando').textContent = t || 'Cargando…'; }\n  function errorAcceso(t) { $('pnErrorAcceso').textContent = t; $('pnErrorAcceso').classList.toggle('oculto', !t); }\n\n  /** Descarga en el navegador; si el navegador la bloquea, la persona puede pedirlo por correo. */\n  window.descargarArchivo = function (blob, nombre) {\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a'); a.href = url; a.download = nombre; document.body.appendChild(a); a.click();\n    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 4000);\n  };\n  function b64aBlob(b64, tipo) { const bin = atob(b64), u = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i); return new Blob([u], { type: tipo }); }\n  function aBase64(buf) { const u = new Uint8Array(buf); let s = ''; for (let i = 0; i < u.length; i += 0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i + 0x8000)); return btoa(s); }\n\n  // ─────────── acceso ───────────\n  function mostrarAcceso() { $('pnApp').classList.add('oculto'); $('pnAcceso').classList.remove('oculto'); }\n  async function arrancar() {\n    $('pnLogoAcceso').src = LOGOS.pastoral; $('pnLogoLateral').src = LOGOS.pastoral;\n    // La vista del editor vive dentro del contenido del panel\n    $('pnContenido').appendChild($('vistaEditor'));\n    enlazarAcceso();\n    cargando(true);\n    try {\n      const est = await publico('api_estado');\n      if (!est.instalado) { mostrarAcceso(); $('pnPaso1').classList.add('oculto'); $('pnConfig').classList.remove('oculto'); $('pnProp').textContent = est.propietario; return; }\n      const t = tokenGuardado();\n      if (t) { guardarToken(t); try { const u = await llamar('api_yo'); entrarApp(u); return; } catch (e) { guardarToken(''); } }\n      mostrarAcceso();\n    } catch (e) { mostrarAcceso(); errorAcceso('No se pudo conectar: ' + e.message); }\n    finally { cargando(false); }\n  }\n  function enlazarAcceso() {\n    $('pnPedir').onclick = async () => {\n      errorAcceso('');\n      const email = $('pnEmail').value.trim();\n      if (!email) return errorAcceso('Escribe tu correo.');\n      $('pnPedir').disabled = true;\n      try { await publico('api_pedirCodigo', email); $('pnPaso1').classList.add('oculto'); $('pnPaso2').classList.remove('oculto'); $('pnCodigo').focus(); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnPedir').disabled = false; }\n    };\n    $('pnEmail').onkeydown = (e) => { if (e.key === 'Enter') $('pnPedir').click(); };\n    $('pnCodigo').onkeydown = (e) => { if (e.key === 'Enter') $('pnEntrar').click(); };\n    $('pnEntrar').onclick = async () => {\n      errorAcceso(''); $('pnEntrar').disabled = true;\n      try { const r = await publico('api_entrar', $('pnEmail').value.trim(), $('pnCodigo').value.trim()); guardarToken(r.token); entrarApp(r.usuario); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnEntrar').disabled = false; }\n    };\n    $('pnOtro').onclick = () => { $('pnPaso2').classList.add('oculto'); $('pnPaso1').classList.remove('oculto'); $('pnCodigo').value = ''; };\n    $('pnConfigPedir').onclick = async () => {\n      errorAcceso(''); $('pnConfigPedir').disabled = true;\n      try { await publico('api_configurarPedirCodigo'); $('pnConfig1').classList.add('oculto'); $('pnConfig2').classList.remove('oculto'); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnConfigPedir').disabled = false; }\n    };\n    $('pnConfigar').onclick = async () => {\n      errorAcceso(''); $('pnConfigar').disabled = true; cargando(true, 'Preparando la aplicación…');\n      try { const r = await publico('api_configurar', $('pnConfigCodigo').value.trim(), $('pnConfigNombre').value.trim()); guardarToken(r.token); entrarApp(r.usuario); aviso('¡Lista! Empieza por «Ajustes» para revisar los firmantes.'); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnConfigar').disabled = false; cargando(false); }\n    };\n    $('pnSalir').onclick = async (e) => { e.preventDefault(); try { await llamar('api_salir'); } catch (x) { } guardarToken(''); location.reload(); };\n  }\n\n  // ─────────── navegación ───────────\n  const MENU = [\n    { id: 'inicio', ic: '🏠', t: 'Inicio', nivel: 1 },\n    { id: 'actividades', ic: '📅', t: 'Actividades', nivel: 2 },\n    { id: 'inscripciones', ic: '👥', t: 'Inscripciones', nivel: 2, num: 'porValidar' },\n    { id: 'editor', ic: '🎨', t: 'Diseñar y generar', nivel: 2, num: 'porGenerar' },\n    { id: 'firmar', ic: '✍️', t: 'Firmar', nivel: 1, num: 'misFirmas', firmante: true },\n    { id: 'certificados', ic: '📄', t: 'Certificados', nivel: 2 },\n    { id: 'valoraciones', ic: '⭐', t: 'Valoraciones', nivel: 2 },\n    { sep: true, nivel: 2 },\n    { id: 'equipo', ic: '🧑‍🤝‍🧑', t: 'Equipo', nivel: 3 },\n    { id: 'ajustes', ic: '⚙️', t: 'Ajustes', nivel: 2 },\n    { id: 'registro', ic: '🗒️', t: 'Registro', nivel: 3 }\n  ];\n  function entrarApp(u) {\n    P.usuario = u;\n    $('pnAcceso').classList.add('oculto'); $('pnApp').classList.remove('oculto');\n    $('pnUNombre').textContent = u.nombre; $('pnURol').textContent = u.rolNombre;\n    pintarMenu({});\n    const h = (location.hash || '').replace('#', '');\n    ir(MENU.some((m) => m.id === h && visible(m)) ? h : (u.rol === 'firmante' ? 'firmar' : 'inicio'));\n  }\n  function visible(m) { return P.usuario && (P.usuario.nivel >= m.nivel || (m.firmante && P.usuario.firmas.length)); }\n  function pintarMenu(cuentas) {\n    $('pnNav').innerHTML = MENU.filter(visible).map((m) => m.sep ? '<div class=\"sep\"></div>' :\n      '<a data-v=\"' + m.id + '\" class=\"' + (P.vista === m.id ? 'activo' : '') + '\"><span class=\"ic\">' + m.ic + '</span>' + m.t +\n      (m.num && cuentas[m.num] ? '<span class=\"num\">' + cuentas[m.num] + '</span>' : '') + '</a>').join('');\n    $('pnNav').querySelectorAll('a[data-v]').forEach((a) => { a.onclick = () => ir(a.dataset.v); });\n  }\n  const VISTAS = { inicio: 'vInicio', actividades: 'vActividades', inscripciones: 'vInscripciones', editor: 'vistaEditor', firmar: 'vFirmar',\n    certificados: 'vCertificados', valoraciones: 'vValoraciones', equipo: 'vEquipo', ajustes: 'vAjustes', registro: 'vRegistro' };\n  async function ir(v, opciones) {\n    P.vista = v;\n    Object.values(VISTAS).forEach((id) => $(id).classList.add('oculto'));\n    $(VISTAS[v]).classList.remove('oculto');\n    $('pnNav').querySelectorAll('a[data-v]').forEach((a) => a.classList.toggle('activo', a.dataset.v === v));\n    try { history.replaceState(null, '', '#' + v); } catch (e) { }\n    try {\n      if (v === 'inicio') await vInicio();\n      if (v === 'actividades') await vActividades();\n      if (v === 'inscripciones') await vInscripciones(opciones);\n      if (v === 'editor') await window.abrirEditor(opciones && opciones.act, opciones && opciones.tab);\n      if (v === 'firmar') await vFirmar();\n      if (v === 'certificados') await vCertificados(opciones);\n      if (v === 'valoraciones') await vValoraciones();\n      if (v === 'equipo') await vEquipo();\n      if (v === 'ajustes') await vAjustes();\n      if (v === 'registro') await vRegistro();\n    } catch (e) { aviso('Error: ' + e.message); }\n    if (v !== 'inicio') llamar('api_resumen').then(pintarMenu).catch(() => { });   // contadores del menú al día\n  }\n  async function actividades() { P.actividades = await llamar('api_actividades'); return P.actividades; }\n  function cab(titulo, acciones, lead) {\n    return '<div class=\"pn-titulo\"><h2>' + titulo + '</h2><div class=\"acciones\">' + (acciones || '') + '</div></div>' + (lead ? '<p class=\"pn-lead\">' + lead + '</p>' : '');\n  }\n  function chip(estado, extra) { return '<span class=\"chipe e-' + estado + '\">' + (ESTADOS[estado] || estado) + (extra ? ' · ' + esc(extra) : '') + '</span>'; }\n\n  // ─────────── INICIO ───────────\n  async function vInicio() {\n    const r = await llamar('api_resumen');\n    pintarMenu(r);\n    const u = P.usuario;\n    const saludo = (new Date().getHours() < 14 ? 'Buenos días' : new Date().getHours() < 21 ? 'Buenas tardes' : 'Buenas noches') + ', ' + esc(u.nombre.split(' ')[0]);\n    const avisos = [];\n    if (u.nivel >= 2 && r.firmantes === 0) avisos.push('No hay firmantes configurados. Ve a «Ajustes».');\n    const t = [\n      u.nivel >= 2 ? '<div class=\"dato\" data-ir=\"inscripciones\"><div class=\"n\">' + r.porValidar + '</div><div class=\"t\">Inscripciones por validar</div></div>' : '',\n      u.nivel >= 2 ? '<div class=\"dato\" data-ir=\"editor\"><div class=\"n\">' + r.porGenerar + '</div><div class=\"t\">Certificados por generar</div></div>' : '',\n      u.firmas.length ? '<div class=\"dato\" data-ir=\"firmar\"><div class=\"n\">' + r.misFirmas + '</div><div class=\"t\">Esperan tu firma</div></div>' : '',\n      u.nivel >= 2 ? '<div class=\"dato\" data-ir=\"certificados\"><div class=\"n\">' + r.enFirma + '</div><div class=\"t\">En proceso de firma</div></div>' : '',\n      u.nivel >= 2 ? '<div class=\"dato\" data-ir=\"certificados\"><div class=\"n\">' + r.enviadosCurso + '</div><div class=\"t\">Enviados en ' + r.curso + '</div></div>' : '',\n      u.nivel >= 2 && r.revisar ? '<div class=\"dato alerta\" data-ir=\"certificados\"><div class=\"n\">' + r.revisar + '</div><div class=\"t\">Para revisar</div></div>' : ''\n    ].join('');\n    $('vInicio').innerHTML = '<div class=\"pn-vista\">' + cab(saludo) +\n      avisos.map((a) => '<div class=\"aviso\">' + a + '</div>').join('') +\n      '<div class=\"tarjetas\">' + t + '</div>' +\n      (u.nivel >= 2 ? '<div class=\"caja\"><h3>Enlace de inscripción para el alumnado</h3>' +\n        '<p class=\"ayuda\" style=\"margin:0 0 10px\">Compártelo en Classroom o proyecta el QR al terminar la actividad. Ahora mismo está abierto para: ' +\n        (r.abiertas.length ? '<b>' + r.abiertas.map(esc).join('</b>, <b>') + '</b>' : '<i>ninguna actividad (ábrelas en «Actividades»)</i>') + '.</p>' +\n        '<div class=\"qr\"><canvas id=\"qrInscripcion\" width=\"132\" height=\"132\"></canvas><div style=\"flex:1\">' +\n        '<div class=\"enlace-copia\"><input type=\"text\" readonly value=\"' + esc(r.urlInscripcion) + '\" id=\"urlIns\"><button class=\"boton\" id=\"copiarIns\">Copiar</button></div>' +\n        '<p class=\"ayuda\">Verificación pública de certificados: <a href=\"' + esc(r.urlVerificacion) + '\" target=\"_blank\">' + esc(r.urlVerificacion) + '</a></p></div></div></div>' : '') +\n      '</div>';\n    $('vInicio').querySelectorAll('[data-ir]').forEach((d) => { d.onclick = () => ir(d.dataset.ir); });\n    if ($('copiarIns')) { $('copiarIns').onclick = () => copiar($('urlIns').value); dibujarQr($('qrInscripcion'), r.urlInscripcion); }\n  }\n  function dibujarQr(canvas, texto) {\n    if (typeof qrcode === 'undefined') return;\n    const q = qrcode(0, 'M'); q.addData(texto); q.make();\n    const n = q.getModuleCount(), x = canvas.getContext('2d'), c = canvas.width / (n + 4);\n    x.fillStyle = '#fff'; x.fillRect(0, 0, canvas.width, canvas.height); x.fillStyle = '#1f2a33';\n    for (let r = 0; r < n; r++) for (let k = 0; k < n; k++) if (q.isDark(r, k)) x.fillRect((k + 2) * c, (r + 2) * c, c + .3, c + .3);\n  }\n  async function copiar(t) {\n    try { await navigator.clipboard.writeText(t); aviso('Copiado.'); }\n    catch (e) { const a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); try { document.execCommand('copy'); aviso('Copiado.'); } catch (x) { } a.remove(); }\n  }\n\n  // ─────────── ACTIVIDADES ───────────\n  async function vActividades() {\n    const acts = await actividades();\n    const filas = acts.map((a) => '<tr>' +\n      '<td><b>' + esc(a.nombre) + '</b><div class=\"ayuda\">' + esc(a.id) + ' · ' + esc(a.tipo || '—') + ' · ' + esc(a.fechas || 'sin fechas') +\n      (a.horas ? ' · ' + a.horas + ' h' : '') + (a.ects ? ' · ' + a.ects + ' ECTS' : '') + '</div></td>' +\n      '<td><label class=\"pn-switch\" title=\"Inscripción abierta\"><input type=\"checkbox\" data-abrir=\"' + a.id + '\"' + (a.abierta ? ' checked' : '') + '><span></span></label></td>' +\n      '<td>' + a.inscritos + (a.pendientes ? ' <span class=\"chipe e-pendiente\">' + a.pendientes + ' por validar</span>' : '') + '</td>' +\n      '<td>' + (a.enviados || 0) + '</td>' +\n      '<td>' + (a.valoracion != null ? '<span class=\"estrellas\">★</span> ' + String(a.valoracion).replace('.', ',') + ' <span class=\"ayuda\">(' + a.nValoraciones + ')</span>' : '<span class=\"ayuda\">—</span>') + '</td>' +\n      '<td class=\"acc\"><button class=\"boton peq\" data-ins=\"' + a.id + '\">Inscripciones</button> <button class=\"boton peq\" data-dis=\"' + a.id + '\">🎨 Diseño</button> ' +\n      '<button class=\"boton peq\" data-edit=\"' + a.id + '\">Editar</button></td></tr>').join('');\n    $('vActividades').innerHTML = '<div class=\"pn-vista\">' + cab('Actividades', '<button class=\"boton primario\" id=\"nuevaAct\">＋ Nueva actividad</button>',\n      'El interruptor abre o cierra la inscripción del alumnado para cada actividad.') +\n      (acts.length ? '<table class=\"tabla\"><thead><tr><th>Actividad</th><th>Inscripción</th><th>Inscritos</th><th>Enviados</th><th>Valoración</th><th></th></tr></thead><tbody>' + filas + '</tbody></table>'\n        : '<div class=\"vacio\">Aún no hay actividades. Crea la primera con «＋ Nueva actividad».</div>') + '</div>';\n    $('nuevaAct').onclick = () => modalActividad({});\n    $('vActividades').querySelectorAll('[data-edit]').forEach((b) => { b.onclick = () => modalActividad(acts.find((a) => a.id === b.dataset.edit)); });\n    $('vActividades').querySelectorAll('[data-ins]').forEach((b) => { b.onclick = () => ir('inscripciones', { act: b.dataset.ins }); });\n    $('vActividades').querySelectorAll('[data-dis]').forEach((b) => { b.onclick = () => ir('editor', { act: b.dataset.dis, tab: 'diseno' }); });\n    $('vActividades').querySelectorAll('[data-abrir]').forEach((c) => {\n      c.onchange = async () => {\n        const a = acts.find((x) => x.id === c.dataset.abrir);\n        try { await llamar('api_guardarActividad', Object.assign({}, a, { abierta: c.checked })); aviso(c.checked ? 'Inscripción abierta.' : 'Inscripción cerrada.'); }\n        catch (e) { c.checked = !c.checked; aviso(e.message); }\n      };\n    });\n  }\n  function modal(html, alAbrir) {\n    const f = document.createElement('div'); f.className = 'modal-fondo';\n    f.innerHTML = '<div class=\"modal\">' + html + '</div>';\n    document.body.appendChild(f);\n    f.onclick = (e) => { if (e.target === f) f.remove(); };\n    const cerrar = () => f.remove();\n    f.querySelectorAll('[data-cerrar]').forEach((b) => { b.onclick = cerrar; });\n    if (alAbrir) alAbrir(f, cerrar);\n    return cerrar;\n  }\n  function modalActividad(a) {\n    const tipos = ['Voluntariado', 'Retiro', 'Jornada', 'Encuentro', 'Celebración', 'Peregrinación', 'Formación', 'Otra'];\n    modal('<h3>' + (a.id ? 'Editar actividad' : 'Nueva actividad') + '</h3>' +\n      '<label>Nombre (tal como saldrá en el certificado)</label><input type=\"text\" id=\"mNombre\" value=\"' + esc(a.nombre || '') + '\">' +\n      '<div class=\"fila2\"><div><label>Tipo</label><select id=\"mTipo\">' + tipos.map((t) => '<option' + (t === a.tipo ? ' selected' : '') + '>' + t + '</option>').join('') + '</select></div>' +\n      '<div><label>Curso</label><input type=\"text\" id=\"mCurso\" value=\"' + esc(a.curso || '') + '\" placeholder=\"2026-27\"></div></div>' +\n      '<label>Fechas (con artículo, como en el certificado)</label><input type=\"text\" id=\"mFechas\" value=\"' + esc(a.fechas || '') + '\" placeholder=\"los días 18 y 19 de marzo de 2027\">' +\n      '<label>Lugar (vacío = en el Centro Universitario de la Sagrada Familia de Úbeda)</label><input type=\"text\" id=\"mLugar\" value=\"' + esc(a.lugar || '') + '\" placeholder=\"en la Casa de Espiritualidad de Úbeda\">' +\n      '<div class=\"fila2\"><div><label>Horas</label><input type=\"number\" min=\"0\" step=\"0.5\" id=\"mHoras\" value=\"' + (a.horas || '') + '\"></div>' +\n      '<div><label>Créditos ECTS</label><input type=\"number\" min=\"0\" step=\"0.5\" id=\"mEcts\" value=\"' + (a.ects || '') + '\"></div></div>' +\n      '<label style=\"display:flex;gap:10px;align-items:center;margin-top:16px\"><span class=\"pn-switch\"><input type=\"checkbox\" id=\"mAbierta\"' + (a.abierta ? ' checked' : '') + '><span></span></span> Inscripción abierta</label>' +\n      '<div class=\"pie\">' + (a.id && !a.inscritos ? '<button class=\"boton peligro\" id=\"mBorrar\" style=\"margin-right:auto\">Borrar</button>' : '') +\n      '<button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"mGuardar\">Guardar</button></div>',\n      (f, cerrar) => {\n        f.querySelector('#mGuardar').onclick = async () => {\n          try {\n            await llamar('api_guardarActividad', { id: a.id, nombre: f.querySelector('#mNombre').value, tipo: f.querySelector('#mTipo').value,\n              curso: f.querySelector('#mCurso').value.trim(), fechas: f.querySelector('#mFechas').value, lugar: f.querySelector('#mLugar').value,\n              horas: f.querySelector('#mHoras').value, ects: f.querySelector('#mEcts').value, abierta: f.querySelector('#mAbierta').checked });\n            cerrar(); aviso('Actividad guardada.'); vActividades();\n          } catch (e) { aviso(e.message); }\n        };\n        const b = f.querySelector('#mBorrar');\n        if (b) b.onclick = async () => { if (!confirm('¿Borrar la actividad?')) return; try { await llamar('api_borrarActividad', a.id); cerrar(); vActividades(); } catch (e) { aviso(e.message); } };\n        f.querySelector('#mNombre').focus();\n      });\n  }\n\n  // ─────────── INSCRIPCIONES ───────────\n  async function vInscripciones(op) {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    if (op && op.act) P.actSel = op.act;\n    if (!P.actSel || !acts.some((a) => a.id === P.actSel)) P.actSel = (acts.find((a) => a.pendientes) || acts[0] || {}).id || '';\n    if (!acts.length) { $('vInscripciones').innerHTML = '<div class=\"pn-vista\">' + cab('Inscripciones') + '<div class=\"vacio\">Primero crea una actividad.</div></div>'; return; }\n    const lista = await llamar('api_inscripciones', P.actSel);\n    const filtro = P.filtroIns || 'todas';\n    const vis = lista.filter((i) => filtro ===