function enviarEmail_(para, asunto, html, adjuntos) {
  const opciones = { htmlBody: html, name: CONFIG.NOMBRE_REMITENTE };
  try { opciones.inlineImages = { logo: Utilities.newBlob(Utilities.base64Decode(LOGO_CORREO_B64), 'image/png', 'logo.png') }; } catch (err) { }
  if (adjuntos) opciones.attachments = adjuntos;
  const texto = html.replace(/<title>[\s\S]*?<\/title>/i, '').replace(/<br\s*\/?>/gi, '\n')
    .replace(/<a [^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi, '$2 ($1)').replace(/<\/(p|div|tr)>/gi, '\n').replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"')
    .replace(/[ \t]+\n/g, '\n').replace(/\n[ \t]*\n[\s]*/g, '\n\n').trim();
  MailApp.sendEmail(para, asunto, texto, opciones);
}
function cuotaCorreo_() { try { return MailApp.getRemainingDailyQuota(); } catch (err) { return 999; } }

// ─────────────────────────────── DATOS (hojas como tablas) ──────────────────
function libroDatos_() { return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('LIBRO_DATOS')); }
function libroBoveda_() { return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('LIBRO_BOVEDA')); }
function hojaDatos_(t) { return libroDatos_().getSheetByName(t); }

function leerDe_(sh, cab) {
  const n = sh.getLastRow() - 1;
  if (n < 1) return [];
  return sh.getRange(2, 1, n, cab.length).getValues().map(function (f, i) {
    const o = { _fila: i + 2 };
    cab.forEach(function (c, j) { o[c] = f[j]; });
    return o;
  }).filter(function (o) { return cab.some(function (c) { return o[c] !== ''; }); });
}
function filaDe_(cab, obj) { return cab.map(function (c) { return obj[c] === undefined ? '' : obj[c]; }); }
function leer_(t) { return leerDe_(hojaDatos_(t), TABLAS[t]); }
function insertar_(t, obj) { const sh = hojaDatos_(t); sh.getRange(sh.getLastRow() + 1, 1, 1, TABLAS[t].length).setValues([filaDe_(TABLAS[t], obj)]); }
function actualizar_(t, fila, cambios) {
  const sh = hojaDatos_(t);
  Object.keys(cambios).forEach(function (c) { const j = TABLAS[t].indexOf(c); if (j > -1) sh.getRange(fila, j + 1).setValue(cambios[c]); });
}
function leerBoveda_(t) { return leerDe_(libroBoveda_().getSheetByName(t), TABLAS_BOVEDA[t]); }
function insertarBoveda_(t, obj) { const sh = libroBoveda_().getSheetByName(t); sh.getRange(sh.getLastRow() + 1, 1, 1, TABLAS_BOVEDA[t].length).setValues([filaDe_(TABLAS_BOVEDA[t], obj)]); }
function actualizarBoveda_(t, fila, cambios) {
  const sh = libroBoveda_().getSheetByName(t);
  Object.keys(cambios).forEach(function (c) { const j = TABLAS_BOVEDA[t].indexOf(c); if (j > -1) sh.getRange(fila, j + 1).setValue(cambios[c]); });
}
function leerPersonas_() {
  const r = {};
  leerBoveda_('Personas').forEach(function (p) {
    r[p.persona] = { id: p.persona, dni: normalizarDni_(p.dni), nombre: String(p.nombre), apellidos: String(p.apellidos), email: String(p.email).trim() };
  });
  return r;
}
function indice_(lista, clave) { const r = {}; lista.forEach(function (x) { r[x[clave]] = x; }); return r; }

function leerAjuste_(clave, porDefecto) {
  const x = leer_('Ajustes').filter(function (a) { return a.clave === clave; })[0];
  if (!x) return porDefecto;
  try { return JSON.parse(x.valor); } catch (err) { return porDefecto; }
}
function guardarAjuste_(clave, valor) {
  const x = leer_('Ajustes').filter(function (a) { return a.clave === clave; })[0];
  if (x) actualizar_('Ajustes', x._fila, { valor: JSON.stringify(valor) }); else insertar_('Ajustes', { clave: clave, valor: JSON.stringify(valor) });
}

function registrar_(usuario, accion, detalle) {
  try { insertar_('Registro', { fecha: new Date(), usuario: usuario || '', accion: accion, detalle: limpiar_(String(detalle || '')) }); }
  catch (err) { Logger.log(accion + ': ' + detalle); }
}

function conCerrojo_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function carpeta_(prop) { return DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty(prop)); }
function enCarpeta_(archivo, prop) {
  const id = PropertiesService.getScriptProperties().getProperty(prop);
  const it = archivo.getParents();
  while (it.hasNext()) if (it.next().getId() === id) return true;
  return false;
}
function obtenerOCrearCarpeta_(padre, nombre) { const it = padre.getFoldersByName(nombre); return it.hasNext() ? it.next() : padre.createFolder(nombre); }

// ─────────────────────────────── UTILIDADES ─────────────────────────────────
function contarFirmas_(blob) { const m = blob.getDataAsString('ISO-8859-1').match(/\/ByteRange\s*\[/g); return m ? m.length : 0; }

function cursoAcademico_(fecha) {
  const d = new Date(fecha);
  const a = d.getMonth() + 1 >= CONFIG.MES_INICIO_CURSO ? d.getFullYear() : d.getFullYear() - 1;
  return a + '-' + String((a + 1) % 100).padStart(2, '0');
}
function normalizarDni_(v) { return String(v || '').toUpperCase().replace(/[\s.\-]/g, ''); }
function normalizarCodigo_(c) { return String(c || '').toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 40); }
function dniValido_(dni) {
  const m = String(dni).match(/^([0-9XYZ])(\d{7})([A-Z])$/);
  if (!m) return false;
  return LETRAS_DNI.charAt(Number(({ X: '0', Y: '1', Z: '2' }[m[1]] || m[1]) + m[2]) % 23) === m[3];
}
function enmascararDni_(d) { d = String(d || ''); return d ? '•••••' + d.slice(-4) : ''; }
function enmascararEmail_(e) { e = String(e || ''); const p = e.split('@'); return p.length === 2 ? p[0].slice(0, 2) + '•••@' + p[1] : ''; }
function bytesAleatorios_() { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, Utilities.getUuid() + Utilities.getUuid() + Date.now()); }
function hexAleatorio_() { return bytesAleatorios_().map(function (b) { return ((b + 256) % 256).toString(16).padStart(2, '0'); }).join(''); }
function huella_(t) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(t), Utilities.Charset.UTF_8)
    .map(function (b) { return ((b + 256) % 256).toString(16).padStart(2, '0'); }).join('');
}
function nuevoCodigo_(curso, usados) {
  const c = String(curso).replace(/^20(\d\d)-(\d\d)$/, '$1$2');
  for (let k = 0; k < 50; k++) {
    const b = bytesAleatorios_();
    let s = '';
    for (let i = 0; i < 6; i++) s += ALFABETO_CODIGO.charAt((b[i] + 256) % ALFABETO_CODIGO.length);
    const codigo = CONFIG.PREFIJO_CODIGO + '-' + c + '-' + s;
    if (!usados[codigo]) return codigo;
  }
  throw new Error('No se pudo generar un código único');
}
/** Código privado de descarga: 8 caracteres sin letras ambiguas (XXXX-XXXX). Solo se guarda su huella. */
function nuevaClave_() {
  const b = bytesAleatorios_();
  let s = '';
  for (let i = 0; i < 8; i++) s += ALFABETO_CODIGO.charAt((b[i] + 256) % ALFABETO_CODIGO.length);
  return s.slice(0, 4) + '-' + s.slice(4);
}
/** Nombre del PDF: código + actividad, sin espacios ni caracteres raros (Autofirma, ZIP y Windows lo agradecen). */
function nombreArchivo_(codigo, actividad) { return codigo + '_' + slug_(actividad).slice(0, 50).replace(/ /g, '-') + '.pdf'; }
function limpiarNombre_(t) { return slug_(t).slice(0, 80) || 'archivo'; }
function capitalizar_(texto) {
  const menores = ['de', 'del', 'la', 'las', 'los', 'y', 'e', 'da', 'van', 'von'];
  return String(texto || '').trim().replace(/\s+/g, ' ').toLowerCase().split(' ').map(function (p, i) {
    if (i > 0 && menores.indexOf(p) > -1) return p;
    return p.split('-').map(function (s) { return s.charAt(0).toUpperCase() + s.slice(1); }).join('-');
  }).join(' ').slice(0, 120);
}
function normalizarTexto_(t) { return String(t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim(); }
function limpiar_(t) { const s = String(t == null ? '' : t).trim().slice(0, 3000); return /^[=+\-@\t\r]/.test(s) ? "'" + s : s; }
function iniciales_(nombre) {
  return String(nombre || '').replace(/^'/, '').split(/\s+/)
    .filter(function (p) { return p && ['de', 'del', 'la', 'las', 'los', 'y'].indexOf(p.toLowerCase()) < 0; })
    .map(function (p) { return p.charAt(0).toUpperCase() + '.'; }).join(' ');
}
const MESES_ = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
function fechaLarga_(f) { const d = new Date(f); return d.getDate() + ' de ' + MESES_[d.getMonth()] + ' de ' + d.getFullYear(); }
function fechaCorta_(d) { return d ? Utilities.formatDate(new Date(d), Session.getScriptTimeZone(), 'dd/MM/yyyy') : ''; }
function slug_(t) { return String(t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^A-Za-z0-9]+/g, ' ').trim(); }
function escRegex_(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
/** Valor listo para escribirse dentro de <script> sin riesgo de romperlo (ni de inyectar HTML). */
function jsSeguro_(v) { return JSON.stringify(v).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029'); }
function esc_(t) { return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

// ─────────────────────────────── FORMULARIOS PROPIOS ────────────────────────
// Cada actividad tiene un formulario de inscripción y otro de evaluación, diseñados en el panel.
// El alumnado los abre en ?p=f&a=A-001 (inscripción) y ?p=e&a=A-001 (evaluación, anónima).

const TIPOS_PREGUNTA = { escala: 'Escala de 1 a 5', unica: 'Una opción', multiple: 'Varias opciones', corto: 'Respuesta corta', largo: 'Respuesta larga' };
const COLOR_FORMULARIO = '#136EA1';

function formularioPorDefecto_(a, tipo) {
  if (tipo === 'evaluacion') {
    return {
      titulo: '¿Cómo lo has vivido?',
      intro: 'Tu opinión sobre «' + a.nombre + '» nos ayuda a preparar mejor las próximas actividades. Es anónima: no te pedimos ningún dato personal.',
      color: COLOR_FORMULARIO,
      preguntas: [
        { id: 'general', tipo: 'escala', texto: 'Valoración general de la actividad', obligatoria: true, clave: 'general' },
        { id: 'crecer', tipo: 'escala', texto: '¿Cuánto te ha ayudado a crecer como persona y como futuro/a docente?' },
        { id: 'recomendar', tipo: 'unica', texto: '¿Se la recomendarías a un compañero o compañera?', opciones: ['Sí', 'Quizá', 'No'] },
        { id: 'llevo', tipo: 'largo', texto: '¿Qué te llevas de esta experiencia?', clave: 'comentario' },
        { id: 'mejora', tipo: 'largo', texto: '¿Qué mejorarías para la próxima vez?', clave: 'mejora' }
      ],
      cierre: '¡Gracias! Tu respuesta es anónima y nos ayuda a mejorar.'
    };
  }
  return {
    titulo: a.nombre,
    intro: 'Regístrate para que podamos expedir tu certificado. Te llegará un correo para confirmar tus datos.',
    color: COLOR_FORMULARIO, preguntas: [],
    cierre: 'Revisa tu correo y confirma el registro. Cuando el certificado esté firmado, te llegará otro correo para descargarlo.'
  };
}

function formularioDe_(a, tipo) {
  const f = jsonDe_(a.formularios, {}) || {};
  return limpiarFormulario_(f[tipo] || formularioPorDefecto_(a, tipo), tipo);
}

function limpiarFormulario_(f, tipo) {
  f = f || {};
  const texto = function (t, n) { return limpiar_(String(t == null ? '' : t).slice(0, n)).replace(/^'/, ''); };
  const def = {
    titulo: texto(f.titulo, 140) || (tipo === 'evaluacion' ? 'Evaluación' : 'Inscripción'),
    intro: texto(f.intro, 1200), cierre: texto(f.cierre, 400),
    color: /^#[0-9a-fA-F]{6}$/.test(f.color || '') ? f.color : COLOR_FORMULARIO,
    preguntas: []
  };
  const ids = {}, claves = {};
  (Array.isArray(f.preguntas) ? f.preguntas : []).slice(0, 20).forEach(function (q, n) {
    if (!q || !TIPOS_PREGUNTA[q.tipo] || !texto(q.texto, 300)) return;
    let id = /^[a-z0-9_]{1,24}$/.test(q.id || '') ? q.id : 'q' + (n + 1);
    while (ids[id]) id = id + '_';
    ids[id] = true;
    const p = { id: id, tipo: q.tipo, texto: texto(q.texto, 300), obligatoria: q.obligatoria === true };
    if (q.ayuda) p.ayuda = texto(q.ayuda, 300);
    if (q.tipo === 'unica' || q.tipo === 'multiple') {
      const op = (Array.isArray(q.opciones) ? q.opciones : String(q.opciones || '').split('\n'))
        .map(function (o) { return texto(o, 120); }).filter(function (o, i, l) { return o && l.indexOf(o) === i; }).slice(0, 12);
      if (op.length < 2) return;
      p.opciones = op;
    }
    const compatible = { general: ['escala'], comentario: ['corto', 'largo'], mejora: ['corto', 'largo'] };
    if (tipo === 'evaluacion' && compatible[q.clave] && compatible[q.clave].indexOf(q.tipo) > -1 && !claves[q.clave]) { p.clave = q.clave; claves[q.clave] = true; }
    def.preguntas.push(p);
  });
  return def;
}

/** Comprueba las respuestas contra el formulario y devuelve solo lo válido. */
function validarRespuestas_(def, r) {
  r = r || {};
  const out = {};
  def.preguntas.forEach(function (q) {
    let v = r[q.id];
    let ok = null;
    if (q.tipo === 'escala') { const n = Math.round(Number(v)); if (n >= 1 && n <= 5) ok = n; }
    else if (q.tipo === 'unica') { if (q.opciones.indexOf(String(v)) > -1) ok = String(v); }
    else if (q.tipo === 'multiple') {
      const l = (Array.isArray(v) ? v : []).map(String).filter(function (x, i, a) { return q.opciones.indexOf(x) > -1 && a.indexOf(x) === i; });
      if (l.length) ok = l;
    } else {
      const t = limpiar_(String(v == null ? '' : v).slice(0, q.tipo === 'corto' ? 200 : 1500));
      if (t) ok = t;
    }
    if (ok === null) { if (q.obligatoria) throw new Error('Falta por responder: «' + q.texto + '».'); return; }
    out[q.id] = ok;
  });
  return out;
}

function api_formularios(token, actId) {
  sesion_(token, NIVEL.coordinacion);
  const a = actividad_(actId);
  if (!a) throw new Error('La actividad no existe.');
  const guardados = jsonDe_(a.formularios, {}) || {};
  const url = urlApp_();
  return {
    actividad: { id: a.id, nombre: a.nombre, fechas: a.fechas, tipo: a.tipo, lugar: a.lugar, contexto: a.contexto || '',
      abierta: a.abierta === true, evaluacion: a.evaluacion === true },
    inscripcion: formularioDe_(a, 'inscripcion'), evaluacion: formularioDe_(a, 'evaluacion'),
    propio: { inscripcion: !!guardados.inscripcion, evaluacion: !!guardados.evaluacion },
    tipos: TIPOS_PREGUNTA, roles: CONFIG.ROLES_ACTIVIDAD, ia: iaConfigurada_(),
    urls: { inscripcion: url + '?p=f&a=' + a.id, evaluacion: url + '?p=e&a=' + a.id }
  };
}

function api_guardarFormulario(token, actId, tipo, def) {
  const u = sesion_(token, NIVEL.coordinacion);
  if (['inscripcion', 'evaluacion'].indexOf(tipo) < 0) throw new Error('Tipo de formulario no válido.');
  return conCerrojo_(function () {
    const a = actividad_(actId);
    if (!a) throw new Error('La actividad no existe.');
    const todos = jsonDe_(a.formularios, {}) || {};
    if (def === null) delete todos[tipo]; else todos[tipo] = limpiarFormulario_(def, tipo);
    const texto = JSON.stringify(todos);
    if (texto.length > 40000) throw new Error('El formulario es demasiado largo.');
    actualizar_('Actividades', a._fila, { formularios: Object.keys(todos).length ? texto : '' });
    registrar_(u.email, def === null ? 'Formulario restablecido' : 'Formulario guardado', actId + ' · ' + tipo);
    return formularioDe_(Object.assign({}, a, { formularios: texto }), tipo);
  });
}

/** Lo que necesita la página pública de un formulario (sin datos de nadie). */
function api_publicoFormulario(tipo, actId) {
  if (!instalado_()) throw new Error('La aplicación aún no está configurada.');
  esquema_();
  if (['inscripcion', 'evaluacion'].indexOf(tipo) < 0) throw new Error('Formulario no válido.');
  const a = actividad_(String(actId || ''));
  if (!a) return { cerrado: true, mensaje: 'No encontramos esta actividad. Revisa el enlace.' };
  const abierto = tipo === 'evaluacion' ? a.evaluacion === true : a.abierta === true;
  const info = { id: a.id, nombre: a.nombre, fechas: a.fechas, tipo: a.tipo, lugar: a.lugar || '' };
  if (!abierto) return { cerrado: true, actividad: info,
    mensaje: tipo === 'evaluacion' ? 'La evaluación de esta actividad no está abierta ahora mismo.' : 'La inscripción de esta actividad está cerrada.' };
  return { actividad: info, formulario: formularioDe_(a, tipo), roles: CONFIG.ROLES_ACTIVIDAD, privacidad: CONFIG.TEXTO_PRIVACIDAD, servicio: CONFIG.NOMBRE_SERVICIO };
}

/** Evaluación anónima: no se guarda nada que identifique a quien responde. */
function api_publicoEvaluar(actId, respuestas, extra) {
  if (!instalado_()) throw new Error('La aplicación aún no está configurada.');
  extra = extra || {};
  if (extra.web) throw new Error('No se ha podido enviar.');
  const a = actividad_(String(actId || ''));
  if (!a || a.evaluacion !== true) throw new Error('La evaluación de esta actividad no está abierta.');
  const def = formularioDe_(a, 'evaluacion');
  const r = validarRespuestas_(def, respuestas);
  if (!Object.keys(r).length) throw new Error('Responde al menos una pregunta.');
  const cache = CacheService.getScriptCache();
  const hora = 'eva_' + Utilities.formatDate(new Date(), 'UTC', 'yyyyMMddHH');
  const n = Number(cache.get(hora) || 0);
  if (n >= CONFIG.MAX_EVALUACIONES_HORA) throw new Error('Ahora mismo hay muchas respuestas. Inténtalo dentro de un rato.');
  cache.put(hora, String(n + 1), 3700);
  const porClave = {};
  def.preguntas.forEach(function (q) { if (q.clave && r[q.id] !== undefined) porClave[q.clave] = r[q.id]; });
  let valor = porClave.general || '';
  if (!valor) {
    const escalas = def.preguntas.filter(function (q) { return q.tipo === 'escala' && r[q.id]; }).map(function (q) { return r[q.id]; });
    if (escalas.length) valor = Math.round(escalas.reduce(function (s, x) { return s + x; }, 0) / escalas.length);
  }
  conCerrojo_(function () {
    insertar_('Valoraciones', { fecha: new Date(), actividad: a.id, valor: valor, comentario: porClave.comentario || '',
      citable: porClave.comentario ? extra.citable === true : false, mejora: porClave.mejora || '', respuestas: JSON.stringify(r), origen: 'evaluación' });
  });
  return { ok: true, cierre: def.cierre || '¡Gracias por tu respuesta!' };
}

// ─────────────────────────────── HOJAS DE CÁLCULO DE DRIVE ──────────────────
// Importar las respuestas de un formulario (Google Forms u otro) guardadas en una hoja de Drive,
// una vez o enlazada: la tarea automática trae las filas nuevas cada hora.
// Los DNI y correos van directos a la bóveda; en «Datos» solo queda una huella con sal secreta.

const CAMPOS_HOJA = {
  nombreCompleto: 'Nombre y apellidos (en una columna)', nombre: 'Nombre', apellidos: 'Apellidos', dni: 'DNI/NIE', email: 'Correo',
  rol: 'Rol o forma de participar', actividad: 'Actividad (si el formulario sirve para varias)', valor: 'Valoración (1 a 5)',
  comentario: 'Comentario u opinión'
};

function idDeHoja_(url) {
  const t = String(url || '').trim();
  const m = t.match(/\/d\/([a-zA-Z0-9_-]{20,})/) || t.match(/^([a-zA-Z0-9_-]{25,})$/);
  if (!m) throw new Error('Pega la dirección completa de la hoja de cálculo (https://docs.google.com/spreadsheets/d/…).');
  return m[1];
}
function abrirHoja_(id) {
  try { return SpreadsheetApp.openById(id); }
  catch (err) {
    const prop = PropertiesService.getScriptProperties().getProperty('PROPIETARIO');
    throw new Error('No puedo abrir esa hoja. Compártela (como lector) con la cuenta propietaria de la app (' + enmascararEmail_(prop) + ').');
  }
}
function valoresHoja_(sh) {
  const nf = sh.getLastRow(), nc = sh.getLastColumn();
  if (nf < 1 || nc < 1) return [];
  return sh.getRange(1, 1, nf, nc).getValues();
}
function huellaSecreta_(t) {
  const props = PropertiesService.getScriptProperties();
  let sal = props.getProperty('SAL_HUELLAS');
  if (!sal) { sal = hexAleatorio_(); props.setProperty('SAL_HUELLAS', sal); }
  return huella_(sal + '|' + t);
}

function sugerirColumnas_(cabeceras) {
  const n = cabeceras.map(function (c) { return normalizarTexto_(c); });
  const r = {};
  const usar = function (campo, re, excluir) {
    for (let i = 0; i < n.length; i++) {
      if (Object.keys(r).some(function (k) { return r[k] === i; })) continue;
      if (re.test(n[i]) && !(excluir && excluir.test(n[i]))) { r[campo] = i; return; }
    }
  };
  usar('dni', /\b(dni|nie|documento|pasaporte)\b/);
  usar('email', /(correo|e-?mail|mail)/);
  usar('nombreCompleto', /nombre (y|completo)|nombre y apellidos|apellidos y nombre/);
  usar('apellidos', /apellido/);
  usar('nombre', /nombre/, /apellido|actividad|centro|tutor/);
  usar('rol', /\b(rol|papel|funcion)\b|particip(aste|as|o|acion)? como|como particip/);
  usar('valor', /(valora|puntua|satisfac|del 1 al 5|de 1 a 5)/);
  usar('comentario', /(coment|opinion|sugerencia|observac|que te llevas)/);
  usar('actividad', /(actividad|evento|jornada|retiro|voluntariado)/);
  if (r.nombreCompleto !== undefined && r.nombre !== undefined && r.apellidos === undefined) delete r.nombre;
  if (r.nombreCompleto !== undefined && r.nombre !== undefined && r.apellidos !== undefined) delete r.nombreCompleto;
  return r;
}
function enmascararCelda_(v) {
  const s = String(v == null ? '' : v instanceof Date ? fechaCorta_(v) : v).trim();
  if (/^[^@\s]+@[^@\s]+$/.test(s)) return enmascararEmail_(s);
  if (/^[0-9XYZxyz][\d.\s-]{6,10}[A-Za-z]$/.test(s)) return enmascararDni_(normalizarDni_(s));
  return s.length > 40 ? s.slice(0, 38) + '…' : s;
}
function rolDeTexto_(t) {
  const s = normalizarTexto_(t);
  if (!s) return '';
  if (/coordin/.test(s)) return 'Coordinación';
  if (/organiz|monitor|voluntari[oa] organiz|equipo/.test(s)) return 'Organización';
  return 'Participante';
}

/** Abre una hoja y propone qué columna es cada dato. Los ejemplos van enmascarados. */
function api_hojaAbrir(token, url, nombreHoja) {
  sesion_(token, NIVEL.coordinacion);
  const id = idDeHoja_(url);
  const ss = abrirHoja_(id);
  const hojas = ss.getSheets().map(function (s) { return s.getName(); });
  const sh = (nombreHoja && ss.getSheetByName(nombreHoja)) || ss.getSheets().filter(function (s) { return s.getLastRow() > 0; })[0] || ss.getSheets()[0];
  const v = valoresHoja_(sh);
  const cabeceras = (v[0] || []).map(function (c) { return String(c).trim(); });
  const filas = v.slice(1).filter(function (f) { return f.some(function (x) { return x !== '' && x != null; }); });
  return { id: id, nombre: ss.getName(), hojas: hojas, hoja: sh.getName(), cabeceras: cabeceras,
    ejemplos: filas.slice(0, 3).map(function (f) { return f.map(enmascararCelda_); }), filas: filas.length,
    sugerencia: sugerirColumnas_(cabeceras), campos: CAMPOS_HOJA, roles: CONFIG.ROLES_ACTIVIDAD };
}

function limpiarCfgHoja_(cfg, cabeceras) {
  cfg = cfg || {};
  const col = {};
  Object.keys(CAMPOS_HOJA).forEach(function (k) {
    const n = Number(cfg.columnas && cfg.columnas[k]);
    if (cfg.columnas && cfg.columnas[k] !== '' && cfg.columnas[k] !== null && n >= 0 && n < (cabeceras ? cabeceras.length : 200)) col[k] = Math.floor(n);
  });
  if (col.dni === undefined) throw new Error('Indica qué columna tiene el DNI/NIE.');
  if (col.nombreCompleto === undefined && (col.nombre === undefined || col.apellidos === undefined)) throw new Error('Indica las columnas del nombre y los apellidos (o la de «nombre y apellidos»).');
  if (cfg.consentimiento !== true) throw new Error('Confirma que el formulario recoge el consentimiento del alumnado (RGPD 6.1.a y 9.2.a).');
  return { id: String(cfg.id || ''), hoja: String(cfg.hoja || ''), columnas: col,
    rol: CONFIG.ROLES_ACTIVIDAD.indexOf(cfg.rol) > -1 ? cfg.rol : 'Participante', filtro: limpiar_(String(cfg.filtro || '').slice(0, 120)),
    consentimiento: true };
}

/** Importa (y opcionalmente deja enlazada) una hoja en una actividad. */
function api_hojaImportar(token, actId, cfg, enlazar) {
  const u = sesion_(token, NIVEL.coordinacion);
  const a = actividad_(actId);
  if (!a) throw new Error('La actividad no existe.');
  const ss = abrirHoja_(String(cfg && cfg.id || ''));
  const sh = ss.getSheetByName(String(cfg.hoja || '')) || ss.getSheets()[0];
  const limpia = limpiarCfgHoja_(Object.assign({}, cfg, { hoja: sh.getName() }), (valoresHoja_(sh)[0] || []));
  const r = conCerrojo_(function () { return importarHoja_(a, limpia, u.email); });
  if (enlazar) {
    conCerrojo_(function () {
      const x = actividad_(actId);
      actualizar_('Actividades', x._fila, { enlace: JSON.stringify(Object.assign({}, limpia, { nombre: ss.getName(), ultima: new Date(), total: r.nuevas })) });
    });
    asegurarDisparadores_();
    registrar_(u.email, 'Hoja enlazada', actId + ' · ' + ss.getName());
  }
  return r;
}

function api_hojaSincronizar(token, actId) {
  const u = sesion_(token, NIVEL.coordinacion);
  const a = actividad_(actId);
  const enl = a && jsonDe_(a.enlace, null);
  if (!enl) throw new Error('Esta actividad no tiene ninguna hoja enlazada.');
  return conCerrojo_(function () { return sincronizarUna_(a, enl, u.email); });
}

function api_hojaDesenlazar(token, actId) {
  const u = sesion_(token, NIVEL.coordinacion);
  return conCerrojo_(function () {
    const a = actividad_(actId);
    if (!a) throw new Error('La actividad no existe.');
    actualizar_('Actividades', a._fila, { enlace: '' });
    registrar_(u.email, 'Hoja desenlazada', actId);
    return true;
  });
}

/** Debe llamarse con el cerrojo puesto. */
function sincronizarUna_(a, enl, quien) {
  const r = importarHoja_(a, enl, quien);
  const x = actividad_(a.id);
  actualizar_('Actividades', x._fila, { enlace: JSON.stringify(Object.assign({}, enl, { ultima: new Date(), total: (Number(enl.total) || 0) + r.nuevas })) });
  return r;
}

/** Trae a la actividad las filas que aún no se habían importado. Debe llamarse con el cerrojo puesto. */
function importarHoja_(a, cfg, quien) {
  const ss = abrirHoja_(cfg.id);
  const sh = ss.getSheetByName(cfg.hoja) || ss.getSheets()[0];
  const v = valoresHoja_(sh);
  const col = cfg.columnas;
  const vale = function (fila, campo) { return col[campo] === undefined ? '' : String(fila[col[campo]] == null ? '' : fila[col[campo]]).trim(); };
  const vistas = {};
  leer_('Importadas').forEach(function (x) { if (x.actividad === a.id) vistas[x.huella] = true; });
  const existentes = leer_('Inscripciones');
  let max = maxReg_(existentes);
  const auto = autoDe_(a);
  const filtro = normalizarTexto_(cfg.filtro || '');
  const r = { nuevas: 0, repetidas: 0, errores: [], total: 0, sinCorreo: 0, valoraciones: 0 };
  const fecha = fechaCorta_(new Date());
  v.slice(1).forEach(function (fila, k) {
    if (!fila.some(function (x) { return x !== '' && x != null; })) return;
    const numFila = k + 2;
    if (filtro && col.actividad !== undefined && normalizarTexto_(vale(fila, 'actividad')).indexOf(filtro) < 0) return;
    r.total++;
    const dni = normalizarDni_(vale(fila, 'dni'));
    const hk = huellaSecreta_(cfg.id + '|' + (dniValido_(dni) ? dni : 'fila' + numFila) + '|' + a.id);
    if (vistas[hk]) { r.repetidas++; return; }
    const marcar = function (res) { vistas[hk] = true; insertar_('Importadas', { huella: hk, actividad: a.id, fecha: new Date(), resultado: res }); };
    let nombre = capitalizar_(vale(fila, 'nombre')), apellidos = capitalizar_(vale(fila, 'apellidos'));
    if (!apellidos) {
      const partes = capitalizar_(vale(fila, 'nombreCompleto') || nombre).split(' ').filter(String);
      nombre = partes[0] || ''; apellidos = partes.slice(1).join(' ');
    }
    if (!nombre || !apellidos) { r.errores.push({ fila: numFila, motivo: 'falta el nombre o los apellidos' }); marcar('error'); return; }
    if (!dniValido_(dni)) { r.errores.push({ fila: numFila, motivo: 'el DNI/NIE no es válido' }); marcar('error'); return; }
    let email = vale(fila, 'email').toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { email = ''; r.sinCorreo++; }
    const persona = guardarPersona_(dni, nombre, apellidos, email, 'Formulario externo «' + limpiar_(ss.getName()).slice(0, 60) + '» · ' + fecha);
    const val = Number(String(vale(fila, 'valor')).replace(',', '.'));
    const valor = val >= 1 && val <= 5 ? Math.round(val) : val > 5 && val <= 10 ? Math.round(val / 2) : '';
    const comentario = limpiar_(vale(fila, 'comentario').slice(0, 1500));
    if (valor || comentario) { insertar_('Valoraciones', { fecha: new Date(), actividad: a.id, valor: valor, comentario: comentario, citable: false, origen: 'hoja' }); r.valoraciones++; }
    if (existentes.some(function (i) { return i.persona === persona.id && i.actividad === a.id; })) { r.repetidas++; marcar('repetida'); return; }
    const notas = [persona.aviso ? 'Aviso: ' + persona.aviso : '', email ? '' : 'Sin correo válido en la hoja'].filter(String).join(' · ');
    const ins = { reg: 'R-' + String(++max).padStart(5, '0'), fecha: new Date(), curso: a.curso || cursoAcademico_(new Date()),
      persona: persona.id, nombre: persona.nombreCompleto, actividad: a.id, rol: rolDeTexto_(vale(fila, 'rol')) || cfg.rol || 'Participante',
      estado: auto.validar && !notas ? 'validada' : 'pendiente', codigo: '', archivo: '', firmas: 0, enviado: '', notas: notas, origen: 'hoja' };
    insertar_('Inscripciones', ins);
    existentes.push(ins);
    marcar('ok');
    r.nuevas++;
  });
  r.errores = r.errores.slice(0, 50);
  registrar_(quien, 'Hoja importada', a.id + ' · ' + r.nuevas + ' nuevas · ' + r.repetidas + ' repetidas · ' + r.errores.length + ' con errores');
  return r;
}

/** Para la tarea automática: todas las actividades enlazadas. */
function sincronizarHojas_() {
  const res = [];
  leer_('Actividades').forEach(function (a) {
    const enl = jsonDe_(a.enlace, null);
    if (!enl) return;
    try { res.push({ id: a.id, r: conCerrojo_(function () { return sincronizarUna_(a, enl, 'automático'); }) }); }
    catch (err) { registrar_('automático', 'Error al sincronizar la hoja', a.id + ' · ' + err.message); }
  });
  return res;
}

// ─────────────────────────────── AUTOMATIZACIÓN ─────────────────────────────
// Cada hora (y al pulsar «Generar en segundo plano») la app:
//   1. trae las filas nuevas de las hojas enlazadas,
//   2. genera en el servidor los certificados de las actividades con «generar» automático,
//   3. los envía a firmar si la actividad lo tiene activado y
//   4. envía al alumnado los ya firmados si también está activado.
// El PDF se crea con el mismo motor que el navegador (pdf-lib + fontkit + motor.js). Las librerías
// se descargan una sola vez de jsDelivr (versión fija), se comprueba su huella SHA-256 y se guardan
// en la carpeta «Motor de PDF» de la cuenta propietaria.

const LIBRERIAS_PDF = [
  { nombre: 'pdf-lib-1.17.1.min.js', sha: '0f9a5cad07941f0826586c94e089d89b918c46e5c17cf2d5a3c6f666e3bc694f',
    urls: ['https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js', 'https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js'] },
  { nombre: 'fontkit-1.1.1.umd.min.js', sha: 'd8df561b9fba98e24f2e5130e40948809281bbbc55a20c412359f1a0a5eb35a6',
    urls: ['https://cdn.jsdelivr.net/npm/@pdf-lib/fontkit@1.1.1/dist/fontkit.umd.min.js', 'https://unpkg.com/@pdf-lib/fontkit@1.1.1/dist/fontkit.umd.min.js'] },
  { nombre: 'qrcode-generator-1.4.4.js', sha: '18ae399f81182bc9de916e9c77b195df20cc58d6f2d55a62b085a299f1bf1780',
    urls: ['https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js', 'https://unpkg.com/qrcode-generator@1.4.4/qrcode.js'] }
];
const SEGUNDOS_TAREA = 270;     // margen bajo el límite de 6 minutos de Apps Script

let MOTOR_SRV_ = null;

function archivoMotor_(nombre) {
  const it = carpeta_('CARPETA_MOTOR').getFilesByName(nombre);
  return it.hasNext() ? it.next() : null;
}
/** Bytes de un recurso del CDN, guardado en Drive tras la primera descarga. Con sha, se comprueba la huella. */
function recursoCdn_(nombre, urls, sha) {
  const f = archivoMotor_(nombre);
  if (f) return f.getBlob().getBytes();
  let ultimo = '';
  for (let k = 0; k < urls.length; k++) {
    try {
      const r = UrlFetchApp.fetch(urls[k], { muteHttpExceptions: true, followRedirects: true });
      if (r.getResponseCode() !== 200) { ultimo = 'HTTP ' + r.getResponseCode(); continue; }
      const bytes = r.getContent();
      if (sha) {
        const h = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes).map(function (b) { return ((b + 256) % 256).toString(16).padStart(2, '0'); }).join('');
        if (h !== sha) { ultimo = 'huella distinta'; continue; }
      }
      carpeta_('CARPETA_MOTOR').createFile(Utilities.newBlob(bytes, 'application/octet-stream', nombre));
      return bytes;
    } catch (err) { ultimo = err.message; }
  }
