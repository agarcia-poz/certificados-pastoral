to) + '</span> <a href=\"#\" class=\"ver\" title=\"Ver DNI\">👁</a></td>' +\n          '<td>' + (editable(i.estado) ? '<select class=\"rol\">' + roles.map((r) => '<option' + (r === i.rol ? ' selected' : '') + '>' + r + '</option>').join('') + '</select>' : esc(i.rol)) + '</td>' +\n          '<td>' + chip(i.estado, i.codigo) + '</td>' +\n          '<td class=\"acc\">' + (editable(i.estado) ? '<button class=\"boton peq corregir\">Corregir datos</button>' : '') + '</td></tr>').join('') + '</tbody></table>'\n        : '<div class=\"vacio\">No hay inscripciones en este filtro.</div>') +\n      '<div class=\"barra-lote oculto\" id=\"lote\"><span id=\"loteN\"></span><span style=\"margin-left:auto\"></span>' +\n      '<button class=\"boton primario\" data-lote=\"validada\">✔ Validar</button><button class=\"boton\" data-lote=\"rechazada\">Rechazar</button><button class=\"boton\" data-lote=\"pendiente\">Volver a pendiente</button></div></div>';\n    const v = $('vInscripciones');\n    $('selAct').onchange = () => { P.actSel = $('selAct').value; vInscripciones(); };\n    v.querySelectorAll('#segFiltro button').forEach((b) => { b.onclick = () => { P.filtroIns = b.dataset.f; vInscripciones(); }; });\n    $('irGenerar').onclick = () => ir('editor', { act: P.actSel, tab: 'generar' });\n    const actualizarLote = () => { const n2 = v.querySelectorAll('.sel:checked').length; $('lote').classList.toggle('oculto', !n2); $('loteN').textContent = n2 + ' seleccionada(s)'; };\n    v.querySelectorAll('.sel').forEach((c) => { c.onchange = actualizarLote; });\n    if ($('selTodas')) $('selTodas').onchange = () => { v.querySelectorAll('.sel').forEach((c) => { c.checked = $('selTodas').checked; }); actualizarLote(); };\n    v.querySelectorAll('[data-lote]').forEach((b) => {\n      b.onclick = async () => {\n        const regs = [...v.querySelectorAll('.sel:checked')].map((c) => c.closest('tr').dataset.reg);\n        try { const k = await llamar('api_cambiarInscripciones', regs, { estado: b.dataset.lote }); aviso(k + ' actualizada(s).'); vInscripciones(); actividades(); }\n        catch (e) { aviso(e.message); }\n      };\n    });\n    v.querySelectorAll('select.rol').forEach((s) => {\n      s.onchange = async () => { try { await llamar('api_cambiarInscripciones', [s.closest('tr').dataset.reg], { rol: s.value }); aviso('Rol cambiado.'); } catch (e) { aviso(e.message); } };\n    });\n    v.querySelectorAll('a.ver').forEach((a) => {\n      a.onclick = async (e) => { e.preventDefault(); const tr = a.closest('tr'); try { tr.querySelector('.dni').textContent = await llamar('api_revelarDni', tr.dataset.reg); a.remove(); } catch (x) { aviso(x.message); } };\n    });\n    v.querySelectorAll('button.corregir').forEach((b) => {\n      b.onclick = () => {\n        const i = lista.find((x) => x.reg === b.closest('tr').dataset.reg);\n        modal('<h3>Corregir datos</h3><p class=\"ayuda\">Los cambios se aplican a todas las inscripciones de esta persona y quedan anotados.</p>' +\n          '<div class=\"fila2\"><div><label>Nombre</label><input type=\"text\" id=\"cNombre\" value=\"' + esc(i.nombre) + '\"></div><div><label>Apellidos</label><input type=\"text\" id=\"cApellidos\" value=\"' + esc(i.apellidos) + '\"></div></div>' +\n          '<label>DNI/NIE (déjalo vacío para no cambiarlo)</label><input type=\"text\" id=\"cDni\" placeholder=\"' + esc(i.dniOculto) + '\">' +\n          '<div class=\"pie\"><button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"cGuardar\">Guardar</button></div>', (f, cerrar) => {\n          f.querySelector('#cGuardar').onclick = async () => {\n            const c = { nombre: f.querySelector('#cNombre').value, apellidos: f.querySelector('#cApellidos').value };\n            if (f.querySelector('#cDni').value.trim()) c.dni = f.querySelector('#cDni').value;\n            try { await llamar('api_corregirPersona', i.persona, c); cerrar(); aviso('Datos corregidos.'); vInscripciones(); } catch (e) { aviso(e.message); }\n          };\n        });\n      };\n    });\n  }\n\n  // ─────────── FIRMAR ───────────\n  async function vFirmar() {\n    const lista = await llamar('api_certificados', { misFirmas: true });\n    const u = P.usuario;\n    $('vFirmar').innerHTML = '<div class=\"pn-vista\">' + cab('Firmar', lista.length ? '<button class=\"boton primario\" id=\"descZip\">⬇ Descargar todos (ZIP)</button><button class=\"boton\" id=\"mailZip\">✉ Enviármelos por correo</button>' : '',\n      'Descarga los certificados, fírmalos con Autofirma (firma visible en tu hueco) y arrástralos aquí. No cambies el nombre de los archivos.') +\n      (!u.firmas.length && u.rol === 'admin' ? '<div class=\"nota\">No figuras como firmante en «Ajustes», pero como administración puedes subir PDF firmados por otra persona.</div>' : '') +\n      '<div class=\"caja\"><h3>' + lista.length + ' certificado(s) esperan tu firma</h3>' +\n      (lista.length ? '<table class=\"tabla\" style=\"border:0\"><tbody>' + lista.map((c) => '<tr><td><b>' + esc(c.nombre) + '</b><div class=\"ayuda\">' + esc(c.actividad) + ' · ' + esc(c.rol) + '</div></td><td>' + esc(c.codigo) + '</td><td>Firma ' + (c.firmas + 1) + ' de ' + c.totalFirmas + '</td></tr>').join('') + '</tbody></table>'\n        : '<p class=\"ayuda\" style=\"margin:0\">Nada pendiente. Te avisaremos por correo cuando haya más.</p>') + '</div>' +\n      '<div class=\"soltar\" id=\"zona\"><b>Arrastra aquí los PDF firmados</b>o pulsa para elegirlos<input type=\"file\" id=\"archivos\" accept=\"application/pdf\" multiple class=\"oculto\"></div>' +\n      '<div id=\"resultados\" style=\"margin-top:14px\"></div></div>';\n    if ($('descZip')) $('descZip').onclick = () => descargarZip(lista);\n    if ($('mailZip')) $('mailZip').onclick = async () => { try { cargando(true, 'Preparando el correo…'); const n = await llamar('api_enviarmeZip'); aviso('Enviado: ' + n + ' PDF en un ZIP a tu correo.'); } catch (e) { aviso(e.message); } finally { cargando(false); } };\n    const zona = $('zona');\n    zona.onclick = () => $('archivos').click();\n    $('archivos').onchange = (e) => subirFirmados([...e.target.files]);\n    zona.ondragover = (e) => { e.preventDefault(); zona.classList.add('encima'); };\n    zona.ondragleave = () => zona.classList.remove('encima');\n    zona.ondrop = (e) => { e.preventDefault(); zona.classList.remove('encima'); subirFirmados([...e.dataTransfer.files].filter((f) => /\\.pdf$/i.test(f.name))); };\n  }\n  async function descargarZip(lista) {\n    try {\n      cargando(true, 'Preparando el ZIP…');\n      const zip = new JSZip();\n      for (let k = 0; k < lista.length; k++) {\n        $('pnCargando').textContent = 'Preparando el ZIP… ' + (k + 1) + ' de ' + lista.length;\n        const r = await llamar('api_pdf', lista[k].codigo);\n        zip.file(r.nombre, r.base64, { base64: true });\n      }\n      const blob = await zip.generateAsync({ type: 'blob' });\n      window.descargarArchivo(blob, 'Certificados para firmar.zip');\n      aviso('Descargado. Si no ves el archivo, usa «Enviármelos por correo».');\n    } catch (e) { aviso(e.message); } finally { cargando(false); }\n  }\n  async function subirFirmados(archivos) {\n    if (!archivos.length) return;\n    const res = $('resultados');\n    res.innerHTML = '<div class=\"caja\"><h3>Subiendo ' + archivos.length + ' archivo(s)…</h3><div id=\"resLista\"></div></div>';\n    let ok = 0;\n    for (const f of archivos) {\n      const linea = document.createElement('div'); linea.className = 'resultado'; linea.textContent = f.name + '…'; $('resLista').appendChild(linea);\n      try {\n        const r = await llamar('api_subirFirmado', f.name, aBase64(await f.arrayBuffer()));\n        if (r.ok) { ok++; linea.className = 'resultado ok'; linea.textContent = r.codigo + (r.enviado ? ' · enviado al alumno/a' : ' · pasa a ' + r.siguiente); }\n        else { linea.className = 'resultado ko'; linea.textContent = f.name + ': ' + r.motivo; }\n      } catch (e) { linea.className = 'resultado ko'; linea.textContent = f.name + ': ' + e.message; }\n    }\n    try { await llamar('api_finSubida'); } catch (e) { }\n    res.querySelector('h3').textContent = 'Hecho: ' + ok + ' de ' + archivos.length + ' correcto(s).';\n    setTimeout(() => vFirmar().then(() => { $('resultados').replaceWith(res); }), 600);\n  }\n\n  // ─────────── CERTIFICADOS ───────────\n  async function vCertificados() {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    const lista = await llamar('api_certificados', { actividad: P.filtroCertAct || '' });\n    const est = P.filtroCertEst || '';\n    const q = (P.buscarCert || '').toLowerCase();\n    const vis = lista.filter((c) => (!est || c.estado === est) && (!q || (c.nombre + ' ' + c.codigo).toLowerCase().indexOf(q) > -1));\n    $('vCertificados').innerHTML = '<div class=\"pn-vista\">' + cab('Certificados', '', 'Todos los certificados emitidos y en qué punto está cada uno.') +\n      '<div class=\"filtros\"><select id=\"fAct\"><option value=\"\">Todas las actividades</option>' + acts.map((a) => '<option value=\"' + a.id + '\"' + (a.id === P.filtroCertAct ? ' selected' : '') + '>' + esc(a.nombre) + '</option>').join('') + '</select>' +\n      '<select id=\"fEst\"><option value=\"\">Todos los estados</option>' + ['generando', 'firma', 'enviado', 'revisar', 'anulado'].map((e) => '<option value=\"' + e + '\"' + (e === est ? ' selected' : '') + '>' + ESTADOS[e] + '</option>').join('') + '</select>' +\n      '<input type=\"text\" id=\"fBuscar\" placeholder=\"Buscar nombre o código\" value=\"' + esc(P.buscarCert || '') + '\"></div>' +\n      (vis.length ? '<table class=\"tabla\"><thead><tr><th>Código</th><th>Persona</th><th>Actividad</th><th>Estado</th><th></th></tr></thead><tbody>' +\n        vis.map((c) => '<tr data-c=\"' + c.codigo + '\"><td><b>' + esc(c.codigo) + '</b></td><td>' + esc(c.nombre) + '<div class=\"ayuda\">' + esc(c.rol) + '</div></td><td>' + esc(c.actividad) + '</td>' +\n          '<td>' + chip(c.estado, c.estado === 'firma' ? (c.firmas + 1) + '/' + c.totalFirmas + ' · ' + c.pendienteDe : c.estado === 'enviado' ? c.enviado : '') + (c.notas ? '<div class=\"ayuda\">' + esc(c.notas) + '</div>' : '') + '</td>' +\n          '<td class=\"acc\">' + (['firma', 'enviado', 'revisar'].indexOf(c.estado) > -1 ? '<button class=\"boton peq\" data-a=\"pdf\">PDF</button> ' : '') +\n          (c.estado === 'enviado' ? '<button class=\"boton peq\" data-a=\"reenviar\">Reenviar</button> ' : '') +\n          (['firma', 'revisar', 'generando'].indexOf(c.estado) > -1 ? '<button class=\"boton peq\" data-a=\"rehacer\">Rehacer</button> ' : '') +\n          (c.estado !== 'anulado' ? '<button class=\"boton peq peligro\" data-a=\"anular\">Anular</button>' : '') + '</td></tr>').join('') + '</tbody></table>'\n        : '<div class=\"vacio\">No hay certificados con este filtro.</div>') + '</div>';\n    $('fAct').onchange = () => { P.filtroCertAct = $('fAct').value; vCertificados(); };\n    $('fEst').onchange = () => { P.filtroCertEst = $('fEst').value; vCertificados(); };\n    let tm; $('fBuscar').oninput = () => { clearTimeout(tm); tm = setTimeout(() => { P.buscarCert = $('fBuscar').value; vCertificados().then(() => { $('fBuscar').focus(); $('fBuscar').setSelectionRange(99, 99); }); }, 350); };\n    $('vCertificados').querySelectorAll('[data-a]').forEach((b) => {\n      b.onclick = async () => {\n        const c = b.closest('tr').dataset.c, a = b.dataset.a;\n        try {\n          if (a === 'pdf') { cargando(true); const r = await llamar('api_pdf', c); window.descargarArchivo(b64aBlob(r.base64, 'application/pdf'), r.nombre); }\n          if (a === 'reenviar' && confirm('¿Reenviar el certificado ' + c + ' por correo?')) { await llamar('api_reenviar', c); aviso('Reenviado.'); }\n          if (a === 'rehacer' && confirm('¿Rehacer ' + c + '? Se retira el PDF actual y vuelve a «Validada» para generarlo de nuevo con otro código.')) { await llamar('api_rehacer', c); vCertificados(); }\n          if (a === 'anular' && confirm('¿Anular ' + c + '? La verificación pública dirá que no es válido.')) { await llamar('api_anular', c); vCertificados(); }\n        } catch (e) { aviso(e.message); } finally { cargando(false); }\n      };\n    });\n  }\n\n  // ─────────── VALORACIONES ───────────\n  async function vValoraciones() {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    const sel = P.actVal || (acts.find((a) => a.nValoraciones) || acts[0] || {}).id || '';\n    const lista = sel ? await llamar('api_valoraciones', sel) : [];\n    const media = lista.length ? lista.reduce((s, v) => s + v.valor, 0) / lista.length : 0;\n    const dist = [5, 4, 3, 2, 1].map((n) => lista.filter((v) => v.valor === n).length);\n    const max = Math.max(1, ...dist);\n    const coment = lista.filter((v) => v.comentario);\n    $('vValoraciones').innerHTML = '<div class=\"pn-vista\">' + cab('Valoraciones', coment.some((v) => v.citable) ? '<button class=\"boton\" id=\"copCit\">Copiar citables para el boletín</button>' : '',\n      'Son anónimas: no se guardan junto al nombre de quien las escribe.') +\n      '<div class=\"filtros\"><select id=\"vSel\">' + acts.map((a) => '<option value=\"' + a.id + '\"' + (a.id === sel ? ' selected' : '') + '>' + esc(a.nombre) + '</option>').join('') + '</select></div>' +\n      (lista.length ? '<div class=\"fila2\"><div class=\"caja\"><h3>Media</h3><div style=\"font-size:40px;font-weight:700;color:var(--verde-osc)\">' + media.toFixed(1).replace('.', ',') + '</div><div class=\"ayuda\">' + lista.length + ' valoración(es) de 1 a 5</div></div>' +\n        '<div class=\"caja barras\"><h3>Reparto</h3>' + dist.map((d, i) => '<div><span style=\"width:24px\">' + (5 - i) + '★</span><i style=\"width:' + Math.round(d / max * 180) + 'px\"></i><span class=\"ayuda\">' + d + '</span></div>').join('') + '</div></div>' +\n        '<div class=\"caja\"><h3>Comentarios (' + coment.length + ')</h3>' + (coment.length ? coment.map((v) => '<div class=\"cita\">' + esc(v.comentario) + '<small>' + '★'.repeat(v.valor) + ' · ' + esc(v.fecha) + (v.citable ? ' · <b>citable en el boletín</b>' : '') + '</small></div>').join('') : '<p class=\"ayuda\">Sin comentarios.</p>') + '</div>'\n        : '<div class=\"vacio\">Aún no hay valoraciones para esta actividad.</div>') + '</div>';\n    $('vSel').onchange = () => { P.actVal = $('vSel').value; vValoraciones(); };\n    if ($('copCit')) $('copCit').onclick = () => copiar(coment.filter((v) => v.citable).map((v) => '«' + v.comentario + '»').join('\\n\\n'));\n  }\n\n  // ─────────── EQUIPO ───────────\n  async function vEquipo() {\n    const lista = await llamar('api_equipo');\n    const roles = { admin: 'Administración', coordinacion: 'Coordinación', firmante: 'Firmante' };\n    $('vEquipo').innerHTML = '<div class=\"pn-vista\">' + cab('Equipo', '<button class=\"boton primario\" id=\"nuevoM\">＋ Añadir persona</button>',\n      'Quién puede entrar y qué puede hacer. Cada persona entra con un código que recibe en su correo.') +\n      '<div class=\"nota\"><b>Administración:</b> todo, incluido el equipo y el registro. <b>Coordinación:</b> actividades, inscripciones, diseño, generación y certificados. <b>Firmante:</b> solo firmar los certificados que le tocan.</div>' +\n      '<table class=\"tabla\"><thead><tr><th>Persona</th><th>Papel</th><th>Activa</th><th></th></tr></thead><tbody>' +\n      lista.map((m) => '<tr data-e=\"' + esc(m.email) + '\"><td><b>' + esc(m.nombre) + '</b><div class=\"ayuda\">' + esc(m.email) + '</div></td><td>' + esc(m.rolNombre) + '</td><td>' + (m.activo ? 'Sí' : 'No') + '</td><td class=\"acc\"><button class=\"boton peq\">Editar</button></td></tr>').join('') +\n      '</tbody></table></div>';\n    const editar = (m) => modal('<h3>' + (m.email ? 'Editar persona' : 'Añadir persona') + '</h3>' +\n      '<label>Correo</label><input type=\"email\" id=\"eEmail\" value=\"' + esc(m.email || '') + '\"' + (m.email ? ' readonly' : '') + '>' +\n      '<label>Nombre</label><input type=\"text\" id=\"eNombre\" value=\"' + esc(m.nombre || '') + '\">' +\n      '<label>Papel</label><select id=\"eRol\">' + Object.keys(roles).map((r) => '<option value=\"' + r + '\"' + (r === (m.rol || 'coordinacion') ? ' selected' : '') + '>' + roles[r] + '</option>').join('') + '</select>' +\n      '<label style=\"display:flex;gap:10px;align-items:center;margin-top:16px\"><span class=\"pn-switch\"><input type=\"checkbox\" id=\"eActivo\"' + (m.activo !== false ? ' checked' : '') + '><span></span></span> Puede entrar</label>' +\n      (m.email ? '' : '<p class=\"ayuda\">Le llegará un correo de bienvenida con el enlace a la aplicación.</p>') +\n      '<div class=\"pie\"><button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"eGuardar\">Guardar</button></div>', (f, cerrar) => {\n      f.querySelector('#eGuardar').onclick = async () => {\n        try { await llamar('api_guardarMiembro', { email: f.querySelector('#eEmail').value, nombre: f.querySelector('#eNombre').value, rol: f.querySelector('#eRol').value, activo: f.querySelector('#eActivo').checked }); cerrar(); aviso('Guardado.'); vEquipo(); }\n        catch (e) { aviso(e.message); }\n      };\n    });\n    $('nuevoM').onclick = () => editar({});\n    $('vEquipo').querySelectorAll('tr[data-e] button').forEach((b) => { b.onclick = () => editar(lista.find((m) => m.email === b.closest('tr').dataset.e)); });\n  }\n\n  // ─────────── AJUSTES ───────────\n  async function vAjustes() {\n    const a = await llamar('api_ajustes');\n    const admin = P.usuario.rol === 'admin';\n    const equipo = admin ? await llamar('api_equipo') : [];\n    const opcionesEmail = (sel) => '<option value=\"\">— sin asignar —</option>' + equipo.filter((m) => m.activo).map((m) => '<option value=\"' + esc(m.email) + '\"' + (m.email === sel ? ' selected' : '') + '>' + esc(m.nombre) + ' · ' + esc(m.email) + '</option>').join('');\n    const filaF = (f, i) => '<div class=\"caja firm\" style=\"padding:14px 16px\"><div class=\"fila3\">' +\n      '<div><label>Firma ' + (i + 1) + ' · cargo</label><input type=\"text\" class=\"fCargo\" value=\"' + esc(f.cargo) + '\"' + (admin ? '' : ' readonly') + '></div>' +\n      '<div><label>Nombre que sale en el certificado</label><input type=\"text\" class=\"fNombre\" value=\"' + esc(f.nombre) + '\"' + (admin ? '' : ' readonly') + '></div>' +\n      '<div><label>Quién firma (persona del equipo)</label>' + (admin ? '<select class=\"fEmail\">' + opcionesEmail(f.email) + '</select>' : '<input type=\"text\" readonly value=\"' + esc(f.email || '—') + '\">') + '</div></div>' +\n      (admin ? '<div style=\"text-align:right;margin-top:6px\"><button class=\"boton peq peligro quitarF\">Quitar</button></div>' : '') + '</div>';\n    $('vAjustes').innerHTML = '<div class=\"pn-vista\">' + cab('Ajustes') +\n      '<h3 style=\"margin:6px 0 10px\">Firmantes, en orden de firma</h3>' +\n      '<p class=\"ayuda\" style=\"margin:-4px 0 12px\">Cada certificado pasa por estas personas en este orden. Quien firma tiene que estar en «Equipo» (con el papel «Firmante» o superior).</p>' +\n      '<div id=\"listaF\">' + a.firmantes.map(filaF).join('') + '</div>' +\n      (admin ? '<div style=\"display:flex;gap:8px\"><button class=\"boton\" id=\"masF\">＋ Añadir firmante</button><button class=\"boton primario\" id=\"guardarF\">Guardar firmantes</button></div>' : '') +\n      '<h3 style=\"margin:28px 0 10px\">Enlaces</h3><div class=\"caja\">' +\n      '<p style=\"margin:0 0 6px\"><b>Panel del equipo:</b> <a href=\"' + esc(a.urlApp) + '\" target=\"_blank\">' + esc(a.urlApp) + '</a></p>' +\n      '<p style=\"margin:0 0 6px\"><b>Inscripción del alumnado:</b> <a href=\"' + esc(a.urlApp) + '?p=inscripcion\" target=\"_blank\">' + esc(a.urlApp) + '?p=inscripcion</a></p>' +\n      '<p style=\"margin:0\"><b>Verificación pública:</b> <a href=\"' + esc(a.urlApp) + '?p=verificar\" target=\"_blank\">' + esc(a.urlApp) + '?p=verificar</a></p></div>' +\n      (admin ? '<h3 style=\"margin:28px 0 10px\">Privacidad · cierre de curso</h3><div class=\"caja\"><p class=\"ayuda\" style=\"margin-top:0\">Sustituye los nombres por iniciales, borra de la bóveda a quien no tenga actividad en cursos posteriores y retira los PDF de ese curso. La verificación sigue funcionando. No se puede deshacer.</p>' +\n        '<div style=\"display:flex;gap:8px;max-width:420px\"><input type=\"text\" id=\"cursoAnon\" placeholder=\"2025-26\"><button class=\"boton peligro\" id=\"anonimizar\">Anonimizar curso</button></div></div>' : '') +\n      '<p class=\"ayuda\" style=\"margin-top:24px\">Versión ' + esc(a.version) + ' · <a href=\"' + esc(a.repo) + '\" target=\"_blank\">código fuente</a></p></div>';\n    if (!admin) return;\n    const enlazarQuitar = () => $('listaF').querySelectorAll('.quitarF').forEach((b) => { b.onclick = () => b.closest('.firm').remove(); });\n    enlazarQuitar();\n    $('masF').onclick = () => { $('listaF').insertAdjacentHTML('beforeend', filaF({ cargo: '', nombre: '', email: '' }, $('listaF').children.length)); enlazarQuitar(); };\n    $('guardarF').onclick = async () => {\n      const lista = [...$('listaF').querySelectorAll('.firm')].map((d) => ({ cargo: d.querySelector('.fCargo').value, nombre: d.querySelector('.fNombre').value, email: d.querySelector('.fEmail').value }));\n      try { await llamar('api_guardarFirmantes', lista); aviso('Firmantes guardados.'); const u = await llamar('api_yo'); P.usuario = u; pintarMenu({}); vAjustes(); } catch (e) { aviso(e.message); }\n    };\n    $('anonimizar').onclick = async () => {\n      const c = $('cursoAnon').value.trim();\n      if (!confirm('¿Anonimizar el curso ' + c + ' y anteriores? No se puede deshacer.')) return;\n      try { aviso(await llamar('api_anonimizar', c)); } catch (e) { aviso(e.message); }\n    };\n  }\n\n  // ─────────── REGISTRO ───────────\n  async function vRegistro() {\n    const lista = await llamar('api_registro', 300);\n    $('vRegistro').innerHTML = '<div class=\"pn-vista\">' + cab('Registro', '', 'Las últimas 300 acciones. No guarda DNI ni correos del alumnado.') +\n      '<table class=\"tabla\"><thead><tr><th>Fecha</th><th>Quién</th><th>Acción</th><th>Detalle</th></tr></thead><tbody>' +\n      lista.map((r) => '<tr><td style=\"white-space:nowrap\">' + esc(r.fecha) + '</td><td>' + esc(r.usuario) + '</td><td><b>' + esc(r.accion) + '</b></td><td class=\"ayuda\">' + esc(r.detalle) + '</td></tr>').join('') +\n      '</tbody></table></div>';\n  }\n\n  arrancar();\n})();\n</script>\n</body>\n</html>\n", "Editor": "<!-- Editor de diseño y generación: vista incrustada en el panel (Panel.html). -->\n<style>\n  :root {\n    --azul: #2e7d4f; --azul-osc: #1f5c39; --azul-claro: #e8f3ec; --texto: #1f2a33; --suave: #5d6b75;\n    --borde: #d9e2e9; --fondo: #f3f6f9; --ok: #0b7a45; --mal: #b3261e; --aviso: #8a5a00;\n  }\n  * { box-sizing: border-box; }\n  #vistaEditor { position: relative; height: 100vh; font-size: 13px; }\n  #vistaEditor .app { display: grid; grid-template-rows: auto 1fr; height: 100vh; }\n  #vistaEditor header { display: flex; align-items: center; gap: 14px; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--borde); }\n  header select { min-width: 360px; }\n  .pestanas { display: flex; gap: 4px; margin-left: auto; }\n  .pestanas button { border: 1px solid var(--borde); background: #fff; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; color: var(--suave); }\n  .pestanas button.activa { background: var(--azul); border-color: var(--azul); color: #fff; }\n  .contador { display: inline-block; min-width: 20px; padding: 0 6px; border-radius: 10px; background: #f2a33a; color: #fff; font-size: 11px; margin-left: 6px; }\n  #vistaEditor main { display: grid; grid-template-columns: 440px 1fr; min-height: 0; }\n  .panel { overflow-y: auto; background: #fff; border-right: 1px solid var(--borde); display: flex; flex-direction: column; }\n  .panel-scroll { flex: 1; overflow-y: auto; padding: 6px 16px 16px; }\n  .panel-pie { border-top: 1px solid var(--borde); padding: 10px 16px; background: #fafcfd; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n  details { border-bottom: 1px solid var(--borde); padding: 10px 0; }\n  summary { font-weight: 700; cursor: pointer; color: var(--azul-osc); font-size: 13.5px; list-style: none; }\n  summary::-webkit-details-marker { display: none; }\n  summary::before { content: '▸ '; color: var(--suave); }\n  details[open] summary::before { content: '▾ '; }\n  label { display: block; font-weight: 600; margin: 10px 0 4px; font-size: 12px; color: var(--suave); }\n  input[type=text], textarea, select { width: 100%; padding: 7px 9px; border: 1px solid var(--borde); border-radius: 6px; font: inherit; color: var(--texto); background: #fff; }\n  textarea { resize: vertical; min-height: 58px; line-height: 1.45; }\n  input:focus, textarea:focus, select:focus { outline: 2px solid #9cc0e4; border-color: var(--azul); }\n  .fila { display: flex; gap: 8px; align-items: center; }\n  .fila > * { flex: 1; }\n  .ayuda { font-size: 11.5px; color: var(--suave); margin-top: 4px; line-height: 1.4; }\n  .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }\n  .chip { border: 1px solid var(--borde); background: var(--azul-claro); color: var(--azul-osc); border-radius: 12px; padding: 2px 8px; font-size: 11px; cursor: pointer; font-family: monospace; }\n  .plantillas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }\n  .plantilla { border: 2px solid var(--borde); border-radius: 8px; padding: 6px 4px 5px; cursor: pointer; text-align: center; font-size: 10.5px; background: #fff; color: var(--suave); }\n  .plantilla.activa { border-color: var(--azul); color: var(--azul-osc); font-weight: 700; }\n  .plantilla canvas { display: block; margin: 0 auto 4px; border: 1px solid #e5ebf0; }\n  .colores { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }\n  .muestra { width: 30px; height: 22px; border-radius: 5px; cursor: pointer; border: 1px solid rgba(0,0,0,.15); position: relative; overflow: hidden; }\n  .muestra span { position: absolute; right: 0; bottom: 0; width: 40%; height: 40%; }\n  input[type=color] { width: 44px; height: 30px; padding: 0; border: 1px solid var(--borde); border-radius: 6px; background: #fff; }\n  .boton { border: 1px solid var(--borde); background: #fff; padding: 7px 12px; border-radius: 7px; font: inherit; font-weight: 600; cursor: pointer; color: var(--texto); }\n  .boton:hover { background: var(--fondo); }\n  .boton.primario { background: var(--azul); border-color: var(--azul); color: #fff; }\n  .boton.primario:hover { background: var(--azul-osc); }\n  .boton.verde { background: var(--ok); border-color: var(--ok); color: #fff; }\n  .boton:disabled { opacity: .5; cursor: default; }\n  .boton.peq { padding: 4px 8px; font-size: 11.5px; }\n  .interruptor { display: flex; align-items: center; gap: 8px; margin: 8px 0; font-weight: 600; color: var(--texto); font-size: 12.5px; }\n  .interruptor input { width: 16px; height: 16px; }\n  .vista { display: flex; flex-direction: column; min-height: 0; }\n  .vista-barra { display: flex; gap: 10px; align-items: center; padding: 10px 16px; background: #fff; border-bottom: 1px solid var(--borde); flex-wrap: wrap; }\n  .vista-barra select { width: auto; min-width: 200px; }\n  .lienzo { flex: 1; overflow: auto; display: flex; justify-content: center; align-items: flex-start; padding: 18px; }\n  .lienzo canvas { box-shadow: 0 6px 24px rgba(20,40,60,.18); background: #fff; }\n  .avisos { font-size: 12px; color: var(--aviso); flex-basis: 100%; min-height: 16px; }\n  .estado-guardado { font-size: 12px; color: var(--suave); margin-left: auto; }\n  .estado-guardado.sin { color: var(--aviso); font-weight: 700; }\n  .ia { background: #f7f3ff; border: 1px solid #e0d6f5; border-radius: 8px; padding: 10px; margin-top: 8px; }\n  .ia h4 { margin: 0 0 4px; font-size: 12.5px; color: #5b2c83; }\n  .ia textarea { min-height: 46px; }\n  .persona { display: grid; grid-template-columns: 22px 1fr 1fr 34px; gap: 5px 6px; align-items: center; padding: 8px 6px; border: 1px solid var(--borde); border-radius: 8px; margin-bottom: 6px; }\n  .persona input[type=text], .persona select { padding: 5px 7px; font-size: 12px; }\n  .persona .sel { grid-row: span 2; width: 16px; height: 16px; }\n  .persona .ver { grid-row: span 2; height: 100%; }\n  .persona.mal input.dni { border-color: var(--mal); background: #fff4f3; }\n  .persona.hecho { opacity: .5; }\n  .persona .aviso-email { grid-column: 2 / span 2; font-size: 11px; color: var(--mal); }\n  .barra-progreso { height: 10px; background: #e5ebf0; border-radius: 6px; overflow: hidden; margin: 10px 0 6px; }\n  .barra-progreso div { height: 100%; width: 0; background: var(--ok); transition: width .2s; }\n  .registro { font-size: 12px; max-height: 160px; overflow: auto; background: var(--fondo); border-radius: 6px; padding: 8px; white-space: pre-wrap; }\n  .vacio { padding: 30px 10px; text-align: center; color: var(--suave); }\n  .cargando { position: absolute; inset: 0; background: rgba(255,255,255,.85); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 10px; z-index: 10; font-weight: 600; color: var(--azul-osc); }\n  .oculto { display: none !important; }\n  .nota { background: var(--azul-claro); border-radius: 8px; padding: 9px 11px; font-size: 12px; line-height: 1.45; margin: 10px 0; }\n  .toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: #1f2a33; color: #fff; padding: 9px 16px; border-radius: 8px; font-size: 12.5px; z-index: 20; }\n</style>\n<section id=\"vistaEditor\" class=\"vista oculto\">\n<div class=\"app\">\n  <header>\n    <strong style=\"color:var(--azul-osc)\">Actividad</strong>\n    <select id=\"actividad\"></select>\n    <span class=\"estado-guardado\" id=\"estadoGuardado\"></span>\n    <div class=\"pestanas\">\n      <button id=\"tabDiseno\" class=\"activa\">🎨 Diseño</button>\n      <button id=\"tabGenerar\">🖨️ Generar <span class=\"contador\" id=\"contador\">0</span></button>\n    </div>\n  </header>\n  <main>\n    <!-- ───────────── PANEL DISEÑO ───────────── -->\n    <section class=\"panel\" id=\"panelDiseno\">\n      <div class=\"panel-scroll\">\n        <details open>\n          <summary>Estilo</summary>\n          <label>Plantilla</label>\n          <div class=\"plantillas\" id=\"plantillas\"></div>\n          <label>Colores</label>\n          <div class=\"fila\" style=\"flex:0\">\n            <div style=\"flex:0\"><input type=\"color\" id=\"color\" title=\"Color principal\"></div>\n            <div style=\"flex:0\"><input type=\"color\" id=\"acento\" title=\"Color de acento\"></div>\n            <div class=\"ayuda\" style=\"flex:1\">Principal (banda, nombre) y acento (filetes).<br>O elige una combinación:</div>\n          </div>\n          <div class=\"colores\" id=\"presets\"></div>\n          <label>Tipografía</label>\n          <select id=\"tipografia\"></select>\n          <div id=\"bloqueBanda\">\n            <label>Texto de la banda lateral</label>\n            <input type=\"text\" id=\"textoBanda\">\n          </div>\n        </details>\n\n        <details>\n          <summary>Fondo, logos y QR</summary>\n          <label>Fondo de página (imagen creada con otra IA, por ejemplo)</label>\n          <div class=\"fila\">\n            <button class=\"boton\" id=\"btnFondo\">📁 Subir fondo…</button>\n            <button class=\"boton\" id=\"btnQuitarFondo\">Quitar fondo</button>\n          </div>\n          <input type=\"file\" id=\"archivoFondo\" accept=\"image/png,image/jpeg,image/webp\" class=\"oculto\">\n          <div class=\"ayuda\">Se recorta y adapta solo a A4 vertical. Consejo: con un fondo propio, la plantilla «Limpio» suele quedar mejor.</div>\n          <label>Velo blanco bajo el texto: <span id=\"veloValor\">0</span> %</label>\n          <input type=\"range\" id=\"velo\" min=\"0\" max=\"90\" step=\"5\" style=\"width:100%\">\n          <div class=\"ia\">\n            <h4>✨ Crear el fondo con IA</h4>\n            <input type=\"text\" id=\"ideaFondo\" placeholder=\"Idea: acuarela suave de olivos y luz de amanecer…\">\n            <div class=\"fila\" style=\"margin-top:6px\"><button class=\"boton peq\" id=\"btnPromptFondo\">Copiar instrucción para la IA</button></div>\n            <textarea id=\"promptFondo\" class=\"oculto\" readonly></textarea>\n          </div>\n          <label class=\"interruptor\"><input type=\"checkbox\" id=\"logoSuperior\"> Logo superior</label>\n          <div class=\"fila\">\n            <button class=\"boton peq\" id=\"btnLogo\">Cambiar logo superior…</button>\n            <button class=\"boton peq\" id=\"btnLogoOriginal\">Volver al logo de Pastoral</button>\n          </div>\n          <input type=\"file\" id=\"archivoLogo\" accept=\"image/png,image/jpeg\" class=\"oculto\">\n          <label class=\"interruptor\"><input type=\"checkbox\" id=\"logosPie\"> Logos SAFA y UJA al pie</label>\n          <label class=\"interruptor\"><input type=\"checkbox\" id=\"qr\"> Código QR de verificación</label>\n        </details>\n\n        <details open>\n          <summary>Textos del certificado</summary>\n          <div class=\"nota\">Escribe <b>**así**</b> para negrita y <i>*así*</i> para cursiva. Los campos entre llaves se rellenan solos: pulsa uno para insertarlo donde está el cursor.\n            <div class=\"chips\" id=\"chips\"></div></div>\n          <label>Rótulo superior (opcional)</label><input type=\"text\" id=\"etiqueta\">\n          <label>Título</label><input type=\"text\" id=\"titulo\">\n          <label>Frase de entrada</label><input type=\"text\" id=\"intro\">\n          <label>Línea del DNI</label><input type=\"text\" id=\"lineaDni\">\n          <label>Párrafo principal</label><textarea id=\"cuerpo\"></textarea>\n          <label>Texto sobre la actividad (cada línea, un párrafo)</label>\n          <textarea id=\"descripcion\" style=\"min-height:120px\" placeholder=\"Pega aquí el texto generado con IA…\"></textarea>\n          <div class=\"ia\">\n            <h4>✨ Texto con IA</h4>\n            <textarea id=\"notasIA\" placeholder=\"Qué se hizo, con quién, objetivos… (cuanto más concreto, mejor texto)\"></textarea>\n            <div class=\"fila\" style=\"margin-top:6px\"><button class=\"boton peq\" id=\"btnPromptTexto\">Copiar instrucción para la IA</button></div>\n            <textarea id=\"promptTexto\" class=\"oculto\" readonly></textarea>\n            <div class=\"ayuda\">Pégala en Claude u otra IA, revisa el resultado y pégalo arriba.</div>\n          </div>\n          <label>Frase de horas (solo si la actividad tiene horas)</label><textarea id=\"textoHoras\"></textarea>\n          <label>Frase de ECTS (solo si la actividad tiene ECTS)</label><textarea id=\"textoEcts\"></textarea>\n          <label>Cierre (opcional, por ejemplo con la fecha)</label>\n          <textarea id=\"cierre\" placeholder=\"Y para que así conste, se expide el presente certificado en Úbeda, a {fecha}.\"></textarea>\n        </details>\n\n        <details>\n          <summary>Frase según el rol</summary>\n          <div class=\"ayuda\">Es lo que sustituye a <code>{verbo}</code>.</div>\n          <div id=\"verbos\"></div>\n        </details>\n\n        <details>\n          <summary>Firmas</summary>\n          <div class=\"ayuda\">Por defecto salen los firmantes de la hoja «Ajustes». Aquí puedes cambiar cómo aparecen en esta actividad (el orden y quién firma no cambian).</div>\n          <div id=\"firmas\"></div>\n          <button class=\"boton peq\" id=\"btnFirmasAjustes\" style=\"margin-top:8px\">Volver a los de «Ajustes»</button>\n        </details>\n      </div>\n      <div class=\"panel-pie\">\n        <button class=\"boton primario\" id=\"btnGuardar\">💾 Guardar diseño</button>\n        <label class=\"interruptor\" style=\"margin:0\"><input type=\"checkbox\" id=\"comoBase\"> usar también como base</label>\n        <button class=\"boton peq\" id=\"btnBase\" title=\"Descarta los cambios no guardados\">Deshacer cambios</button>\n      </div>\n    </section>\n\n    <!-- ───────────── PANEL GENERAR ───────────── -->\n    <section class=\"panel oculto\" id=\"panelGenerar\">\n      <div class=\"panel-scroll\">\n        <div class=\"nota\">Aquí están las personas <b>validadas</b> en «Inscripciones» para esta actividad. Puedes corregir nombre, apellidos, DNI y rol antes de generar: las correcciones se guardan en la bóveda.</div>\n        <div id=\"sinPendientes\" class=\"vacio oculto\">No hay certificados pendientes en esta actividad.<br>Valida a las personas en «Inscripciones».</div>\n        <div id=\"tablaCola\">\n          <label class=\"interruptor\"><input type=\"checkbox\" id=\"todos\" checked> Seleccionar todas</label>\n          <div id=\"listaCola\"></div>\n        </div>\n        <div id=\"progreso\" class=\"oculto\">\n          <div class=\"barra-progreso\"><div id=\"barra\"></div></div>\n          <div id=\"textoProgreso\" class=\"ayuda\"></div>\n          <div class=\"registro\" id=\"registro\"></div>\n        </div>\n      </div>\n      <div class=\"panel-pie\">\n        <button class=\"boton verde\" id=\"btnGenerar\">🖨️ Generar certificados</button>\n        <span class=\"ayuda\">Mantén esta ventana abierta mientras se generan.</span>\n      </div>\n    </section>\n\n    <!-- ───────────── VISTA PREVIA ───────────── -->\n    <section class=\"vista\">\n      <div class=\"vista-barra\">\n        <strong>Vista previa con</strong>\n        <select id=\"verCon\"></select>\n        <select id=\"verRol\"></select>\n        <button class=\"boton peq\" id=\"btnPrueba\">📄 Guardar PDF de prueba</button>\n        <span class=\"avisos\" id=\"avisos\"></span>\n      </div>\n      <div class=\"lienzo\" id=\"lienzo\"><canvas id=\"canvas\"></canvas></div>\n    </section>\n  </main>\n</div>\n<div class=\"cargando\" id=\"cargando\"><div>Cargando el editor…</div><div class=\"ayuda\" id=\"cargandoDetalle\"></div></div>\n<textarea id=\"portapapeles\" style=\"position:fixed;left:-9999px;top:0\"></textarea>\n</section>\n\n<script>\n(function () {\n  'use strict';\n  const $ = (id) => document.getElementById(id);\n  const PRESETS = [\n    ['Verde Pastoral', '#2e7d4f', '#f2c14e'], ['Azul SAFA', '#2a6096', '#f2a33a'], ['Adviento', '#5b2c83', '#c9a227'], ['Navidad', '#a61e2a', '#d4af37'],\n    ['Cuaresma', '#6b3f86', '#a7a9ac'], ['Pascua', '#b8860b', '#2a6096'], ['Ordinario', '#3f8f3a', '#e8d8a8'],\n    ['Solidaridad', '#c0392b', '#2a6096'], ['Voluntariado', '#d35400', '#2a6096'], ['Mar', '#0f6c81', '#9bd0d8'],\n    ['Sobrio', '#33414c', '#b08d57']\n  ];\n  const CAMPOS_TEXTO = ['etiqueta', 'titulo', 'intro', 'lineaDni', 'cuerpo', 'descripcion', 'textoHoras', 'textoEcts', 'cierre', 'textoBanda', 'notasIA'];\n  const CHIPS = ['{nombre}', '{dni}', '{actividad}', '{fechas}', '{lugar}', '{verbo}', '{horas}', '{ects}', '{creditos}', '{rol}', '{curso}', '{fecha}', '{codigo}'];\n\n  const S = {\n    ini: null, act: null, diseno: null, guardado: '', cola: [], fuentes: {}, imgs: {}, ultimoCampo: null,\n    pestana: 'diseno', generando: false\n  };\n\n  // ─────────── servidor ───────────\n  function llamar(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise(function (ok, ko) {\n      google.script.run.withSuccessHandler(ok).withFailureHandler(function (e) { const err = e && e.message ? e : new Error(String(e)); if (/^SESION/.test(err.message) && window.sesionCaducada) window.sesionCaducada(); ko(err); })[fn].apply(null, [window.TOKEN].concat(args));\n    });\n  }\n  function aviso(t) {\n    const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.appendChild(d);\n    setTimeout(() => d.remove(), 3200);\n  }\n  function cargando(si, detalle) { $('cargando').classList.toggle('oculto', !si); $('cargandoDetalle').textContent = detalle || ''; }\n\n  // ─────────── recursos (fuentes e imágenes) ───────────\n  async function fuente(tipo) {\n    if (S.fuentes[tipo]) return S.fuentes[tipo];\n    const bytes = {}, css = {};\n    await Promise.all(Object.keys(Motor.ESTILOS).map(async (estilo) => {\n      try {\n        const r = await fetch(Motor.urlFuente(tipo, estilo));\n        if (!r.ok) throw new Error(r.status);\n        bytes[estilo] = new Uint8Array(await r.arrayBuffer());\n        const nombre = 'CP_' + tipo + '_' + estilo;\n        const ff = new FontFace(nombre, bytes[estilo]);\n        await ff.load(); document.fonts.add(ff); css[estilo] = nombre;\n      } catch (e) { css[estilo] = 'Helvetica'; }\n    }));\n    const medir = await Motor.crearMedidor(PDFLib, window.fontkit, bytes);\n    S.fuentes[tipo] = { bytes, css, medir };\n    return S.fuentes[tipo];\n  }\n\n  function dataUriABytes(uri) {\n    const b64 = uri.split(',')[1], bin = atob(b64), u = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);\n    return u;\n  }\n  function bytesABase64(u8) {\n    let s = ''; const paso = 0x8000;\n    for (let i = 0; i < u8.length; i += paso) s += String.fromCharCode.apply(null, u8.subarray(i, i + paso));\n    return btoa(s);\n  }\n  function imagenDesdeUri(uri) {\n    return new Promise((ok, ko) => { const im = new Image(); im.onload = () => ok(im); im.onerror = ko; im.src = uri; });\n  }\n  async function registrarImagen(clave, uri) {\n    const el = await imagenDesdeUri(uri);\n    S.imgs[clave] = { el, w: el.naturalWidth, h: el.naturalHeight, bytes: dataUriABytes(uri), tipo: uri.indexOf('image/png') > -1 ? 'png' : 'jpg' };\n  }\n  async function imagenDrive(clave, id) {\n    if (!id) { delete S.imgs[clave]; return; }\n    if (S.imgs[clave] && S.imgs[clave].id === id) return;\n    const r = await llamar('api_imagen', id);\n    await registrarImagen(clave, 'data:' + r.mime + ';base64,' + r.base64);\n    S.imgs[clave].id = id;\n  }\n  async function prepararImagenes() {\n    await imagenDrive('fondo', S.diseno.fondoId);\n    await imagenDrive('logoPropio', S.diseno.logoId);\n  }\n  function imagenesPara(d) {\n    const r = {};\n    if (S.imgs.safa) r.safa = S.imgs.safa;\n    if (S.imgs.uja) r.uja = S.imgs.uja;\n    const sup = d.logoId && S.imgs.logoPropio ? S.imgs.logoPropio : S.imgs.pastoral;\n    if (sup) r.pastoral = sup;\n    if (d.fondoId && S.imgs.fondo) r.fondo = S.imgs.fondo;\n    return r;\n  }\n\n  function matrizQr(texto) {\n    if (typeof qrcode === 'undefined') return null;\n    const q = qrcode(0, 'M'); q.addData(texto); q.make();\n    const n = q.getModuleCount(), m = [];\n    for (let r = 0; r < n; r++) { m.push([]); for (let c = 0; c < n; c++) m[r].push(q.isDark(r, c)); }\n    return m;\n  }\n\n  // ─────────── datos para dibujar ───────────\n  function hoyLargo() {\n    const M = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];\n    const d = new Date(); return d.getDate() + ' de ' + M[d.getMonth()] + ' de ' + d.getFullYear();\n  }\n  function datosDe(persona, rol, codigo) {\n    const a = S.act;\n    return {\n      nombre: persona.nombre, apellidos: persona.apellidos, dni: persona.dni,\n      actividad: a.nombre, fechas: a.fechas, lugar: a.lugar || S.ini.lugarPorDefecto, horas: a.horas, ects: a.ects,\n      rol: rol || persona.rol || 'Participante', curso: a.curso, fecha: hoyLargo(),\n      codigo: codigo || 'SAFA-PAS-' + String(a.curso || '').replace(/^20(\\d\\d)-(\\d\\d)$/, '$1$2') + '-XXXXXX',\n      url: S.ini.url || 'https://script.google.com/…/exec', firmantes: S.ini.firmantes\n    };\n  }\n  const EJEMPLO = { nombre: 'María José', apellidos: 'Valero Moro', dni: '12345678Z', rol: 'Participante' };\n\n  function personaVista() {\n    const v = $('verCon').value;\n    if (v === '_ej') return EJEMPLO;\n    const fila = S.cola.find((p) => p.reg === v);\n    return fila ? leerFilaEditada(fila) : EJEMPLO;\n  }\n\n  // ─────────── vista previa ───────────\n  let temporizador = null;\n  function programarVista() { clearTimeout(temporizador); temporizador = setTimeout(dibujarVista, 180); }\n\n  async function dibujarVista() {\n    if (!S.diseno || !S.act) return;\n    const d = Motor.mezclar(S.diseno);\n    const f = await fuente(d.tipografia);\n    const imgs = imagenesPara(d);\n    const per = personaVista();\n    const r = Motor.componer(d, datosDe(per, $('verRol').value), f.medir, imgs, matrizQr);\n    $('avisos').textContent = r.avisos.join(' ');\n    const lienzo = $('lienzo'), canvas = $('canvas');\n    const alto = Math.max(300, lienzo.clientHeight - 36);\n    const escalaVista = alto / Motor.ALTO, dpr = window.devicePixelRatio || 1;\n    canvas.style.height = alto + 'px'; canvas.style.width = (Motor.ANCHO * escalaVista) + 'px';\n    canvas.width = Math.round(Motor.ANCHO * escalaVista * dpr); canvas.height = Math.round(alto * dpr);\n    const els = {}; Object.keys(imgs).forEach((k) => { els[k] = imgs[k].el; });\n    Motor.aCanvas(canvas.getContext('2d'), r.ops, escalaVista * dpr, f.css, els);\n  }\n\n  async function pdfDe(persona, rol, codigo) {\n    const d = Motor.mezclar(S.diseno);\n    const f = await fuente(d.tipografia);\n    const imgs = imagenesPara(d);\n    const r = Motor.componer(d, datosDe(persona, rol, codigo), f.medir, imgs, matrizQr);\n    const bytesImg = {}; Object.keys(imgs).forEach((k) => { bytesImg[k] = { bytes: imgs[k].bytes, tipo: imgs[k].tipo }; });\n    return Motor.aPdf(PDFLib, window.fontkit, r.ops, f.bytes, bytesImg,\n      { titulo: d.titulo + ' · ' + S.act.nombre, asunto: codigo || 'Prueba de diseño' });\n  }\n\n  // ─────────── formulario de diseño ───────────\n  function miniPlantillas() {\n    const cont = $('plantillas'); cont.innerHTML = '';\n    Object.keys(Motor.PLANTILLAS).forEach((k) => {\n      const b = document.createElement('div'); b.className = 'plantilla'; b.dataset.k = k;\n      const c = document.createElement('canvas'); c.width = 54; c.height = 76;\n      b.appendChild(c); b.appendChild(document.createTextNode(Motor.PLANTILLAS[k].split(' (')[0]));\n      b.onclick = () => { S.diseno.plantilla = k; refrescarControles(); cambio(); };\n      cont.appendChild(b);\n    });\n  }\n  function pintarMinis() {\n    document.querySelectorAll('.plantilla').forEach((b) => {\n      b.classList.toggle('activa', b.dataset.k === S.diseno.plantilla);\n      const c = b.querySelector('canvas'), x = c.getContext('2d'), C = S.diseno.color || '#2a6096', A = S.diseno.acento || '#f2a33a';\n      x.fillStyle = '#fff'; x.fillRect(0, 0, 54, 76);\n      const k = b.dataset.k;\n      if (k === 'banda') { x.fillStyle = C; x.fillRect(0, 0, 8, 76); x.fillStyle = A; x.fillRect(8, 0, 1, 76); }\n      if (k === 'marco') { x.strokeStyle = C; x.lineWidth = 1.5; x.strokeRect(3, 3, 48, 70); x.strokeStyle = A; x.lineWidth = .6; x.strokeRect(6, 6, 42, 64); }\n      if (k === 'cabecera') { x.fillStyle = C; x.fillRect(0, 0, 54, 4); x.fillRect(0, 74, 54, 2); x.fillStyle = A; x.fillRect(0, 4, 54, 1); }\n      x.fillStyle = '#c5ced6'; [20, 30, 36, 42, 48].forEach((y, i) => x.fillRect(k === 'banda' ? 14 : 10, y, i === 0 ? 30 : 34, 2));\n      x.fillStyle = C; x.fillRect(18, 25, 20, 2.5);\n    });\n  }\n\n  function refrescarControles() {\n    const d = Motor.mezclar(S.diseno);\n    CAMPOS_TEXTO.forEach((k) => { if (document.activeElement !== $(k)) $(k).value = d[k] || ''; });\n    $('color').value = d.color; $('acento').value = d.acento; $('tipografia').value = d.tipografia;\n    $('velo').value = d.velo; $('veloValor').textContent = d.velo;\n    $('logoSuperior').checked = !!d.logoSuperior; $('logosPie').checked = !!d.logosPie; $('qr').checked = !!d.qr;\n    $('bloqueBanda').classList.toggle('oculto', d.plantilla !== 'banda');\n    $('btnQuitarFondo').disabled = !d.fondoId;\n    $('btnLogoOriginal').disabled = !d.logoId;\n    const vb = $('verbos'); vb.innerHTML = '';\n    S.ini.roles.forEach((rol) => {\n      vb.insertAdjacentHTML('beforeend', '<label>' + rol + '</label>');\n      const i = document.createElement('input'); i.type = 'text'; i.value = d.verbos[rol] || '';\n      i.oninput = () => { S.diseno.verbos = Object.assign({}, Motor.mezclar(S.diseno).verbos, { [rol]: i.value }); cambio(); };\n      vb.appendChild(i);\n    });\n    const fi = $('firmas'); fi.innerHTML = '';\n    const lista = d.firmas && d.firmas.length ? d.firmas : S.ini.firmantes;\n    S.ini.firmantes.forEach((_, n) => {\n      const f = lista[n] || S.ini.firmantes[n];\n      fi.insertAdjacentHTML('beforeend', '<label>Firma ' + (n + 1) + ' · cargo y nombre</label>');\n      const t = document.createElement('textarea'); t.value = f.titulo; t.style.minHeight = '38px';\n      const nom = document.createElement('input'); nom.type = 'text'; nom.value = f.nombre; nom.style.marginTop = '4px';\n      const leer = () => {\n        const actual = (S.diseno.firmas && S.diseno.firmas.length ? S.diseno.firmas : S.ini.firmantes).map((x) => ({ titulo: x.titulo, nombre: x.nombre }));\n        actual[n] = { titulo: t.value, nombre: nom.value };\n        S.diseno.firmas = actual; cambio();\n      };\n      t.oninput = leer; nom.oninput = leer;\n      fi.appendChild(t); fi.appendChild(nom);\n    });\n    pintarMinis();\n  }\n\n  function cambio() { marcarGuardado(); programarVista(); pintarMinis(); }\n  function marcarGuardado() {\n    const sin = JSON.stringify(S.diseno) !== S.guardado;\n    $('estadoGuardado').textContent = sin ? '● Cambios sin guardar' : (S.act && S.act.conDiseno ? '✓ Diseño guardado' : 'Usando el diseño base');\n    $('estadoGuardado').classList.toggle('sin', sin);\n  }\n\n  function enlazarControles() {\n    CAMPOS_TEXTO.forEach((k) => {\n      $(k).addEventListener('input', () => { S.diseno[k] = $(k).value; cambio(); });\n      $(k).addEventListener('focus', () => { S.ultimoCampo = $(k); });\n    });\n    $('color').oninput = () => { S.diseno.color = $('color').value; cambio(); };\n    $('acento').oninput = () => { S.diseno.acento = $('acento').value; cambio(); };\n    $('tipografia').onchange = () => { S.diseno.tipografia = $('tipografia').value; cambio(); };\n    $('velo').oninput = () => { S.diseno.velo = Number($('velo').value); $('veloValor').textContent = $('velo').value; cambio(); };\n    ['logoSuperior', 'logosPie', 'qr'].forEach((k) => { $(k).onchange = () => { S.diseno[k] = $(k).checked; cambio(); }; });\n    $('verCon').onchange = programarVista; $('verRol').onchange = programarVista;\n    window.addEventListener('resize', programarVista);\n\n    const chips = $('chips');\n    CHIPS.forEach((c) => {\n      const b = document.createElement('span'); b.className = 'chip'; b.textContent = c;\n      b.onmousedown = (e) => e.preventDefault();\n      b.onclick = () => {\n        const el = S.ultimoCampo || $('cuerpo');\n        const ini = el.selectionStart || el.value.length, fin = el.selectionEnd || ini;\n        el.value = el.value.slice(0, ini) + c + el.value.slice(fin);\n        el.focus(); el.selectionStart = el.selectionEnd = ini + c.length;\n        el.dispatchEvent(new Event('input'));\n      };\n      chips.appendChild(b);\n    });\n    PRESETS.forEach((p) => {\n      const m = document.createElement('div'); m.className = 'muestra'; m.title = p[0];\n      m.style.background = p[1]; m.innerHTML = '<span style=\"background:' + p[2] + '\"></span>';\n      m.onclick = () => { S.diseno.color = p[1]; S.diseno.acento = p[2]; refrescarControles(); cambio(); };\n      $('presets').appendChild(m);\n    });\n    Object.keys(Motor.TIPOGRAFIAS).forEach((k) => {\n      $('tipografia').insertAdjacentHTML('beforeend', '<option value=\"' + k + '\">' + Motor.TIPOGRAFIAS[k].nombre + '</option>');\n    });\n\n    $('btnFondo').onclick = () => $('archivoFondo').click();\n    $('archivoFondo').onchange = (e) => subirImagen(e.target.files[0], 'fondo');\n    $('btnQuitarFondo').onclick = () => { S.diseno.fondoId = ''; refrescarControles(); cambio(); };\n    $('btnLogo').onclick = () => $('archivoLogo').click();\n    $('archivoLogo').onchange = (e) => subirImagen(e.target.files[0], 'logo');\n    $('btnLogoOriginal').onclick = () => { S.diseno.logoId = ''; refrescarControles(); cambio(); };\n    $('btnFirmasAjustes').onclick = () => { S.diseno.firmas = []; refrescarControles(); cambio(); };\n    $('btnPromptTexto').onclick = () => copiar(promptTexto(), 'promptTexto');\n    $('btnPromptFondo').onclick = () => copiar(promptFondo(), 'promptFondo');\n    $('btnGuardar').onclick = guardar;\n    $('btnBase').onclick = restablecer;\n    $('btnPrueba').onclick = pdfPrueba;\n    $('actividad').onchange = cambiarActividad;\n    $('tabDiseno').onclick = () => pestana('diseno');\n    $('tabGenerar').onclick = () => pestana('generar');\n    $('btnGenerar').onclick = generar;\n    $('todos').onchange = () => document.querySelectorAll('#listaCola input.sel').forEach((c) => { c.checked = $('todos').checked; });\n  }\n\n  // ─────────── imágenes subidas ───────────\n  async function subirImagen(archivo, tipo) {\n    if (!archivo) return;\n    try {\n      cargando(true, 'Preparando la imagen…');\n      const uri = await new Promise((ok, ko) => { const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = ko; r.readAsDataURL(archivo); });\n      const im = await imagenDesdeUri(uri);\n      const c = document.createElement('canvas'), x = c.getContext('2d');\n      let salida, mime;\n      if (tipo === 'fondo') {\n        // Recorte «cubrir» a A4 vertical a 200 ppp\n        c.width = 1654; c.height = 2339;\n        const esc = Math.max(c.width / im.width, c.height / im.height);\n        const w = im.width * esc, h = im.height * esc;\n        x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height);\n        x.drawImage(im, (c.width - w) / 2, (c.height - h) / 2, w, h);\n        mime = 'image/jpeg'; salida = c.toDataURL(mime, 0.86);\n      } else {\n        const esc = Math.min(1, 1100 / im.width);\n        c.width = Math.round(im.width * esc); c.height = Math.round(im.height * esc);\n        x.drawImage(im, 0, 0, c.width, c.height);\n        mime = 'image/png'; salida = c.toDataURL(mime);\n      }\n      cargando(true, 'Subiendo a Drive…');\n      const id = await llamar('api_subirImagen', salida.split(',')[1], mime, (tipo === 'fondo' ? 'Fondo ' : 'Logo ') + S.act.nombre);\n      await registrarImagen(tipo === 'fondo' ? 'fondo' : 'logoPropio', salida);\n      S.imgs[tipo === 'fondo' ? 'fondo' : 'logoPropio'].id = id;\n      if (tipo === 'fondo') { S.diseno.fondoId = id; if (!S.diseno.velo) S.diseno.velo = 0; }\n      else { S.diseno.logoId = id; S.diseno.logoSuperior = true; }\n      refrescarControles(); cambio();\n      aviso(tipo === 'fondo' ? 'Fondo añadido. Recuerda guardar el diseño.' : 'Logo cambiado. Recuerda guardar el diseño.');\n    } catch (e) { alert('No se pudo usar la imagen: ' + e.message); }\n    finally { cargando(false); $('archivoFondo').value = ''; $('archivoLogo').value = ''; }\n  }\n\n  // ─────────── IA ───────────\n  function promptTexto() {\n    const a = S.act, d = Motor.mezclar(S.diseno);\n    const frase = Motor.rellenar(d.cuerpo, datosDe({ nombre: '[nombre]', apellidos: '', dni: '' }, 'Participante'), d).replace(/\\*\\*/g, '');\n    return [\n      'Redacta el texto descriptivo de un certificado oficial del Servicio de Pastoral y Compromiso Solidario del Centro Universitario Sagrada Familia de Úbeda (centro de inspiración ignaciana adscrito a la Universidad de Jaén, que forma a futuros maestros y maestras de Educación Infantil y Primaria).',\n      '',\n      'Actividad: ' + a.nombre + (a.tipo ? ' (' + a.tipo.toLowerCase() + ')' : ''),\n      'Fechas: ' + (a.fechas || '—') + (a.horas ? ' · ' + a.horas + ' horas' : '') + (a.ects ? ' · ' + a.ects + ' ECTS' : ''),\n      'Lugar: ' + (a.lugar || S.ini.lugarPorDefecto),\n      'Qué se hizo y otros detalles: ' + ($('notasIA').value.trim() || '[escribe aquí qué se hizo, con qué entidades, objetivos…]'),\n      '',\n      'El texto irá justo después de esta frase del certificado: «' + frase + '»',\n      '',\n      'Requisitos:',\n      '- Dos párrafos, entre 80 y 130 palabras en total.',\n      '- Tercera persona e impersonal; no nombres a la persona certificada.',\n      '- Tono institucional, sobrio y cálido. Sin adjetivos grandilocuentes.',\n      '- Explica qué se trabajó y su objetivo formativo, y conéctalo con la futura labor docente; menciona la pedagogía ignaciana solo si encaja de forma natural.',\n      '- Sin lenguaje religioso explícito ni datos que yo no te haya dado.',\n      '- Si hay una entidad colaboradora, escríbela entre **dobles asteriscos** para que salga en negrita.',\n      '- Devuelve solo los dos párrafos, separados por un salto de línea, sin título ni comillas.',\n      '',\n      'Ejemplo del estilo buscado:',\n      'En dicho marco se han trabajado, desde la pedagogía ignaciana, la reflexión crítica sobre las desigualdades de género y la coeducación como clave para la construcción de una sociedad más justa, especialmente en el ámbito de la educación infantil y primaria.',\n      'Estas Jornadas han tenido como objetivo ofrecer herramientas concretas a los futuros y futuras docentes para integrar la perspectiva de género en el currículo, promoviendo contextos educativos inclusivos y corresponsables, en colaboración con la **ONG Entreculturas**.'\n    ].join('\\n');\n  }\n  function promptFondo() {\n    const d = Motor.mezclar(S.diseno);\n    return [\n      'Crea una imagen de fondo para un certificado en formato A4 vertical (proporción 1:1,414; idealmente 2480 × 3508 píxeles).',\n      'Idea: ' + ($('ideaFondo').value.trim() || 'decoración sobria y luminosa relacionada con «' + S.act.nombre + '»') + '.',\n      'Paleta: color principal ' + d.color + ' y acento ' + d.acento + ', sobre blanco o crema muy claro.',\n      'MUY IMPORTANTE: deja limpia y muy clara toda la zona central (del 12 % al 88 % del ancho y del 10 % al 90 % del alto), porque ahí irá el texto. Los motivos decorativos, solo en los bordes y esquinas, suaves y con poco contraste.',\n      'Sin texto, letras, números, logotipos, marcos de foto ni personas reconocibles. Estilo elegante, apto para un documento oficial universitario. Sin marcas de agua.'\n    ].join('\\n');\n  }\n  async function copiar(texto, idArea) {\n    const area = $(idArea); area.value = texto; area.classList.remove('oculto'); area.style.minHeight = '120px';\n    try { await navigator.clipboard.writeText(texto); aviso('Instrucción copiada. Pégala en la IA.'); }\n    catch (e) {\n      const p = $('portapapeles'); p.value = texto; p.select();\n      try { document.execCommand('copy'); aviso('Instrucción copiada. Pégala en la IA.'); }\n      catch (e2) { area.select(); aviso('Selecciona el texto y cópialo con Ctrl/Cmd + C.'); }\n    }\n  }\n\n  // ─────────── guardar / cargar ───────────\n  async function guardar() {\n    try {\n      $('btnGuardar').disabled = true;\n      await llamar('api_guardarDiseno', S.act.id, S.diseno, $('comoBase').checked);\n      S.guardado = JSON.stringify(S.diseno); S.act.conDiseno = true;\n      if ($('comoBase').checked) S.ini.hayBase = true;\n      marcarGuardado(); aviso('Diseño guardado.');\n      return true;\n    } catch (e) { alert('No se pudo guardar: ' + e.message); return false; }\n    finally { $('btnGuardar').disabled = false; }\n  }\n  async function restablecer() {\n    if (!confirm(\"¿Descartar los cambios no guardados?\")) return;\n    S.diseno = JSON.parse(JSON.stringify(S.base || {}));\n    await prepararImagenes(); refrescarControles(); cambio();\n  }\n\n  async function cambiarActividad() {\n    if (S.diseno && JSON.stringify(S.diseno) !== S.guardado && !confirm('Hay cambios sin guardar. ¿Cambiar de actividad igualmente?')) {\n      $('actividad').value = S.act.id; return;\n    }\n    await cargarActividad($('actividad').value);\n  }\n\n  async function cargarActividad(id) {\n    cargando(true, 'Cargando la actividad…');\n    try {\n      S.act = S.ini.actividades.find((a) => a.id === id);\n      const [diseno, cola] = await Promise.all([llamar('api_diseno', id), llamar('api_cola', id)]);\n      S.diseno = Object.assign({}, diseno || {}); S.base = diseno || {};\n      S.guardado = JSON.stringify(S.diseno);\n      S.cola = cola || [];\n      await prepararImagenes();\n      refrescarControles(); pintarCola(); opcionesVista(); marcarGuardado();\n      await dibujarVista();\n    } catch (e) { alert('Error al cargar: ' + e.message); }\n    finally { cargando(false); }\n  }\n\n  function opcionesVista() {\n    const v = $('verCon'); const antes = v.value; v.innerHTML = '<option value=\"_ej\">Datos de ejemplo</option>';\n    S.cola.forEach((p) => v.insertAdjacentHTML('beforeend', '<option value=\"' + p.reg + '\">' + esc(p.nombre + ' ' + p.apellidos) + '</option>'));\n    if ([...v.options].some((o) => o.value === antes)) v.value = antes;\n    const r = $('verRol'); const rAntes = r.value; r.innerHTML = '';\n    S.ini.roles.forEach((x) => r.insertAdjacentHTML('beforeend', '<option>' + x + '</option>'));\n    if (rAntes) r.value = rAntes;\n    $('contador').textContent = S.cola.length;\n  }\n\n  function pestana(p) {\n    S.pestana = p;\n    $('tabDiseno').classList.toggle('activa', p === 'diseno'); $('tabGenerar').classList.toggle('activa', p === 'generar');\n    $('panelDiseno').classList.toggle('oculto', p !== 'diseno'); $('panelGenerar').classList.toggle('oculto', p !== 'generar');\n  }\n\n  // ─────────── generar ───────────\n  function esc(t) { return String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c])); }\n  function dniValido(dni) {\n    const m = String(dni).toUpperCase().replace(/[\\s.\\-]/g, '').match(/^([0-9XYZ])(\\d{7})([A-Z])$/);\n    if (!m) return false;\n    const n = Number(({ X: '0', Y: '1', Z: '2' }[m[1]] || m[1]) + m[2]);\n    return 'TRWAGMYFPDXBNJZSQVHLCKE'.charAt(n % 23) === m[3];\n  }\n  function pintarCola() {\n    const tb = $('listaCola'); tb.innerHTML = '';\n    $('sinPendientes').classList.toggle('oculto', S.cola.length > 0);\n    $('tablaCola').classList.toggle('oculto', S.cola.length === 0);\n    $('btnGenerar').disabled = S.cola.length === 0;\n    S.cola.forEach((p) => {\n      const tr = document.createElement('div'); tr.className = 'persona'; tr.dataset.reg = p.reg;\n      tr.innerHTML = '<input type=\"checkbox\" class=\"sel\" checked>' +\n        '<input type=\"text\" class=\"nombre\" value=\"' + esc(p.nombre) + '\" placeholder=\"Nombre\">' +\n        '<input type=\"text\" class=\"apellidos\" value=\"' + esc(p.apellidos) + '\" placeholder=\"Apellidos\">' +\n        '<button class=\"boton peq ver\" title=\"Ver en la vista previa\">👁</button>' +\n        '<input type=\"text\" class=\"dni\" value=\"' + esc(p.dni) + '\" placeholder=\"DNI/NIE\">' +\n        '<select class=\"rol\">' + S.ini.roles.map((r) => '<option' + (r === p.rol ? ' selected' : '') + '>' + r + '</option>').join('') + '</select>' +\n        (p.tieneEmail ? '' : '<div class=\"aviso-email\">⚠️ Sin correo en la bóveda: no se le podrá enviar.</div>');\n      tr.querySelectorAll('input[type=text], select').forEach((el) => el.addEventListener('input', () => {\n        tr.classList.toggle('mal', !dniValido(tr.querySelector('.dni').value));\n        if ($('verCon').value === p.reg) programarVista();\n      }));\n      tr.querySelector('.ver').onclick = () => { $('verCon').value = p.reg; $('verRol').value = tr.querySelector('.rol').value; programarVista(); };\n      tb.appendChild(tr);\n    });\n  }\n  function leerFilaEditada(p) {\n    const tr = document.querySelector('.persona[data-reg=\"' + p.reg + '\"]');\n    if (!tr) return p;\n    return { reg: p.reg, nombre: tr.querySelector('.nombre').value.trim(), apellidos: tr.querySelector('.apellidos').value.trim(),\n      dni: tr.querySelector('.dni').value.toUpperCase().replace(/[\\s.\\-]/g, ''), rol: tr.querySelector('.rol').value };\n  }\n\n  async function generar() {\n    if (S.generando) return;\n    const elegidos = S.cola.filter((p) => { const tr = document.querySelector('.persona[data-reg=\"' + p.reg + '\"]'); return tr && tr.querySelector('.sel').checked; });\n    if (!elegidos.length) { alert('Selecciona al menos una persona.'); return; }\n    const malos = elegidos.filter((p) => !dniValido(leerFilaEditada(p).dni));\n    if (malos.length) { alert('Hay ' + malos.length + ' DNI/NIE no válidos (en rojo). Corrígelos o desmárcalos.'); return; }\n    const avisos = $('avisos').textContent;\n    if (/no cabe/.test(avisos)) { alert('El texto no cabe en una página. Acórtalo antes de generar.'); return; }\n    if (!confirm('Se van a generar ' + elegidos.length + ' certificado(s) de «' + S.act.nombre + '» con el diseño actual.\\n\\n¿Continuar?')) return;\n    if (JSON.stringify(S.diseno) !== S.guardado && !(await guardar())) return;\n\n    S.generando = true; $('btnGenerar').disabled = true;\n    $('progreso').classList.remove('oculto'); $('registro').textContent = '';\n    const log = (t) => { $('registro').textContent += t + '\\n'; $('registro').scrollTop = 1e9; };\n    let hechos = 0, fallos = 0;\n    try {\n      const codigos = await llamar('api_reservar', elegidos.map((p) => p.reg));\n      for (let i = 0; i < elegidos.length; i++) {\n        const orig = elegidos[i], p = leerFilaEditada(orig), codigo = codigos[orig.reg];\n        $('textoProgreso').textContent = 'Generando ' + (i + 1) + ' de ' + elegidos.length + '…';\n        try {\n          if (!codigo) throw new Error('ya no estaba pendiente');\n          const bytes = await pdfDe(p, p.rol, codigo);\n          const cambios = {};\n          if (p.nombre !== orig.nombre) cambios.nombre = p.nombre;\n          if (p.apellidos !== orig.apellidos) cambios.apellidos = p.apellidos;\n          if (p.dni !== orig.dni) cambios.dni = p.dni;\n          if (p.rol !== orig.rol) cambios.rol = p.rol;\n          await llamar('api_guardarPdf', orig.reg, codigo, bytesABase64(bytes), Object.keys(cambios).length ? cambios : null);\n          hechos++; log('✓ ' + p.nombre + ' ' + p.apellidos + ' · ' + codigo);\n          const tr = document.querySelector('.persona[data-reg=\"' + orig.reg + '\"]'); if (tr) tr.classList.add('hecho');\n        } catch (e) { fallos++; log('✗ ' + p.nombre + ' ' + p.apellidos + ': ' + e.message); }\n        $('barra').style.width = Math.round((i + 1) * 100 / elegidos.length) + '%';\n      }\n      await llamar('api_finTanda', hechos);\n      $('textoProgreso').textContent = 'Terminado: ' + hechos + ' generado(s)' + (fallos ? ', ' + fallos + ' con error' : '') +\n        '. Están en la carpeta «Para firmar» del primer firmante, que ya ha recibido el aviso.';\n    } catch (e) { log('✗ ' + e.message); }\n    finally {\n      S.generando = false; $('btnGenerar').disabled = false;\n      S.cola = await llamar('api_cola', S.act.id); S.act.pendientes = S.cola.length;\n      pintarCola(); opcionesVista(); actualizarSelector();\n    }\n  }\n\n  async function pdfPrueba() {\n    try {\n      $('btnPrueba').disabled = true;\n      const per = personaVista();\n      const bytes = await pdfDe(per, $('verRol').value, null);\n      const nombre = 'Prueba ' + S.act.nombre.replace(/[^\\wáéíóúñü ]+/gi, ' ').trim().slice(0, 60) + '.pdf';\n      if (window.descargarArchivo) window.descargarArchivo(new Blob([bytes], { type: 'application/pdf' }), nombre, bytesABase64(bytes));\n      aviso('PDF de prueba descargado.');\n    } catch (e) { alert('No se pudo crear el PDF de prueba: ' + e.message); }\n    finally { $('btnPrueba').disabled = false; }\n  }\n\n  function actualizarSelector() {\n    const s = $('actividad'), v = s.value; s.innerHTML = '';\n    S.ini.actividades.forEach((a) => s.insertAdjacentHTML('beforeend', '<option value=\"' + a.id + '\">' +\n      esc(a.nombre) + (a.pendientes ? '  · ' + a.pendientes + ' pendiente(s)' : '') + (a.conDiseno ? '  · 🎨' : '') + '</option>'));\n    if (v) s.value = v;\n  }\n\n  // ─────────── arranque ───────────\n  async function arrancar(preferida) {\n    try {\n      if (typeof PDFLib === 'undefined') throw new Error('No se han podido cargar las librerías (¿sin conexión?).');\n      cargando(true, 'Preparando logos y tipografías…');\n      await Promise.all([registrarImagen('pastoral', LOGOS.pastoral), registrarImagen('safa', LOGOS.safa), registrarImagen('uja', LOGOS.uja)]);\n      S.ini = await llamar('api_inicioEditor');\n      if (!S.ini.actividades.length) { cargando(true, 'Todavía no hay actividades. Créalas en «Actividades» y vuelve aquí.'); S.ini = null; return; }\n      miniPlantillas(); enlazarControles(); actualizarSelector();\n      const primera = S.ini.actividades.find((a) => a.id === preferida) || S.ini.actividades.find((a) => a.pendientes) || S.ini.actividades[0];\n      $('actividad').value = primera.id;\n      await fuente('opensans');\n      await cargarActividad(primera.id);\n      if (primera.pendientes) pestana('diseno');\n    } catch (e) { cargando(true, 'Error: ' + e.message); }\n  }\n  /** El panel abre el editor en una actividad y pestaña concretas. */\n  window.abrirEditor = async function (actId, tab) {\n    if (!S.ini) { await arrancar(actId); }\n    else {\n      S.ini = await llamar('api_inicioEditor'); actualizarSelector();\n      if (actId && (!S.act || actId !== S.act.id)) { $('actividad').value = actId; await cargarActividad(actId); }\n      else if (S.act) { S.cola = await llamar('api_cola', S.act.id); pintarCola(); opcionesVista(); }\n    }\n    if (tab && S.ini) pestana(tab);\n    programarVista();\n  };\n})();\n</script>\n\n", "Publico": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<base target=\"_top\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<?!= incluir_('Logos') ?>\n<style>\n  :root { --verde: #2e7d4f; --verde-osc: #1f5c39; --verde-claro: #e8f3ec; --oro: #f2c14e; --texto: #1f2a33; --suave: #5d6b75; --borde: #dfe6e2; --mal: #b3261e; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; font-family: \"Open Sans\", Arial, Helvetica, sans-serif; color: var(--texto); background: #f4f6f5; font-size: 15px; }\n  .franja { height: 14px; background: var(--verde); border-bottom: 4px solid var(--oro); }\n  .franja.abajo { height: 10px; border-bottom: 0; border-top: 4px solid var(--oro); margin-top: 40px; }\n  .contenedor { max-width: 680px; margin: 0 auto; padding: 0 16px; }\n  .cabecera { text-align: center; padding: 26px 0 8px; }\n  .cabecera img { width: 220px; max-width: 70%; }\n  .cabecera h1 { font-size: 22px; margin: 10px 0 4px; }\n  .cabecera p { color: var(--suave); margin: 0; }\n  .tarjeta { background: #fff; border-radius: 14px; padding: 22px 22px; margin-top: 18px; box-shadow: 0 4px 18px rgba(20,50,30,.06); }\n  .tarjeta h2 { font-size: 16px; margin: 0 0 4px; }\n  .tarjeta .sub { color: var(--suave); font-size: 13.5px; margin: 0 0 14px; line-height: 1.45; }\n  label { display: block; font-weight: 600; font-size: 13px; color: var(--suave); margin: 12px 0 5px; }\n  input[type=text], input[type=email], textarea { width: 100%; padding: 11px 12px; border: 1px solid var(--borde); border-radius: 8px; font: inherit; color: var(--texto); }\n  input:focus, textarea:focus { outline: 2px solid #a9d3b8; border-color: var(--verde); }\n  .fila2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n  .act { border: 2px solid var(--borde); border-radius: 12px; padding: 14px; margin-bottom: 10px; transition: .15s; }\n  .act.marcada { border-color: var(--verde); background: #fbfdfb; }\n  .act .top { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }\n  .act input[type=checkbox] { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--verde); }\n  .act b { display: block; }\n  .act small { color: var(--suave); }\n  .act .det { margin: 12px 0 0 32px; }\n  .seg { display: inline-flex; border: 1px solid var(--borde); border-radius: 8px; overflow: hidden; flex-wrap: wrap; }\n  .seg button { border: 0; background: #fff; padding: 8px 12px; font: inherit; font-size: 13.5px; cursor: pointer; color: var(--suave); }\n  .seg button.activo { background: var(--verde); color: #fff; font-weight: 600; }\n  .estrellas button { border: 0; background: none; font-size: 26px; cursor: pointer; color: #cfd6d2; padding: 0 2px; }\n  .estrellas button.on { color: #e0a31b; }\n  .check { display: flex; gap: 10px; align-items: flex-start; margin: 12px 0; font-size: 14px; line-height: 1.45; cursor: pointer; }\n  .check input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--verde); flex: none; }\n  details { font-size: 13px; color: var(--suave); line-height: 1.5; margin: 6px 0 4px; }\n  summary { cursor: pointer; color: var(--verde-osc); font-weight: 600; }\n  .boton { display: block; width: 100%; border: 0; background: var(--verde); color: #fff; font: inherit; font-weight: 700; padding: 14px; border-radius: 10px; cursor: pointer; margin-top: 18px; font-size: 16px; }\n  .boton:hover { background: var(--verde-osc); }\n  .boton:disabled { opacity: .6; cursor: default; }\n  .error { background: #fbe9e7; color: var(--mal); padding: 10px 12px; border-radius: 8px; margin-top: 12px; font-size: 14px; }\n  .ok { text-align: center; padding: 10px 0; }\n  .ok .icono { font-size: 46px; }\n  .ok h2 { font-size: 20px; margin: 8px 0; }\n  .ok p { color: var(--suave); line-height: 1.5; }\n  .verif form { display: flex; gap: 8px; }\n  .verif input { text-transform: uppercase; }\n  .verif button { border: 0; background: var(--verde); color: #fff; font-weight: 700; padding: 0 18px; border-radius: 8px; font: inherit; cursor: pointer; }\n  .estado { padding: 14px 16px; border-radius: 10px; margin: 16px 0 10px; font-weight: 700; }\n  .estado.bien { background: var(--verde-claro); color: var(--verde-osc); }\n  .estado.mal { background: #fbe9e7; color: var(--mal); }\n  .estado.medio { background: #fff4dc; color: #7a5200; }\n  table { width: 100%; border-collapse: collapse; }\n  th { text-align: left; color: var(--suave); font-weight: 400; padding: 8px 10px 8px 0; vertical-align: top; width: 120px; font-size: 14px; }\n  td { padding: 8px 0; border-bottom: 1px solid #eef2ef; }\n  .pie { text-align: center; font-size: 12px; color: var(--suave); padding: 18px 16px 0; }\n  .trampa { position: absolute; left: -5000px; }\n  @media (max-width: 520px) { .fila2 { grid-template-columns: 1fr; } .act .det { margin-left: 0; } }\n</style>\n</head>\n<body>\n<div class=\"franja\"></div>\n<div class=\"contenedor\">\n  <div class=\"cabecera\"><img id=\"logo\" alt=\"Pastoral · Centro Universitario Sagrada Familia\"><h1 id=\"titulo\"></h1><p>Servicio de Pastoral y Compromiso Solidario</p></div>\n  <div id=\"contenido\"></div>\n  <div class=\"pie\">Centro Universitario «Sagrada Familia» · Úbeda · Centro adscrito a la Universidad de Jaén</div>\n</div>\n<div class=\"franja abajo\"></div>\n\n<script>\n(function () {\n  'use strict';\n  const TIPO = <?!= tipoJs ?>;\n  const DATOS = <?!= datosJs ?>;\n  const URL_APP = <?!= urlJs ?>;\n  const $ = (id) => document.getElementById(id);\n  const esc = (t) => String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n  $('logo').src = LOGOS.pastoral;\n  const C = $('contenido');\n\n  // ─────────── Registro de participación ───────────\n  if (TIPO === 'inscripcion') {\n    $('titulo').textContent = 'Registro de participación';\n    C.innerHTML = '<div class=\"tarjeta\"><p class=\"sub\" style=\"margin:0\">Cargando las actividades…</p></div>';\n    google.script.run.withSuccessHandler(pintar).withFailureHandler((e) => { C.innerHTML = '<div class=\"tarjeta\"><div class=\"error\">' + esc(e.message) + '</div></div>'; }).api_publicoActividades();\n  }\n\n  function pintar(info) {\n    if (!info.actividades.length) {\n      C.innerHTML = '<div class=\"tarjeta ok\"><div class=\"icono\">🕊️</div><h2>Ahora mismo no hay actividades abiertas</h2><p>Vuelve cuando el equipo de Pastoral te lo indique.</p></div>';\n      return;\n    }\n    const sel = {};\n    C.innerHTML =\n      '<div class=\"tarjeta\"><h2>1. ¿En qué actividades has estado?</h2><p class=\"sub\">Marca cada una e indica cómo participaste. Si quieres, valórala: es anónimo.</p><div id=\"acts\"></div></div>' +\n      '<div class=\"tarjeta\"><h2>2. Tus datos para el certificado</h2><p class=\"sub\">Escríbelos tal como quieres que aparezcan. El certificado te llegará a este correo.</p>' +\n      '<div class=\"fila2\"><div><label for=\"nombre\">Nombre</label><input type=\"text\" id=\"nombre\" autocomplete=\"given-name\"></div><div><label for=\"apellidos\">Apellidos</label><input type=\"text\" id=\"apellidos\" autocomplete=\"family-name\"></div></div>' +\n      '<div class=\"fila2\"><div><label for=\"dni\">DNI / NIE</label><input type=\"text\" id=\"dni\" placeholder=\"12345678Z\" autocomplete=\"off\"></div><div><label for=\"email\">Correo</label><input type=\"email\" id=\"email\" autocomplete=\"email\"></div></div>' +\n      '<input type=\"text\" id=\"web\" class=\"trampa\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\"></div>' +\n      '<div class=\"tarjeta\"><h2>3. ¿Qué te ha aportado? <span style=\"font-weight:400;color:var(--suave)\">(opcional y anónimo)</span></h2>' +\n      '<textarea id=\"comentario\" rows=\"3\" placeholder=\"Una frase, una experiencia, algo que te llevas…\"></textarea>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"citable\"> Podéis citar mi comentario en el boletín de Pastoral, siempre sin mi nombre.</label></div>' +\n      '<div class=\"tarjeta\"><h2>4. Protección de datos</h2>' +\n      '<details><summary>Leer la información sobre protección de datos</summary><p>' + esc(info.privacidad) + '</p></details>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"c1\"> He leído la información sobre protección de datos y acepto el tratamiento de mis datos para gestionar y expedir mi certificado.</label>' +\n      '<label class=\"check\"><input type=\"checkbox\" id=\"c2\"> Consiento expresamente que se trate la información sobre mi participación en actividades del Servicio de Pastoral, que podría revelar convicciones religiosas (art. 9.2.a RGPD).</label>' +\n      '<div id=\"error\" class=\"error\" style=\"display:none\"></div><button class=\"boton\" id=\"enviar\">Enviar registro</button>' +\n      '<p class=\"sub\" style=\"text-align:center;margin:12px 0 0\">Te enviaremos un correo para que confirmes el registro.</p></div>';\n    const acts = $('acts');\n    info.actividades.forEach((a) => {\n      const d = document.createElement('div'); d.className = 'act';\n      d.innerHTML = '<div class=\"top\"><input type=\"checkbox\"><div><b>' + esc(a.nombre) + '</b><small>' + esc([a.tipo, a.fechas].filter(Boolean).join(' · ')) + '</small></div></div>' +\n        '<div class=\"det\" style=\"display:none\"><div class=\"seg\">' + info.roles.map((r, i) => '<button type=\"button\" data-r=\"' + esc(r) + '\" class=\"' + (i === 0 ? 'activo' : '') + '\">' + esc(r) + '</button>').join('') + '</div>' +\n        '<div style=\"margin-top:10px;font-size:13px;color:var(--suave)\">Tu valoración: <span class=\"estrellas\">' + [1, 2, 3, 4, 5].map((n) => '<button type=\"button\" data-v=\"' + n + '\" aria-label=\"' + n + ' de 5\">★</button>').join('') + '</span></div></div>';\n      const caja = d.querySelector('input'), det = d.querySelector('.det');\n      const cambiar = () => { d.classList.toggle('marcada', caja.checked); det.style.display = caja.checked ? '' : 'none'; if (caja.checked) sel[a.id] = sel[a.id] || { id: a.id, rol: info.roles[0], valor: null }; else delete sel[a.id]; };\n      d.querySelector('.top').onclick = (e) => { if (e.target !== caja) caja.checked = !caja.checked; cambiar(); };\n      d.querySelectorAll('.seg button').forEach((b) => { b.onclick = () => { d.querySelectorAll('.seg button').forEach((x) => x.classList.remove('activo')); b.classList.add('activo'); sel[a.id].rol = b.dataset.r; }; });\n      d.querySelectorAll('.estrellas button').forEach((b) => { b.onclick = () => { const v = Number(b.dataset.v); sel[a.id].valor = v; d.querySelectorAll('.estrellas button').forEach((x) => x.classList.toggle('on', Number(x.dataset.v) <= v)); }; });\n      acts.appendChild(d);\n    });\n    $('enviar').onclick = () => {\n      const err = (t) => { $('error').textContent = t; $('error').style.display = t ? '' : 'none'; };\n      err('');\n      const datos = { nombre: $('nombre').value, apellidos: $('apellidos').value, dni: $('dni').value, email: $('email').value,\n        actividades: Object.values(sel), comentario: $('comentario').value, citable: $('citable').checked,\n        consentimiento: $('c1').checked, consentimiento9: $('c2').checked, web: $('web').value };\n      if (!datos.actividades.length) return err('Marca al menos una actividad.');\n      if (!datos.nombre.trim() || !datos.apellidos.trim()) return err('Escribe tu nombre y apellidos.');\n      if (!dniValido(datos.dni)) return err('El DNI/NIE no es válido: revisa el número y la letra.');\n      if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(datos.email.trim())) return err('Escribe un correo válido.');\n      if (!datos.consentimiento || !datos.consentimiento9) return err('Necesitamos tus dos consentimientos para expedir el certificado.');\n      $('enviar').disabled = true; $('enviar').textContent = 'Enviando…';\n      google.script.run.withSuccessHandler((r) => {\n        C.innerHTML = '<div class=\"tarjeta ok\"><div class=\"icono\">📬</div><h2>Revisa tu correo</h2><p>Te hemos enviado un mensaje a <b>' + esc(r.email) +\n          '</b>. Pulsa el botón «Confirmar mi registro» para que sea válido.<br>Si no lo ves, mira en el correo no deseado.</p></div>';\n        window.scrollTo(0, 0);\n      }).withFailureHandler((e) => { err(e.message); $('enviar').disabled = false; $('enviar').textContent = 'Enviar registro'; }).api_publicoInscribir(datos);\n    };\n  }\n  function dniValido(d) {\n    const m = String(d).toUpperCase().replace(/[\\s.\\-]/g, '').match(/^([0-9XYZ])(\\d{7})([A-Z])$/);\n    if (!m) return false;\n    return 'TRWAGMYFPDXBNJZSQVHLCKE'.charAt(Number(({ X: '0', Y: '1', Z: '2' }[m[1]] || m[1]) + m[2]) % 23) === m[3];\n  }\n\n  // ─────────── Confirmación ───────────\n  if (TIPO === 'confirmar') {\n    $('titulo').textContent = 'Registro de participación';\n    C.innerHTML = DATOS.ok\n      ? '<div class=\"tarjeta ok\"><div class=\"icono\">✅</div><h2>¡Gracias, ' + esc(DATOS.nombre) + '!</h2><p>Tu registro está confirmado:</p><p><b>' +\n        DATOS.actividades.map(esc).join('</b><br><b>') + '</b></p><p>Cuando el equipo de Pastoral lo revise y el certificado esté firmado, te llegará por correo.</p></div>'\n      : '<div class=\"tarjeta ok\"><div class=\"icono\">⚠️</div><h2>No se ha podido confirmar</h2><p>' + esc(DATOS.mensaje) + '</p><p><a href=\"' + esc(URL_APP) + '?p=inscripcion\">Volver al registro</a></p></div>';\n  }\n\n  // ─────────── Verificación ───────────\n  if (TIPO === 'verificar') {\n    $('titulo').textContent = 'Verificación de certificados';\n    const r = DATOS.r;\n    let res = '';\n    if (r && r.estado === 'ok') {\n      res = '<div class=\"estado bien\">✅ Certificado auténtico</div><table>' +\n        '<tr><th>Código</th><td>' + esc(r.codigo) + '</td></tr><tr><th>Titular</th><td>' + esc(r.iniciales) + ' <small style=\"color:var(--suave)\">(solo iniciales, por privacidad)</small></td></tr>' +\n        '<tr><th>Actividad</th><td>' + esc(r.actividad) + '</td></tr><tr><th>Fechas</th><td>' + esc(r.fechas) + '</td></tr><tr><th>Condición</th><td>' + esc(r.rol) + '</td></tr>' +\n        (r.horas ? '<tr><th>Duración</th><td>' + String(r.horas).replace('.', ',') + ' horas</td></tr>' : '') + (r.ects ? '<tr><th>ECTS</th><td>' + String(r.ects).replace('.', ',') + '</td></tr>' : '') +\n        '<tr><th>Expedido</th><td>' + esc(r.expedido) + '</td></tr><tr><th>Firmado por</th><td>' + r.firmantes.map(esc).join('<br>') + '</td></tr></table>';\n    } else if (r && r.estado === 'anulado') res = '<div class=\"estado mal\">Este certificado fue anulado y no tiene validez.</div>';\n    else if (r && r.estado === 'tramite') res = '<div class=\"estado medio\">Este certificado está en proceso de firma y todavía no se ha expedido.</div>';\n    else if (r && r.estado === 'no') res = '<div class=\"estado mal\">No existe ningún certificado con el código ' + esc(DATOS.codigo) + '. Revisa que esté bien escrito.</div>';\n    C.innerHTML = '<div class=\"tarjeta verif\"><p class=\"sub\">Escribe el código que aparece al pie del certificado o escanea su QR.</p>' +\n      '<form method=\"get\" action=\"' + esc(URL_APP) + '\" target=\"_top\"><input type=\"hidden\" name=\"p\" value=\"verificar\"><input type=\"text\" name=\"c\" placeholder=\"SAFA-PAS-2627-XXXXXX\" value=\"' + esc(DATOS.codigo || '') + '\"><button>Comprobar</button></form>' + res + '</div>';\n  }\n})();\n</script>\n</body>\n</html>\n", "Motor": "<script>\n/**\n * MOTOR DE CERTIFICADOS · Pastoral C.U. SAFA\n * ------------------------------------------------------------------\n * Una sola maquetación, dos salidas idénticas:\n *   · vista previa en pantalla (canvas)  · PDF final (pdf-lib)\n * Funciona en el navegador (editor de la hoja) y en Node (pruebas).\n * Unidades: puntos tipográficos (A4 = 595,28 × 841,89), origen arriba a la izquierda.\n */\n(function (raiz) {\n  'use strict';\n\n  const ANCHO = 595.28, ALTO = 841.89;\n\n  const TIPOGRAFIAS = {\n    opensans:   { nombre: 'Open Sans (como el modelo)', pkg: 'open-sans',  base: 'OpenSans' },\n    lora:       { nombre: 'Lora (serif elegante)',       pkg: 'lora',       base: 'Lora' },\n    montserrat: { nombre: 'Montserrat (moderna)',        pkg: 'montserrat', base: 'Montserrat' }\n  };\n  const VERSION_FUENTES = '0.4.2';\n  const ESTILOS = { regular: '400Regular', bold: '700Bold', italic: '400Regular_Italic', semibold: '600SemiBold' };\n\n  function urlFuente(tipo, estilo) {\n    const t = TIPOGRAFIAS[tipo] || TIPOGRAFIAS.opensans;\n    return 'https://cdn.jsdelivr.net/npm/@expo-google-fonts/' + t.pkg + '@' + VERSION_FUENTES + '/' +\n      ESTILOS[estilo] + '/' + t.base + '_' + ESTILOS[estilo] + '.ttf';\n  }\n\n  const PLANTILLAS = {\n    cabecera: 'Franjas (arriba y abajo)',\n    banda: 'Banda lateral (modelo anterior)',\n    marco: 'Marco con doble filete',\n    limpio: 'Limpio (para fondos propios)'\n  };\n\n  const DISENO_BASE = {\n    plantilla: 'cabecera',\n    color: '#2e7d4f',\n    acento: '#f2c14e',\n    colorTexto: '#1f2a33',\n    tipografia: 'opensans',\n    textoBanda: 'Centro Universitario Sagrada Familia (Úbeda)',\n    fondoId: '',\n    velo: 0,                 // 0-90: capa blanca semitransparente bajo el texto\n    logoSuperior: true,\n    logosPie: true,\n    qr: true,\n    etiqueta: 'Servicio de Pastoral y Compromiso Solidario',\n    titulo: 'Certificado de participación',\n    intro: 'Por la presente se certifica que:',\n    lineaDni: 'DNI: {dni}',\n    cuerpo: '{verbo} la actividad **{actividad}**, celebrada {lugar} **{fechas}**.',\n    descripcion: '',\n    textoHoras: 'La actividad ha tenido una duración de **{horas} horas**.',\n    textoEcts: 'La participación en esta actividad supone el reconocimiento de **{ects} {creditos} ECTS**, ' +\n      'en el marco de la formación integral del alumnado del Centro Universitario Sagrada Familia.',\n    cierre: '',\n    verbos: {\n      'Participante': 'ha participado en',\n      'Organización': 'ha colaborado en la organización de',\n      'Coordinación': 'ha coordinado'\n    },\n    firmas: []               // [{titulo, nombre}] ; vacío = los firmantes de la hoja «Ajustes»\n  };\n\n  // ─────────────────────────── utilidades ───────────────────────────\n  function mezclar(diseno) {\n    const d = JSON.parse(JSON.stringify(DISENO_BASE));\n    Object.keys(diseno || {}).forEach(function (k) {\n      if (diseno[k] === undefined || diseno[k] === null) return;\n      if (k === 'verbos') Object.assign(d.verbos, diseno.verbos);\n      else d[k] = diseno[k];\n    });\n    return d;\n  }\n\n  function hexARgb(hex) {\n    const h = String(hex || '#000').replace('#', '');\n    const n = parseInt(h.length === 3 ? h.split('').map(function (c) { return c + c; }).join('') : h, 16);\n    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];\n  }\n  function aclarar(hex, f) {\n    const c = hexARgb(hex).map(function (v) { return v + (1 - v) * f; });\n    return '#' + c.map(function (v) { return Math.round(v * 255).toString(16).padStart(2, '0'); }).join('');\n  }\n  function num(n) { return String(Math.round(Number(n) * 100) / 100).replace('.', ','); }\n\n  /** Sustituye {campos}. Los campos desconocidos se dejan tal cual para que se vean en la vista previa. */\n  function rellenar(plantilla, datos, d) {\n    const ects = Number(datos.ects) || 0;\n    const valores = {\n      nombre: ((datos.nombre || '') + ' ' + (datos.apellidos || '')).trim(),\n      dni: datos.dni || '', actividad: datos.actividad || '', fechas: datos.fechas || '',\n      lugar: datos.lugar || 'en el Centro Universitario de la Sagrada Familia de Úbeda',\n      horas: num(datos.horas || 0), ects: num(ects), creditos: ects === 1 ? 'crédito' : 'créditos',\n      verbo: (d.verbos && d.verbos[datos.rol]) || d.verbos['Participante'],\n      rol: datos.rol || '', curso: datos.curso || '', codigo: datos.codigo || '', fecha: datos.fecha || ''\n    };\n    return String(plantilla || '').replace(/\\{(\\w+)\\}/g, function (m, k) { return k in valores ? valores[k] : m; });\n  }\n\n  /** «texto **negrita** *cursiva*» → palabras formadas por trozos con estilo. */\n  function palabras(texto) {\n    const trozos = [];\n    const re = /(\\*\\*[^*]+\\*\\*|\\*[^*]+\\*)/g;\n    let ult = 0, m;\n    while ((m = re.exec(texto))) {\n      if (m.index > ult) trozos.push({ t: texto.slice(ult, m.index), f: 'regular' });\n      if (m[0].indexOf('**') === 0) trozos.push({ t: m[0].slice(2, -2), f: 'bold' });\n      else trozos.push({ t: m[0].slice(1, -1), f: 'italic' });\n      ult = re.lastIndex;\n    }\n    if (ult < texto.length) trozos.push({ t: texto.slice(ult), f: 'regular' });\n    const res = [];\n    let actual = [];\n    trozos.forEach(function (tr) {\n      tr.t.split(/(\\s+)/).forEach(function (s) {\n        if (!s) return;\n        if (/^\\s+$/.test(s)) { if (actual.length) { res.push(actual); actual = []; } return; }\n        actual.push({ t: s, f: tr.f });\n      });\n    });\n    if (actual.length) res.push(actual);\n    return res;\n  }\n\n  // ─────────────────────────── maquetación ──────────────────────────\n  /**\n   * @param diseno  objeto de diseño (se completa con DISENO_BASE)\n   * @param datos   {nombre, apellidos, dni, actividad, fechas, lugar, horas, ects, rol, codigo, url, fecha, firmantes:[{titulo,nombre}]}\n   * @param medir   function(fuente, texto, tamaño) → ancho en puntos\n   * @param imgs    {pastoral:{w,h}, safa:{w,h}, uja:{w,h}, fondo:{w,h}}  (las que existan)\n   * @param qr      function(texto) → matriz booleana (opcional)\n   */\n  function componer(diseno, datos, medir, imgs, qr) {\n    const d = mezclar(diseno);\n    imgs = imgs || {};\n    const ops = [], avisos = [];\n    const C = d.color, T = d.colorTexto, A = d.acento;\n    const gris = '#5d6b75';\n\n    // 1. Fondo y decoración\n    if (d.fondoId && imgs.fondo) ops.push({ t: 'img', k: 'fondo', x: 0, y: 0, w: ANCHO, h: ALTO });\n    let x0 = 72, x1 = ANCHO - 72, yTop = 54, yBottom = ALTO - 40;\n\n    if (d.plantilla === 'banda') {\n      const bw = 86;\n      ops.push({ t: 'rect', x: 0, y: 0, w: bw, h: ALTO, c: C });\n      ops.push({ t: 'rect', x: bw, y: 0, w: 3.2, h: ALTO, c: A });\n      if (d.textoBanda) {\n        let tam = 29;\n        const largo = medir('regular', d.textoBanda, tam);\n        if (largo > ALTO * 0.88) tam = tam * ALTO * 0.88 / largo;\n        const w = medir('regular', d.textoBanda, tam);\n        // Texto girado 90º: se lee de abajo arriba\n        ops.push({ t: 'text', s: d.textoBanda, f: 'regular', z: tam, c: '#ffffff', x: bw / 2 + tam * 0.36, y: (ALTO + w) / 2, rot: 90 });\n      }\n      x0 = bw + 46; x1 = ANCHO - 50;\n    } else if (d.plantilla === 'marco') {\n      ops.push({ t: 'box', x: 20, y: 20, w: ANCHO - 40, h: ALTO - 40, c: C, g: 2.6 });\n      ops.push({ t: 'box', x: 28, y: 28, w: ANCHO - 56, h: ALTO - 56, c: A, g: 0.8 });\n      [[20, 20], [ANCHO - 34, 20], [20, ALTO - 34], [ANCHO - 34, ALTO - 34]].forEach(function (p) {\n        ops.push({ t: 'rect', x: p[0], y: p[1], w: 14, h: 14, c: C });\n      });\n      x0 = 74; x1 = ANCHO - 74; yTop = 60; yBottom = ALTO - 46;\n    } else if (d.plantilla === 'cabecera') {\n      ops.push({ t: 'rect', x: 0, y: 0, w: ANCHO, h: 16, c: C });\n      ops.push({ t: 'rect', x: 0, y: 16, w: ANCHO, h: 3, c: A });\n      ops.push({ t: 'rect', x: 0, y: ALTO - 10, w: ANCHO, h: 10, c: C });\n      x0 = 70; x1 = ANCHO - 70; yTop = 50; yBottom = ALTO - 34;\n    }\n    const ancho = x1 - x0, cx = (x0 + x1) / 2;\n\n    if (d.velo > 0) {\n      const m = 18;\n      ops.push({ t: 'rect', x: x0 - m, y: yTop - m, w: ancho + 2 * m, h: yBottom - yTop + 2 * m, c: '#ffffff', o: Math.min(0.9, d.velo / 100) });\n    }\n\n    // 2. Pie (se coloca desde abajo): logos, código y QR\n    let yPie = yBottom;\n    const codigoTxt = datos.codigo || 'SAFA-PAS-0000-XXXXXX';\n    const tamQr = 48;\n    const conQr = d.qr && qr && datos.url;\n    if (conQr) {\n      const matriz = qr(datos.url + '?c=' + codigoTxt);\n      if (matriz) {\n        const n = matriz.length, celda = tamQr / n, xq = x1 - tamQr, yq = yPie - tamQr - 12;\n        for (let r = 0; r < n; r++) {\n          let ini = -1;\n          for (let c = 0; c <= n; c++) {\n            const on = c < n && matriz[r][c];\n            if (on && ini < 0) ini = c;\n            if (!on && ini >= 0) { ops.push({ t: 'rect', x: xq + ini * celda, y: yq + r * celda, w: (c - ini) * celda + 0.05, h: celda + 0.05, c: '#1d1d1d' }); ini = -1; }\n          }\n        }\n      }\n    }\n    // Línea del código\n    const lineaCodigo = 'Código de verificación: ' + codigoTxt;\n    ops.push({ t: 'text', s: lineaCodigo, f: 'regular', z: 7.2, c: gris,\n      x: conQr ? x1 - tamQr / 2 - medir('regular', lineaCodigo, 7.2) / 2 : cx - medir('regular', lineaCodigo, 7.2) / 2, y: yPie - 2 });\n    if (conQr && medir('regular', lineaCodigo, 7.2) / 2 > tamQr / 2) {\n      // si no cabe centrada bajo el QR, se alinea a la derecha\n      ops[ops.length - 1].x = x1 - medir('regular', lineaCodigo, 7.2);\n    }\n    yPie -= 14;\n    const altoPie = conQr ? tamQr : 46;\n    if (d.logosPie) {\n      const logos = [];\n      if (imgs.safa) logos.push({ k: 'safa', h: 46 });\n      if (imgs.uja) logos.push({ k: 'uja', h: 30 });\n      const areaW = conQr ? ancho - tamQr - 16 : ancho;\n      const hueco = areaW / Math.max(1, logos.length);\n      logos.forEach(function (l, i) {\n        const im = imgs[l.k];\n        let w = im.w * l.h / im.h, h = l.h;\n        if (w > hueco - 20) { w = hueco - 20; h = im.h * w / im.w; }\n        ops.push({ t: 'img', k: l.k, x: x0 + hueco * i + (hueco - w) / 2, y: yPie - altoPie / 2 - h / 2, w: w, h: h });\n      });\n    }\n    yPie -= altoPie + 16;\n\n    // 3. Firmas (encima del pie)\n    const firmantes = (d.firmas && d.firmas.length ? d.firmas : datos.firmantes) || [];\n    const nF = Math.max(1, firmantes.length);\n    const colW = ancho / nF;\n    const tamF = 10.5, interF = tamF * 1.35;\n    let maxLineasTitulo = 1;\n    const titulosPartidos = firmantes.map(function (f) {\n      const l = partir(palabras(f.titulo || ''), colW - 24, tamF, medir, 'bold');\n      maxLineasTitulo = Math.max(maxLineasTitulo, l.length);\n      return l;\n    });\n    const altoFirma = 78;              // hueco para la firma visible de Autofirma\n    const yNombres = yPie;\n    const yTitulos = yNombres - altoFirma - maxLineasTitulo * interF;\n    firmantes.forEach(function (f, i) {\n      const cxF = x0 + colW * i + colW / 2;\n      titulosPartidos[i].forEach(function (linea, j) {\n        dibujarLinea(ops, linea, cxF, yTitulos + j * interF + tamF, tamF, medir, T, 'center', colW - 24, false, 'bold');\n      });\n      const nom = f.nombre || '';\n      ops.push({ t: 'line', x: cxF - 70, y: yNombres - tamF - 5, x2: cxF + 70, y2: yNombres - tamF - 5, c: aclarar(C, 0.55), g: 0.6 });\n      ops.push({ t: 'text', s: nom, f: 'regular', z: tamF, c: T, x: cxF - medir('regular', nom, tamF) / 2, y: yNombres });\n    });\n    const limiteTexto = yTitulos - 22;\n\n    // 4. Cabecera y texto (de arriba abajo). Si no cabe, se reduce el tamaño del texto.\n    function cabecera(y, escala) {\n      const o = [];\n      if (d.logoSuperior && imgs.pastoral) {\n        const h = 84 * escala, w = imgs.pastoral.w * h / imgs.pastoral.h;\n        o.push({ t: 'img', k: 'pastoral', x: cx - w / 2, y: y, w: w, h: h });\n        y += h + 10 * escala;\n      }\n      if (d.etiqueta) {\n        const et = d.etiqueta.toUpperCase(), z = 8, esp = 1.8;\n        let w = 0; for (const ch of et) w += medir('semibold', ch, z) + esp; w -= esp;\n        let x = cx - w / 2;\n        for (const ch of et) { o.push({ t: 'text', s: ch, f: 'semibold', z: z, c: C, x: x, y: y + z }); x += medir('semibold', ch, z) + esp; }\n        y += z + 14 * escala;\n      }\n      if (d.titulo) {\n        let z = 27;\n        const w = medir('bold', d.titulo, z);\n        if (w > ancho) z = z * ancho / w;\n        o.push({ t: 'text', s: d.titulo, f: 'bold', z: z, c: T, x: cx - medir('bold', d.titulo, z) / 2, y: y + z * 0.9 });\n        y += z * 1.15 + 8 * escala;\n        o.push({ t: 'rect', x: cx - 28, y: y, w: 56, h: 2.2, c: A });\n        y += 20 * escala;\n      }\n      return { ops: o, y: y };\n    }\n\n    function cuerpo(y, z, escala) {\n      const o = [];\n      const inter = 1.52;\n      if (d.intro) {\n        const l = partir(palabras(rellenar(d.intro, datos, d)), ancho, z + 0.5, medir, 'bold');\n        l.forEach(function (linea) { dibujarLinea(o, linea, x0, y + z + 0.5, z + 0.5, medir, T, 'left', ancho, false, 'bold'); y += (z + 0.5) * inter; });\n        y += 10 * escala;\n      }\n      const nombre = rellenar('{nombre}', datos, d);\n      let zn = 22;\n      if (medir('bold', nombre, zn) > ancho) zn = zn * ancho / medir('bold', nombre, zn);\n      o.push({ t: 'text', s: nombre, f: 'bold', z: zn, c: C, x: cx - medir('bold', nombre, zn) / 2, y: y + zn * 0.9 });\n      y += zn * 1.2;\n      if (d.lineaDni) {\n        const ld = rellenar(d.lineaDni, datos, d);\n        o.push({ t: 'text', s: ld, f: 'regular', z: z, c: gris, x: cx - medir('regular', ld, z) / 2, y: y + z });\n        y += z * 1.5;\n      }\n      y += 16 * escala;\n      const parrafos = [rellenar(d.cuerpo, datos, d)];\n      String(d.descripcion || '').split(/\\n+/).forEach(function (p) { if (p.trim()) parrafos.push(rellenar(p.trim(), datos, d)); });\n      const extra = [];\n      if (Number(datos.horas) > 0 && d.textoHoras) extra.push(rellenar(d.textoHoras, datos, d));\n      if (Number(datos.ects) > 0 && d.textoEcts) extra.push(rellenar(d.textoEcts, datos, d));\n      if (extra.length) parrafos.push(extra.join(' '));\n      if (d.cierre) parrafos.push(rellenar(d.cierre, datos, d));\n      parrafos.forEach(function (p, i) {\n        const lineas = partir(palabras(p), ancho, z, medir, 'regular');\n        lineas.forEach(function (linea, j) {\n          dibujarLinea(o, linea, x0, y + z, z, medir, T, j === lineas.length - 1 ? 'left' : 'justify', ancho, true);\n          y += z * inter;\n        });\n        if (i < parrafos.length - 1) y += z * 0.75;\n      });\n      return { ops: o, y: y };\n    }\n\n    let z = 11.5, escala = 1, cab, cue;\n    for (let intento = 0; intento < 30; intento++) {\n      cab = cabecera(yTop, escala);\n      cue = cuerpo(cab.y, z, escala);\n      if (cue.y <= limiteTexto) break;\n      z -= 0.25; escala = Math.max(0.55, escala - 0.04);\n      if (z < 8.5) { avisos.push('El texto es demasiado largo: se ha reducido al mínimo y aun así no cabe. Acórtalo.'); break; }\n    }\n    if (z < 11.5 && avisos.length === 0) aviso