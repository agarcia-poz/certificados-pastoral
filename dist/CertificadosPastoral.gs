  if (u.rol === 'firmante' && !(i.estado === 'firma' && u.firmas.indexOf(Number(i.firmas) || 0) > -1)) throw new Error('SIN_PERMISO: Este certificado no espera tu firma.');
  const f = DriveApp.getFileById(i.archivo);
