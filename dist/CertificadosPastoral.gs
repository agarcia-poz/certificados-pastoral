function api_equipo(token) {
  sesion_(token, NIVEL.admin);
  return leer_('Equipo').map(function (m) {
    return { email: m.email, nombre: m.nombre, rol: m.rol, rolNombre: (ROLES[m.rol] || {}).nombre || m.rol, activo: m.activo === true };
  });
