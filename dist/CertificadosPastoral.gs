    if (u.rol === 'firmante') return i.estado === 'firma' && u.firmas.indexOf(Number(i.firmas) || 0) > -1;
    if (filtro.misFirmas) return i.estado === 'firma' && u.firmas.indexOf(Number(i.firmas) || 0) > -1;
    return true;
  }).map(function (i) {
    const k = Number(i.firmas) || 0;
