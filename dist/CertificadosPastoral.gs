= lista.filter((c) => c.estado === 'enviado' && c.descargado).length;\n    const accion = { generado: ['enviarFirma', 'Enviar a firmar', 'firma'], firmado: ['enviarAlumnado', 'Enviar al alumnado', 'correo'], revisar: ['enviarAlumnado', 'Enviar al alumnado', 'correo'], enviado: ['reenviar', 'Reenviar el correo', 'recargar'] }[etapa];\n    const seleccionable = !!accion;\n    const ayudaEtapa = {\n      generado: 'Revisa los PDF si quieres y pulsa «Enviar a firmar»: el primer firmante recibirá un aviso.',\n      firma: 'Esperando a los firmantes. Cada uno los firma con Autofirma y los sube en «Firmar».',\n      firmado: 'Tienen todas las firmas. Al enviarlos, cada alumno/a recibe un correo privado con un código para descargar su certificado.',\n      enviado: 'El correo solo sirve con su código privado. «Reenviar» manda un código nuevo y anula el anterior.',\n      revisar: 'Necesitan algo antes de enviarse (normalmente, el correo). Corrige los datos y envíalos.'\n    }[etapa] || '';\n    $('vEnvios').innerHTML = '<div class=\"pn-vista\">' + cab('Envíos', '', 'Sigue cada certificado desde que se genera hasta que el alumnado lo descarga.') +\n      '<div class=\"filtros\">' + selectorAct('eAct', acts, P.filtroCertAct || '', '<option value=\"\">Todas las actividades</option>') +\n      '<input type=\"search\" id=\"eBuscar\" placeholder=\"Buscar por nombre o código\" aria-label=\"Buscar\" value=\"' + esc(P.buscarCert || '') + '\"></div>' +\n      '<div class=\"etapas\">' + ETAPAS.map((e) => '<button class=\"etapa' + (e[0] === etapa ? ' activo' : '') + '\" data-etapa=\"' + e[0] + '\" aria-pressed=\"' + (e[0] === etapa) + '\"><span class=\"n\">' + n(e[0]) + '</span><span class=\"t\">' + e[1] +\n        (e[0] === 'enviado' ? ' · ' + desc + ' descargados' : '') + '</span><span class=\"barra-color\" style=\"background:' + e[2] + '\"></span></button>').join('') + '</div>' +\n      (ayudaEtapa ? '<div class=\"nota\">' + ic('info') + '<div>' + ayudaEtapa + '</div></div>' : '') +\n      (vis.length ? '<div class=\"tabla-env\"><table class=\"tabla\"><thead><tr><th>' + (seleccionable ? '<input type=\"checkbox\" id=\"eTodas\" aria-label=\"Seleccionar todos\">' : '') + '</th><th>Código</th><th>Persona</th><th>Actividad</th><th>Estado</th><th></th></tr></thead><tbody>' +\n        vis.map((c) => '<tr data-c=\"' + c.codigo + '\"><td>' + (seleccionable ? '<input type=\"checkbox\" class=\"sel\" aria-label=\"Seleccionar ' + esc(c.codigo) + '\">' : '') + '</td>' +\n          '<td style=\"white-space:nowrap\"><b>' + esc(c.codigo) + '</b></td><td>' + esc(c.nombre) + '<div class=\"ayuda\">' + esc(c.rol) + (c.tieneEmail ? '' : ' · <span style=\"color:var(--mal)\">sin correo</span>') + '</div></td><td>' + esc(c.actividad) + '</td>' +\n          '<td>' + chip(c.estado, c.estado === 'firma' ? (c.firmas + 1) + '/' + c.totalFirmas + ' · ' + c.pendienteDe : c.estado === 'enviado' ? c.enviado : '') +\n            (c.estado === 'enviado' ? '<div class=\"ayuda\">' + (c.descargado ? 'Descargado el ' + esc(c.descargado) : 'Aún sin descargar') + '</div>' : '') + (c.notas ? '<div class=\"ayuda\">' + esc(c.notas) + '</div>' : '') + '</td>' +\n          '<td class=\"acc\">' + (['generado', 'firma', 'firmado', 'enviado', 'revisar'].indexOf(c.estado) > -1 ? '<button class=\"boton peq\" data-a=\"pdf\">' + ic('descargar', 'peq') + 'PDF</button> ' : '') +\n            (c.estado === 'revisar' && c.persona ? '<button class=\"boton peq\" data-a=\"corregir\">Corregir</button> ' : '') +\n            (['generado', 'firma', 'firmado', 'revisar', 'generando'].indexOf(c.estado) > -1 ? '<button class=\"boton peq\" data-a=\"rehacer\">Rehacer</button> ' : '') +\n            (c.estado !== 'anulado' ? '<button class=\"boton peq peligro\" data-a=\"anular\">Anular</button>' : '') + '</td></tr>').join('') + '</tbody></table></div>'\n        : vacio('certificado', 'Nada en esta etapa', etapa === 'generado' ? 'Genera certificados en «Diseñar y generar».' : '')) +\n      (seleccionable ? '<div 