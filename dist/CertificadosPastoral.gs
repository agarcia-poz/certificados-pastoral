\n  .pv-cab { padding: 26px 22px 22px; color: #fff; }\n  .pv-cab small { font-weight: 700; opacity: .85; letter-spacing: .04em; text-transform: uppercase; font-size: 11.5px; }\n  .pv-cab h2 { color: #fff; margin: 6px 0 6px; font-size: 23px; line-height: 1.2; }\n  .pv-cab p { margin: 0; opacity: .95; font-size: 14px; }\n  .pv-cuerpo { background: #fff; margin: -10px 12px 14px; border-radius: 16px; padding: 18px 16px; box-shadow: var(--sombra); position: relative; }\n  .pv-fijo { border: 1px dashed var(--borde-fuerte); border-radius: 12px; padding: 10px 12px; margin-bottom: 18px; color: var(--suave); font-size: 13px; }\n\n  /* Gráficos e informe */\n  .barras .fila-b { display: grid; grid-template-columns: minmax(60px, 160px) 1fr 44px; gap: 10px; align-items: center; font-size: 13.5px; margin: 7px 0; }\n  .barras .pista-b { height: 12px; background: #edf1f4; border-radius: 6px; overflow: hidden; }\n  .barras .pista-b i { display: block; height: 100%; background: var(--azul); border-radius: 6px; }\n  .barras .fila-b span:last-child { text-align: right; color: var(--suave); font-weight: 700; }\n  .grande { font-family: var(--titulos); font-size: 44px; font-weight: 600; line-height: 1; color: var(--azul-osc); }\n  .cita { background: #fff; border-left: 3px solid var(--naranja); padding: 10px 14px; margin: 8px 0; border-radius: 0 10px 10px 0; line-height: 1.55; background: #fffcf6; }\n  .cita.mejora { border-left-color: var(--azul); background: #f7fbfd; }\n  .cita small { display: block; color: var(--suave); margin-top: 4px; font-size: 12.5px; }\n  .informe h3 { font-size: 16px; margin: 18px 0 6px; color: var(--azul-osc); }\n  .informe h3:first-child { margin-top: 0; }\n  .informe p, .informe li { line-height: 1.65; }\n  .informe ul { padding-left: 20px; margin: 6px 0; }\n\n  /* Ventanas */\n  .modal-fondo { position: fixed; inset: 0; background: rgba(15,28,40,.5); display: flex; align-items: center; justify-content: center; z-index: 80; padding: 16px; animation: aparecer .15s ease-out; }\n  @keyframes aparecer { from { opacity: 0; } to { opacity: 1; } }\n  .modal { background: #fff; border-radius: 18px; width: 100%; max-width: 560px; max-height: calc(100vh - 32px); overflow-y: auto; padding: 24px 26px; box-shadow: var(--sombra-alta); }\n  .modal.ancho { max-width: 760px; }\n  .modal h2 { margin: 0 0 6px; font-size: 20px; }\n  .modal .pie { display: flex; gap: 8px; justify-content: flex-end; margin-top: 22px; flex-wrap: wrap; }\n  .modal fieldset { border: 1px solid var(--borde); border-radius: 12px; padding: 4px 14px 12px; margin: 16px 0 0; }\n  .modal legend { font-family: var(--titulos); font-weight: 600; padding: 0 6px; }\n  .opcion-auto { display: flex; gap: 12px; align-items: flex-start; padding: 8px 0; }\n  .opcion-auto .interruptor { min-height: 24px; }\n  .opcion-auto div b { display: block; font-size: 14px; }\n  .opcion-auto div span { font-size: 13px; color: var(--suave); }\n  .cargando-pn { position: fixed; inset: 0; background: rgba(244,247,250,.82); display: flex; align-items: center; justify-content: center; gap: 12px; z-index: 85; font-weight: 700; color: var(--azul-osc); }\n  .qr-caja { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }\n  .qr-caja canvas { border: 1px solid var(--borde); border-radius: 10px; background: #fff; }\n  .enlace-copia { display: flex; gap: 6px; align-items: center; }\n  .enlace-copia input { font-size: 13px; color: var(--suave); min-height: 38px; }\n  .lista-enlaces > div { display: flex; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid #edf1f4; flex-wrap: wrap; }\n  .lista-enlaces > div:last-child { border-bottom: 0; }\n  .lista-enlaces b { flex: 1; min-width: 180px; }\n  .botones-enlace { display: inline-flex; gap: 6px; flex: none; }\n  .mapa { display: grid; grid-template-columns: minmax(150px, 220px) 1fr minmax(100px, 200px); gap: 8px 12px; align-items: center; }\n  .mapa .ej { font-size: 13px; color: var(--suave); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n  @media (max-width: 1100px) { .fb { grid-template-columns: 1fr; } .movil-marco { position: static; } }\n  @media (max-width: 900px) {\n    .pn-app { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }\n    .pn-movil { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: #fff; border-bottom: 1px solid var(--borde); }\n    .pn-movil img { height: 36px; }\n    .pn-lateral { position: fixed; inset: 0 auto 0 0; width: 284px; transform: translateX(-102%); transition: transform .2s ease; box-shadow: var(--sombra-alta); }\n    .pn-app.menu-abierto .pn-lateral { transform: none; }\n    .pn-velo { position: fixed; inset: 0; background: rgba(15,28,40,.4); z-index: 25; }\n    .pn-vista { padding: 20px 16px 70px; }\n    .r2, .r3, .fila2, .fila3 { grid-template-columns: 1fr; }\n    .filtros select, .filtros input { min-width: 0; width: 100%; }\n    .acts { grid-template-columns: 1fr; }\n    .tiles { grid-template-columns: 1fr 1fr; gap: 10px; }\n    .tile { padding: 14px; }\n    .tile .n { font-size: 26px; }\n    .pn-titulo h1 { font-size: 24px; }\n    .mapa { grid-template-columns: 1fr; }\n    .mapa .ej { display: none; }\n  }\n</style>\n</head>\n<body>\n<?!= incluir_('Iconos') ?>\n\n<!-- ─────────── ACCESO Y CONFIGURACIÓN ─────────── -->\n<div class=\"pn-acceso oculto\" id=\"pnAcceso\">\n  <main class=\"pn-tarjeta\">\n    <div class=\"franja-logo\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>\n    <div class=\"cuerpo\">\n      <img id=\"pnLogoAcceso\" alt=\"Pastoral · Centro Universitario Sagrada Familia\">\n      <h1>Certificados de Pastoral</h1>\n      <p class=\"sub\">Servicio de Pastoral y Compromiso Solidario</p>\n\n      <div id=\"pnPaso1\">\n        <label class=\"etq\" for=\"pnEmail\">Tu correo del centro</label>\n        <input type=\"email\" id=\"pnEmail\" autocomplete=\"email\" placeholder=\"nombre@fundacionsafa.es\">\n        <button class=\"boton primario\" id=\"pnPedir\">Enviarme un código</button>\n        <p class=\"ayuda\" style=\"margin-top:14px\">Te enviaremos un código de 6 cifras. Solo funciona con los correos del equipo de Pastoral.</p>\n      </div>\n      <div id=\"pnPaso2\" class=\"oculto\">\n        <p class=\"ayuda\">Si tu correo está en el equipo, te hemos enviado un código. Revisa también el correo no deseado.</p>\n        <label class=\"etq\" for=\"pnCodigo\">Código</label>\n        <input type=\"text\" id=\"pnCodigo\" class=\"pn-codigo\" inputmode=\"numeric\" maxlength=\"6\" autocomplete=\"one-time-code\">\n        <button class=\"boton primario\" id=\"pnEntrar\">Entrar</button>\n        <button class=\"boton fantasma\" id=\"pnOtro\" style=\"margin-top:8px\">Usar otro correo</button>\n      </div>\n\n      <div id=\"pnConfig\" class=\"oculto\">\n        <div class=\"nota\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-info\"/></svg><div><b>Primera configuración.</b> La aplicación todavía no está preparada. Solo la cuenta propietaria (<span id=\"pnProp\"></span>) puede configurarla.</div></div>\n        <div id=\"pnConfig1\"><button class=\"boton primario\" id=\"pnConfigPedir\">Enviar un código a la cuenta propietaria</button></div>\n        <div id=\"pnConfig2\" class=\"oculto\">\n          <label class=\"etq\" for=\"pnConfigNombre\">Tu nombre (para el equipo)</label>\n          <input type=\"text\" id=\"pnConfigNombre\" placeholder=\"Andrés García Pozas\">\n          <label class=\"etq\" for=\"pnConfigCodigo\">Código recibido</label>\n          <input type=\"text\" id=\"pnConfigCodigo\" class=\"pn-codigo\" inputmode=\"numeric\" maxlength=\"6\">\n          <button class=\"boton primario\" id=\"pnConfigar\">Configurar la aplicación</button>\n          <p class=\"ayuda\" style=\"margin-top:12px\">Se crearán en tu Drive, en la carpeta «Pastoral · Certificados (app)», los datos y la bóveda privada. Nadie más tiene acceso.</p>\n        </div>\n      </div>\n      <div id=\"pnErrorAcceso\" class=\"error oculto\" role=\"alert\" style=\"margin-top:14px\"></div>\n    </div>\n  </main>\n  <p class=\"pn-pie-acceso\">Centro Universitario «Sagrada Familia» · Úbeda · <i>Libres para servir</i></p>\n</div>\n\n<!-- ─────────── APLICACIÓN ─────────── -->\n<div class=\"pn-app oculto\" id=\"pnApp\">\n  <div class=\"pn-movil\">\n    <button class=\"boton icono fantasma\" id=\"pnMenuBtn\" aria-label=\"Abrir el menú\" aria-expanded=\"false\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-menu\"/></svg></button>\n    <img id=\"pnLogoMovil\" alt=\"Pastoral\">\n  </div>\n  <aside class=\"pn-lateral\" id=\"pnLateral\">\n    <div class=\"franja-logo\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>\n    <div class=\"pn-marca\"><img id=\"pnLogoLateral\" alt=\"Pastoral · Centro Universitario Sagrada Familia\"><span>Certificados · Pastoral y Compromiso Solidario</span></div>\n    <nav class=\"pn-nav\" id=\"pnNav\" aria-label=\"Secciones\"></nav>\n    <div class=\"pn-usuario\"><div class=\"pn-avatar\" id=\"pnAvatar\" aria-hidden=\"true\"></div><div><b id=\"pnUNombre\"></b><span id=\"pnURol\"></span></div>\n      <button class=\"boton peq icono fantasma\" id=\"pnSalir\" aria-label=\"Salir\" title=\"Salir\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-salir\"/></svg></button></div>\n  </aside>\n  <main class=\"pn-contenido\" id=\"pnContenido\">\n    <section class=\"vista\" id=\"vInicio\"></section>\n    <section class=\"vista oculto\" id=\"vActividades\"></section>\n    <section class=\"vista oculto\" id=\"vInscripciones\"></section>\n    <section class=\"vista oculto\" id=\"vFormularios\"></section>\n    <section class=\"vista oculto\" id=\"vImportar\"></section>\n    <section class=\"vista oculto\" id=\"vEnvios\"></section>\n    <section class=\"vista oculto\" id=\"vFirmar\"></section>\n    <section class=\"vista oculto\" id=\"vValoraciones\"></section>\n    <section class=\"vista oculto\" id=\"vEquipo\"></section>\n    <section class=\"vista oculto\" id=\"vAjustes\"></section>\n    <section class=\"vista oculto\" id=\"vRegistro\"></section>\n    <!-- La vista del editor (vistaEditor) se mueve aquí al arrancar -->\n  </main>\n</div>\n<div class=\"cargando-pn oculto\" id=\"pnCargando\" role=\"status\" aria-live=\"polite\"><div class=\"girando\"></div><span id=\"pnCargandoTxt\">Cargando…</span></div>\n<?!= incluir_('Editor') ?>\n<?!= incluir_('FormVista') ?>\n\n<script>\n(function () {\n  'use strict';\n  const $ = (id) => document.getElementById(id);\n  const esc = (t) => String(t == null ? '' : t).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n  const ic = window.ic;\n  const ESTADOS = {\n    pendiente: ['Por validar', 'naranja'], validada: ['Validada', 'azul'], generando: ['Generando', 'azul'], generado: ['Por enviar a firmar', 'indigo'],\n    firma: ['En firma', 'magenta'], firmado: ['Firmado', 'marron'], enviado: ['Enviado', 'verde'], revisar: ['Revisar', 'rojo'],\n    rechazada: ['Rechazada', 'gris'], anulado: ['Anulado', 'gris']\n  };\n  const ORIGEN = { web: 'Web', hoja: 'Hoja de Drive' };\n  const PALETA = [['Azul Pastoral', '#136EA1'], ['Rojo', '#C62A22'], ['Naranja', '#C26F00'], ['Verde', '#1F8A4E'], ['Magenta', '#C2006A'], ['Índigo', '#33228A'], ['Marrón', '#7E5128'], ['Grafito', '#3B4652']];\n  const P = { usuario: null, actividades: [], vista: 'inicio', actSel: '', resumen: {} };\n\n  // ─────────── servidor ───────────\n  function guardarToken(t) { window.TOKEN = t; try { if (t) sessionStorage.setItem('pn_token', t); else sessionStorage.removeItem('pn_token'); } catch (e) { } }\n  function tokenGuardado() { try { return sessionStorage.getItem('pn_token') || ''; } catch (e) { return ''; } }\n  function llamar(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise((ok, ko) => {\n      google.script.run.withSuccessHandler(ok).withFailureHandler((e) => {\n        const err = e && e.message ? e : new Error(String(e));\n        if (/^SESION/.test(err.message)) window.sesionCaducada();\n        err.message = err.message.replace(/^(Error: )?(SESION|SIN_PERMISO): /, '');\n        ko(err);\n      })[fn].apply(null, [window.TOKEN].concat(args));\n    });\n  }\n  function publico(fn) {\n    const args = Array.prototype.slice.call(arguments, 1);\n    return new Promise((ok, ko) => { google.script.run.withSuccessHandler(ok).withFailureHandler((e) => ko(e && e.message ? e : new Error(String(e))))[fn].apply(null, args); });\n  }\n  window.sesionCaducada = function () { guardarToken(''); mostrarAcceso(); errorAcceso('Tu sesión ha caducado. Vuelve a entrar.'); };\n  function aviso(t) { document.querySelectorAll('.toast').forEach((x) => x.remove()); const d = document.createElement('div'); d.className = 'toast'; d.setAttribute('role', 'status'); d.textContent = t; document.body.appendChild(d); setTimeout(() => d.remove(), 4200); }\n  function cargando(si, t) { $('pnCargando').classList.toggle('oculto', !si); $('pnCargandoTxt').textContent = t || 'Cargando…'; }\n  function errorAcceso(t) { $('pnErrorAcceso').textContent = t; $('pnErrorAcceso').classList.toggle('oculto', !t); }\n  window.descargarArchivo = function (blob, nombre) {\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a'); a.href = url; a.download = nombre; document.body.appendChild(a); a.click();\n    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 4000);\n  };\n  window.avisoPanel = aviso;\n  function b64aBlob(b64, tipo) { const bin = atob(b64), u = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i); return new Blob([u], { type: tipo }); }\n  function aBase64(buf) { const u = new Uint8Array(buf); let s = ''; for (let i = 0; i < u.length; i += 0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i + 0x8000)); return btoa(s); }\n  const num = (n) => String(n).replace('.', ',');\n\n  // ─────────── ventanas ───────────\n  function modal(html, alAbrir, ancho, alCerrar) {\n    const f = document.createElement('div'); f.className = 'modal-fondo';\n    f.innerHTML = '<div class=\"modal' + (ancho ? ' ancho' : '') + '\" role=\"dialog\" aria-modal=\"true\">' + html + '</div>';\n    const antes = document.activeElement;\n    document.body.appendChild(f);\n    let cerrado = false;\n    const cerrar = () => { if (cerrado) return; cerrado = true; f.remove(); document.removeEventListener('keydown', tecla); if (antes && antes.focus) antes.focus(); if (alCerrar) alCerrar(); };\n    const tecla = (e) => { if (e.key === 'Escape') cerrar(); };\n    document.addEventListener('keydown', tecla);\n    f.onclick = (e) => { if (e.target === f) cerrar(); };\n    f.querySelectorAll('[data-cerrar]').forEach((b) => { b.onclick = cerrar; });\n    const primero = f.querySelector('input:not([type=hidden]):not([readonly]), select, textarea, .pie .primario');\n    if (primero) setTimeout(() => primero.focus(), 30);\n    if (alAbrir) alAbrir(f, cerrar);\n    return cerrar;\n  }\n  /** Confirmación accesible (sin window.confirm). */\n  function preguntar(titulo, texto, si, peligro) {\n    return new Promise((ok) => {\n      let respuesta = false;\n      modal('<h2>' + esc(titulo) + '</h2><p class=\"ayuda\" style=\"font-size:14.5px\">' + texto + '</p>' +\n        '<div class=\"pie\"><button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton ' + (peligro ? 'peligro' : 'primario') + '\" data-si>' + esc(si || 'Aceptar') + '</button></div>', (f, c) => {\n        f.querySelector('[data-si]').onclick = () => { respuesta = true; c(); };\n        setTimeout(() => f.querySelector('[data-si]').focus(), 40);\n      }, false, () => ok(respuesta));\n    });\n  }\n\n  // ─────────── acceso ───────────\n  function mostrarAcceso() { $('pnApp').classList.add('oculto'); $('pnAcceso').classList.remove('oculto'); }\n  async function arrancar() {\n    ['pnLogoAcceso', 'pnLogoLateral', 'pnLogoMovil'].forEach((id) => { $(id).src = LOGOS.pastoral; });\n    $('pnContenido').appendChild($('vistaEditor'));\n    enlazarAcceso();\n    cargando(true);\n    try {\n      const est = await publico('api_estado');\n      if (!est.instalado) { mostrarAcceso(); $('pnPaso1').classList.add('oculto'); $('pnConfig').classList.remove('oculto'); $('pnProp').textContent = est.propietario; return; }\n      const t = tokenGuardado();\n      if (t) { guardarToken(t); try { const u = await llamar('api_yo'); entrarApp(u); return; } catch (e) { guardarToken(''); } }\n      mostrarAcceso();\n    } catch (e) { mostrarAcceso(); errorAcceso('No se pudo conectar: ' + e.message); }\n    finally { cargando(false); }\n  }\n  function enlazarAcceso() {\n    $('pnPedir').onclick = async () => {\n      errorAcceso('');\n      const email = $('pnEmail').value.trim();\n      if (!email) return errorAcceso('Escribe tu correo.');\n      $('pnPedir').disabled = true;\n      try { await publico('api_pedirCodigo', email); $('pnPaso1').classList.add('oculto'); $('pnPaso2').classList.remove('oculto'); $('pnCodigo').focus(); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnPedir').disabled = false; }\n    };\n    $('pnEmail').onkeydown = (e) => { if (e.key === 'Enter') $('pnPedir').click(); };\n    $('pnCodigo').onkeydown = (e) => { if (e.key === 'Enter') $('pnEntrar').click(); };\n    $('pnEntrar').onclick = async () => {\n      errorAcceso(''); $('pnEntrar').disabled = true;\n      try { const r = await publico('api_entrar', $('pnEmail').value.trim(), $('pnCodigo').value.trim()); guardarToken(r.token); entrarApp(r.usuario); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnEntrar').disabled = false; }\n    };\n    $('pnOtro').onclick = () => { $('pnPaso2').classList.add('oculto'); $('pnPaso1').classList.remove('oculto'); $('pnCodigo').value = ''; };\n    $('pnConfigPedir').onclick = async () => {\n      errorAcceso(''); $('pnConfigPedir').disabled = true;\n      try { await publico('api_configurarPedirCodigo'); $('pnConfig1').classList.add('oculto'); $('pnConfig2').classList.remove('oculto'); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnConfigPedir').disabled = false; }\n    };\n    $('pnConfigar').onclick = async () => {\n      errorAcceso(''); $('pnConfigar').disabled = true; cargando(true, 'Preparando la aplicación…');\n      try { const r = await publico('api_configurar', $('pnConfigCodigo').value.trim(), $('pnConfigNombre').value.trim()); guardarToken(r.token); entrarApp(r.usuario); aviso('¡Lista! Empieza por «Ajustes» para revisar los firmantes.'); }\n      catch (e) { errorAcceso(e.message); } finally { $('pnConfigar').disabled = false; cargando(false); }\n    };\n    $('pnSalir').onclick = async () => { try { await llamar('api_salir'); } catch (x) { } guardarToken(''); location.reload(); };\n    $('pnMenuBtn').onclick = () => menuMovil(!$('pnApp').classList.contains('menu-abierto'));\n  }\n  function menuMovil(abrir) {\n    $('pnApp').classList.toggle('menu-abierto', abrir);\n    $('pnMenuBtn').setAttribute('aria-expanded', abrir ? 'true' : 'false');\n    document.querySelectorAll('.pn-velo').forEach((v) => v.remove());\n    if (abrir) { const v = document.createElement('div'); v.className = 'pn-velo'; v.onclick = () => menuMovil(false); $('pnApp').appendChild(v); }\n  }\n\n  // ─────────── navegación ───────────\n  const MENU = [\n    { id: 'inicio', ic: 'inicio', t: 'Inicio', nivel: 1 },\n    { g: 'Actividades', nivel: 2 },\n    { id: 'actividades', ic: 'calendario', t: 'Actividades', nivel: 2 },\n    { id: 'inscripciones', ic: 'personas', t: 'Inscripciones', nivel: 2, num: 'porValidar' },\n    { id: 'formularios', ic: 'formulario', t: 'Formularios', nivel: 2 },\n    { id: 'importar', ic: 'hoja', t: 'Importar de Drive', nivel: 2 },\n    { g: 'Certificados', nivel: 1 },\n    { id: 'editor', ic: 'paleta', t: 'Diseñar y generar', nivel: 2, num: 'porGenerar' },\n    { id: 'envios', ic: 'enviar', t: 'Envíos', nivel: 2, num: 'porEnviar' },\n    { id: 'firmar', ic: 'firma', t: 'Firmar', nivel: 1, num: 'misFirmas', firmante: true },\n    { g: 'Análisis', nivel: 2 },\n    { id: 'valoraciones', ic: 'grafico', t: 'Valoraciones e informes', nivel: 2 },\n    { g: 'Administración', nivel: 2 },\n    { id: 'equipo', ic: 'escudo', t: 'Equipo', nivel: 3 },\n    { id: 'ajustes', ic: 'ajustes', t: 'Ajustes', nivel: 2 },\n    { id: 'registro', ic: 'lista', t: 'Registro', nivel: 3 }\n  ];\n  function entrarApp(u) {\n    P.usuario = u;\n    $('pnAcceso').classList.add('oculto'); $('pnApp').classList.remove('oculto');\n    $('pnUNombre').textContent = u.nombre; $('pnURol').textContent = u.rolNombre;\n    $('pnAvatar').textContent = (u.nombre || '?').split(/\\s+/).slice(0, 2).map((p) => p.charAt(0)).join('').toUpperCase();\n    pintarMenu({});\n    const h = (location.hash || '').replace('#', '');\n    ir(MENU.some((m) => m.id === h && visible(m)) ? h : (u.rol === 'firmante' ? 'firmar' : 'inicio'));\n  }\n  function visible(m) {\n    if (!P.usuario) return false;\n    if (m.g) return P.usuario.nivel >= m.nivel || (m.nivel === 1 && P.usuario.firmas.length);\n    return P.usuario.nivel >= m.nivel || (m.firmante && P.usuario.firmas.length);\n  }\n  function pintarMenu(c) {\n    P.resumen = Object.assign(P.resumen, c);\n    const cuentas = Object.assign({}, P.resumen, { porEnviar: (P.resumen.generados || 0) + (P.resumen.firmados || 0) });\n    $('pnNav').innerHTML = MENU.filter(visible).map((m) => m.g ? '<div class=\"pn-grupo\">' + m.g + '</div>' :\n      '<a href=\"#' + m.id + '\" data-v=\"' + m.id + '\" class=\"' + (P.vista === m.id ? 'activo' : '') + '\"' + (P.vista === m.id ? ' aria-current=\"page\"' : '') + '>' + ic(m.ic) + '<span>' + m.t + '</span>' +\n      (m.num && cuentas[m.num] ? '<span class=\"num\" aria-label=\"' + cuentas[m.num] + ' pendientes\">' + cuentas[m.num] + '</span>' : '') + '</a>').join('');\n    $('pnNav').querySelectorAll('a[data-v]').forEach((a) => { a.onclick = (e) => { e.preventDefault(); ir(a.dataset.v); menuMovil(false); }; });\n  }\n  const VISTAS = { inicio: 'vInicio', actividades: 'vActividades', inscripciones: 'vInscripciones', formularios: 'vFormularios', importar: 'vImportar',\n    editor: 'vistaEditor', envios: 'vEnvios', firmar: 'vFirmar', valoraciones: 'vValoraciones', equipo: 'vEquipo', ajustes: 'vAjustes', registro: 'vRegistro' };\n  async function ir(v, op) {\n    P.vista = v;\n    Object.values(VISTAS).forEach((id) => $(id).classList.add('oculto'));\n    $(VISTAS[v]).classList.remove('oculto');\n    $('pnNav').querySelectorAll('a[data-v]').forEach((a) => { a.classList.toggle('activo', a.dataset.v === v); if (a.dataset.v === v) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });\n    try { history.replaceState(null, '', '#' + v); } catch (e) { }\n    $('pnContenido').scrollTop = 0;\n    try {\n      if (v === 'inicio') await vInicio();\n      if (v === 'actividades') await vActividades();\n      if (v === 'inscripciones') await vInscripciones(op);\n      if (v === 'formularios') await vFormularios(op);\n      if (v === 'importar') await vImportar(op);\n      if (v === 'editor') await window.abrirEditor(op && op.act, op && op.tab);\n      if (v === 'envios') await vEnvios(op);\n      if (v === 'firmar') await vFirmar();\n      if (v === 'valoraciones') await vValoraciones(op);\n      if (v === 'equipo') await vEquipo();\n      if (v === 'ajustes') await vAjustes();\n      if (v === 'registro') await vRegistro();\n    } catch (e) { aviso('Error: ' + e.message); }\n    if (v !== 'inicio') llamar('api_resumen').then(pintarMenu).catch(() => { });\n  }\n  window.irPanel = ir;\n  async function actividades() { P.actividades = await llamar('api_actividades'); return P.actividades; }\n  function cab(titulo, acciones, lead) {\n    return '<div class=\"pn-titulo\"><h1>' + titulo + '</h1><div class=\"acciones\">' + (acciones || '') + '</div></div>' + (lead ? '<p class=\"pn-lead\">' + lead + '</p>' : '<div style=\"height:16px\"></div>');\n  }\n  function chip(estado, extra) { const e = ESTADOS[estado] || [estado, 'gris']; return '<span class=\"chip c-' + e[1] + '\">' + e[0] + (extra ? ' · ' + esc(extra) : '') + '</span>'; }\n  function vacio(icono, titulo, texto) { return '<div class=\"vacio\">' + ic(icono) + '<b>' + titulo + '</b>' + (texto || '') + '</div>'; }\n  function selectorAct(id, acts, sel, extra) {\n    return '<select id=\"' + id + '\" aria-label=\"Actividad\">' + (extra || '') + acts.map((a) => '<option value=\"' + a.id + '\"' + (a.id === sel ? ' selected' : '') + '>' + esc(a.nombre) + '</option>').join('') + '</select>';\n  }\n  function interruptor(id, marcado, texto, attrs) {\n    return '<label class=\"interruptor\"><input type=\"checkbox\" id=\"' + (id || '') + '\"' + (marcado ? ' checked' : '') + (attrs || '') + '><span class=\"pista\" aria-hidden=\"true\"></span><span>' + texto + '</span></label>';\n  }\n  function dibujarQr(canvas, texto) {\n    if (typeof qrcode === 'undefined') return;\n    const q = qrcode(0, 'M'); q.addData(texto); q.make();\n    const n = q.getModuleCount(), x = canvas.getContext('2d'), c = canvas.width / (n + 4);\n    x.fillStyle = '#fff'; x.fillRect(0, 0, canvas.width, canvas.height); x.fillStyle = '#1B2733';\n    for (let r = 0; r < n; r++) for (let k = 0; k < n; k++) if (q.isDark(r, k)) x.fillRect((k + 2) * c, (r + 2) * c, c + .3, c + .3);\n  }\n  function modalQr(titulo, url) {\n    modal('<h2>' + esc(titulo) + '</h2><p class=\"ayuda\">Proyéctalo al final de la actividad o pégalo en Classroom.</p>' +\n      '<div style=\"text-align:center;margin:14px 0\"><canvas id=\"qrGrande\" width=\"320\" height=\"320\" style=\"max-width:100%;border:1px solid var(--borde);border-radius:14px\"></canvas></div>' +\n      '<div class=\"enlace-copia\"><input type=\"text\" readonly value=\"' + esc(url) + '\" aria-label=\"Enlace\"><button class=\"boton peq\" data-copiar>' + ic('copiar', 'peq') + 'Copiar</button></div>' +\n      '<div class=\"pie\"><button class=\"boton\" id=\"qrPng\">' + ic('descargar') + 'Descargar imagen</button><button class=\"boton primario\" data-cerrar>Cerrar</button></div>', (f) => {\n      dibujarQr(f.querySelector('#qrGrande'), url);\n      f.querySelector('[data-copiar]').onclick = () => copiar(url);\n      f.querySelector('#qrPng').onclick = () => f.querySelector('#qrGrande').toBlob((b) => window.descargarArchivo(b, 'QR ' + titulo.replace(/[^\\wáéíóúñü ]+/gi, ' ').trim() + '.png'));\n    });\n  }\n  async function copiar(t) {\n    try { await navigator.clipboard.writeText(t); aviso('Copiado.'); }\n    catch (e) { const a = document.createElement('textarea'); a.value = t; a.style.position = 'fixed'; a.style.left = '-9999px'; document.body.appendChild(a); a.select(); try { document.execCommand('copy'); aviso('Copiado.'); } catch (x) { aviso('No se pudo copiar: selecciónalo a mano.'); } a.remove(); }\n  }\n  function enlaceFila(titulo, url, etiqueta) {\n    return '<div><b>' + esc(titulo) + (etiqueta ? ' <span class=\"chip c-azul\" style=\"margin-left:6px\">' + etiqueta + '</span>' : '') + '</b><span class=\"botones-enlace\">' +\n      '<button class=\"boton peq\" data-copiar=\"' + esc(url) + '\">' + ic('copiar', 'peq') + 'Copiar</button>' +\n      '<button class=\"boton peq\" data-qr=\"' + esc(url) + '\" data-qrt=\"' + esc(titulo) + '\">' + ic('qr', 'peq') + 'QR</button>' +\n      '<a class=\"boton peq icono fantasma\" href=\"' + esc(url) + '\" target=\"_blank\" rel=\"noopener\" aria-label=\"Abrir en otra pestaña\" title=\"Abrir\">' + ic('externo', 'peq') + '</a></span></div>';\n  }\n  function enlazarEnlaces(raiz) {\n    raiz.querySelectorAll('[data-copiar]').forEach((b) => { if (b.dataset.copiar) b.onclick = () => copiar(b.dataset.copiar); });\n    raiz.querySelectorAll('[data-qr]').forEach((b) => { b.onclick = () => modalQr(b.dataset.qrt, b.dataset.qr); });\n  }\n\n  // ─────────── INICIO ───────────\n  async function vInicio() {\n    const r = await llamar('api_resumen');\n    pintarMenu(r);\n    const u = P.usuario;\n    const h = new Date().getHours();\n    const saludo = (h < 14 ? 'Buenos días' : h < 21 ? 'Buenas tardes' : 'Buenas noches') + ', ' + esc(u.nombre.split(' ')[0]);\n    const tile = (n, t, icono, color, destino, op) => '<button class=\"tile t-' + color + (n ? '' : ' cero') + '\" data-ir=\"' + destino + '\"' + (op ? ' data-op=\"' + op + '\"' : '') + '>' +\n      '<span class=\"icono-tile\">' + ic(icono) + '</span><span class=\"n\">' + n + '</span><span class=\"t\">' + t + '</span></button>';\n    const t = [];\n    if (u.nivel >= 2) {\n      t.push(tile(r.porValidar, 'Inscripciones por validar', 'personas', 'naranja', 'inscripciones'));\n      t.push(tile(r.porGenerar, 'Certificados por generar', 'paleta', 'azul', 'editor'));\n      t.push(tile(r.generados, 'Por enviar a firmar', 'enviar', 'indigo', 'envios', 'generado'));\n    }\n    if (u.firmas.length) t.push(tile(r.misFirmas, 'Esperan tu firma', 'firma', 'magenta', 'firmar'));\n    if (u.nivel >= 2) {\n      t.push(tile(r.enFirma, 'En proceso de firma', 'reloj', 'magenta', 'envios', 'firma'));\n      t.push(tile(r.firmados, 'Firmados · por enviar al alumnado', 'correo', 'marron', 'envios', 'firmado'));\n      t.push(tile(r.enviadosCurso, 'Enviados en ' + r.curso + ' · ' + r.descargadosCurso + ' descargados', 'certificado', 'verde', 'envios', 'enviado'));\n      if (r.revisar) t.push(tile(r.revisar, 'Para revisar', 'aviso', 'rojo', 'envios', 'revisar'));\n    }\n    const avisos = [];\n    if (u.nivel >= 2 && r.firmantes === 0) avisos.push('No hay firmantes configurados. Ve a «Ajustes».');\n    const enlaces = r.abiertas.map((a) => enlaceFila(a.nombre, r.urlApp + '?p=f&a=' + a.id, 'Inscripción')).join('') +\n      r.evaluando.map((a) => enlaceFila(a.nombre, r.urlApp + '?p=e&a=' + a.id, 'Evaluación')).join('');\n    $('vInicio').innerHTML = '<div class=\"pn-vista\">' + cab(saludo, '', u.nivel >= 2 ? 'Esto es lo que tienes en marcha. Pulsa cualquier tarjeta para ir directamente.' : 'Aquí tienes los certificados que esperan tu firma.') +\n      avisos.map((a) => '<div class=\"aviso\">' + ic('aviso') + '<div>' + a + '</div></div>').join('') +\n      '<div class=\"tiles\">' + t.join('') + '</div>' +\n      (u.nivel >= 2 ? '<div class=\"rejilla r2\"><div class=\"caja\"><h2>' + ic('enlace') + 'Enlaces para el alumnado</h2>' +\n        (enlaces ? '<div class=\"lista-enlaces\">' + enlaces + '</div>' : '<p class=\"ayuda\" style=\"margin:0\">Ahora mismo no hay ningún formulario abierto. Ábrelos desde «Actividades».</p>') +\n        '<p class=\"ayuda\" style=\"margin:12px 0 0\">Página general con todas las inscripciones abiertas: <a href=\"' + esc(r.urlInscripcion) + '\" target=\"_blank\" rel=\"noopener\">abrir</a> · Verificación pública: <a href=\"' + esc(r.urlVerificacion) + '\" target=\"_blank\" rel=\"noopener\">abrir</a></p></div>' +\n        '<div class=\"caja\"><h2>' + ic('rayo') + 'Automatización</h2>' +\n        '<p style=\"margin:0 0 8px\">' + ic('hoja', 'peq') + ' <b>' + r.enlazadas + '</b> actividad(es) con una hoja de Drive enlazada.</p>' +\n        '<p style=\"margin:0 0 8px\">' + ic('ia', 'peq') + ' Inteligencia artificial: <b>' + (r.ia ? 'activada' : 'sin activar') + '</b>' + (!r.ia && u.rol === 'admin' ? ' · <a href=\"#ajustes\" data-irajustes>actívala en Ajustes</a>' : '') + '</p>' +\n        '<p class=\"ayuda\" style=\"margin:0\">Cada hora la app trae las respuestas nuevas de las hojas enlazadas y hace lo que hayas activado en cada actividad: validar, generar, enviar a firmar y enviar al alumnado.</p></div></div>' : '') +\n      '</div>';\n    $('vInicio').querySelectorAll('[data-ir]').forEach((d) => { d.onclick = () => ir(d.dataset.ir, d.dataset.op ? { estado: d.dataset.op } : null); });\n    $('vInicio').querySelectorAll('[data-irajustes]').forEach((d) => { d.onclick = (e) => { e.preventDefault(); ir('ajustes'); }; });\n    enlazarEnlaces($('vInicio'));\n  }\n\n  // ─────────── ACTIVIDADES ───────────\n  async function vActividades() {\n    const acts = await actividades();\n    const tarjeta = (a) => {\n      const auto = a.auto || {};\n      const nAuto = ['validar', 'generar', 'firmar', 'alumnado'].filter((k) => auto[k]).length;\n      return '<article class=\"act\" data-id=\"' + a.id + '\">' +\n        '<div class=\"act-cab\"><div style=\"flex:1;min-width:0\"><h3>' + esc(a.nombre) + '</h3><div class=\"meta\">' + esc(a.id) + ' · ' + esc(a.tipo || 'Sin tipo') + ' · ' + esc(a.fechas || 'sin fechas') +\n          (a.horas ? ' · ' + num(a.horas) + ' h' : '') + (a.ects ? ' · ' + num(a.ects) + ' ECTS' : '') + '</div></div>' +\n          '<button class=\"boton peq icono fantasma\" data-edit aria-label=\"Editar la actividad\" title=\"Editar\">' + ic('lapiz') + '</button></div>' +\n        '<div class=\"act-num\"><div><b>' + a.inscritos + '</b><span>Inscritos</span></div><div><b>' + a.pendientes + '</b><span>Por validar</span></div>' +\n          '<div><b>' + (a.enFirma + a.generados + a.firmados) + '</b><span>En curso</span></div><div><b>' + a.enviados + '</b><span>Enviados</span></div></div>' +\n        '<div class=\"act-ctrl\">' + interruptor('', a.abierta, 'Inscripción abierta', ' data-abrir') + interruptor('', a.evaluacion, 'Evaluación abierta', ' data-evaluar') + '</div>' +\n        '<div class=\"act-marcas\">' + (nAuto ? '<span class=\"chip c-indigo\">' + ic('rayo', 'peq') + 'Automatizada (' + nAuto + '/4)</span>' : '') +\n          (a.enlace ? '<span class=\"chip c-verde\">' + ic('hoja', 'peq') + 'Hoja enlazada</span>' : '') +\n          (a.valoracion != null ? '<span class=\"chip c-naranja\">' + ic('estrella', 'peq') + num(a.valoracion) + ' · ' + a.nValoraciones + '</span>' : '') +\n          (a.conDiseno ? '<span class=\"chip c-azul\">' + ic('paleta', 'peq') + 'Diseño propio</span>' : '') + '</div>' +\n        '<div class=\"act-pie\"><button class=\"boton peq fantasma\" data-ins>' + ic('personas', 'peq') + 'Inscripciones</button>' +\n          '<button class=\"boton peq fantasma\" data-form>' + ic('formulario', 'peq') + 'Formularios</button>' +\n          '<button class=\"boton peq fantasma\" data-dis>' + ic('paleta', 'peq') + 'Diseño</button>' +\n          '<button class=\"boton peq fantasma\" data-val>' + ic('grafico', 'peq') + 'Valoraciones</button></div></article>';\n    };\n    $('vActividades').innerHTML = '<div class=\"pn-vista\">' + cab('Actividades', '<button class=\"boton primario\" id=\"nuevaAct\">' + ic('mas') + 'Nueva actividad</button>',\n      'Abre o cierra la inscripción y la evaluación de cada actividad. En «Editar» puedes escribir su contexto (lo usa la IA) y automatizar el proceso.') +\n      (acts.length ? '<div class=\"acts\">' + acts.map(tarjeta).join('') + '</div>' : vacio('calendario', 'Aún no hay actividades', 'Crea la primera con «Nueva actividad».')) + '</div>';\n    $('nuevaAct').onclick = () => modalActividad({});\n    $('vActividades').querySelectorAll('.act').forEach((el) => {\n      const a = acts.find((x) => x.id === el.dataset.id);\n      el.querySelector('[data-edit]').onclick = () => modalActividad(a);\n      el.querySelector('[data-ins]').onclick = () => ir('inscripciones', { act: a.id });\n      el.querySelector('[data-form]').onclick = () => ir('formularios', { act: a.id });\n      el.querySelector('[data-dis]').onclick = () => ir('editor', { act: a.id, tab: 'diseno' });\n      el.querySelector('[data-val]').onclick = () => ir('valoraciones', { act: a.id });\n      const sw = (sel, campo, si, no) => {\n        const c = el.querySelector(sel);\n        c.onchange = async () => {\n          try { await llamar('api_guardarActividad', { id: a.id, [campo]: c.checked }); a[campo] = c.checked; aviso(c.checked ? si : no); }\n          catch (e) { c.checked = !c.checked; aviso(e.message); }\n        };\n      };\n      sw('[data-abrir]', 'abierta', 'Inscripción abierta.', 'Inscripción cerrada.');\n      sw('[data-evaluar]', 'evaluacion', 'Evaluación abierta.', 'Evaluación cerrada.');\n    });\n  }\n  function modalActividad(a) {\n    const tipos = ['Voluntariado', 'Retiro', 'Jornada', 'Encuentro', 'Celebración', 'Peregrinación', 'Formación', 'Otra'];\n    const auto = a.auto || {};\n    const opcion = (k, t, d) => '<div class=\"opcion-auto\">' + interruptor('mA_' + k, auto[k], '<span class=\"sr\">' + t + '</span>') + '<div><b>' + t + '</b><span>' + d + '</span></div></div>';\n    modal('<h2>' + (a.id ? 'Editar actividad' : 'Nueva actividad') + '</h2>' +\n      '<label class=\"etq\" for=\"mNombre\">Nombre <small>(tal como saldrá en el certificado)</small></label><input type=\"text\" id=\"mNombre\" value=\"' + esc(a.nombre || '') + '\">' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"mTipo\">Tipo</label><select id=\"mTipo\">' + tipos.map((t) => '<option' + (t === a.tipo ? ' selected' : '') + '>' + t + '</option>').join('') + '</select></div>' +\n      '<div><label class=\"etq\" for=\"mCurso\">Curso</label><input type=\"text\" id=\"mCurso\" value=\"' + esc(a.curso || '') + '\" placeholder=\"2026-27\"></div></div>' +\n      '<label class=\"etq\" for=\"mFechas\">Fechas <small>(con artículo, como en el certificado)</small></label><input type=\"text\" id=\"mFechas\" value=\"' + esc(a.fechas || '') + '\" placeholder=\"los días 18 y 19 de marzo de 2027\">' +\n      '<label class=\"etq\" for=\"mLugar\">Lugar <small>(vacío = en el Centro Universitario de la Sagrada Familia de Úbeda)</small></label><input type=\"text\" id=\"mLugar\" value=\"' + esc(a.lugar || '') + '\" placeholder=\"en la Casa de Espiritualidad de Úbeda\">' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"mHoras\">Horas</label><input type=\"number\" min=\"0\" step=\"0.5\" id=\"mHoras\" value=\"' + (a.horas || '') + '\"></div>' +\n      '<div><label class=\"etq\" for=\"mEcts\">Créditos ECTS</label><input type=\"number\" min=\"0\" step=\"0.5\" id=\"mEcts\" value=\"' + (a.ects || '') + '\"></div></div>' +\n      '<label class=\"etq\" for=\"mContexto\">Contexto <small>(qué se hace, objetivos, entidades colaboradoras… lo usa la IA para el texto del certificado, los formularios y el informe)</small></label>' +\n      '<textarea id=\"mContexto\" rows=\"4\" placeholder=\"Jornadas con la ONG Entreculturas sobre coeducación…\">' + esc(a.contexto || '') + '</textarea>' +\n      '<fieldset><legend>Automatización</legend>' +\n      opcion('validar', 'Validar sola cada inscripción', 'Salvo las que tengan algún aviso (por ejemplo, mismo DNI con otro nombre).') +\n      opcion('generar', 'Generar los certificados', 'Cada hora, en el servidor, con el diseño guardado de la actividad.') +\n      opcion('firmar', 'Enviarlos a firmar', 'En cuanto estén generados, avisando al primer firmante.') +\n      opcion('alumnado', 'Enviarlos al alumnado', 'En cuanto tengan todas las firmas, con su código privado de descarga.') + '</fieldset>' +\n      '<div class=\"pie\">' + (a.id && !a.inscritos ? '<button class=\"boton peligro\" id=\"mBorrar\" style=\"margin-right:auto\">' + ic('papelera') + 'Borrar</button>' : '') +\n      '<button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"mGuardar\">Guardar</button></div>',\n      (f, cerrar) => {\n        f.querySelector('#mGuardar').onclick = async () => {\n          const g = (id) => f.querySelector('#' + id);\n          try {\n            await llamar('api_guardarActividad', { id: a.id, nombre: g('mNombre').value, tipo: g('mTipo').value, curso: g('mCurso').value.trim(), fechas: g('mFechas').value,\n              lugar: g('mLugar').value, horas: g('mHoras').value, ects: g('mEcts').value, contexto: g('mContexto').value,\n              auto: { validar: g('mA_validar').checked, generar: g('mA_generar').checked, firmar: g('mA_firmar').checked, alumnado: g('mA_alumnado').checked },\n              abierta: a.id ? undefined : false });\n            cerrar(); aviso('Actividad guardada.'); vActividades();\n          } catch (e) { aviso(e.message); }\n        };\n        const b = f.querySelector('#mBorrar');\n        if (b) b.onclick = async () => { cerrar(); if (!(await preguntar('¿Borrar la actividad?', 'Se borrará «' + esc(a.nombre) + '». No tiene inscripciones.', 'Borrar', true))) return; try { await llamar('api_borrarActividad', a.id); vActividades(); } catch (e) { aviso(e.message); } };\n      }, true);\n  }\n\n  // ─────────── INSCRIPCIONES ───────────\n  async function vInscripciones(op) {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    if (op && op.act) P.actSel = op.act;\n    if (!P.actSel || !acts.some((a) => a.id === P.actSel)) P.actSel = (acts.find((a) => a.pendientes) || acts[0] || {}).id || '';\n    if (!acts.length) { $('vInscripciones').innerHTML = '<div class=\"pn-vista\">' + cab('Inscripciones') + vacio('calendario', 'Primero crea una actividad') + '</div>'; return; }\n    const lista = await llamar('api_inscripciones', P.actSel);\n    const filtro = P.filtroIns || 'todas';\n    const vis = lista.filter((i) => filtro === 'todas' || i.estado === filtro || (filtro === 'validada' && i.estado === 'generando') ||\n      (filtro === 'curso' && ['generado', 'firma', 'firmado', 'revisar'].indexOf(i.estado) > -1));\n    const n = (e) => lista.filter((i) => e.indexOf(i.estado) > -1).length;\n    const roles = ['Participante', 'Organización', 'Coordinación'];\n    const editable = (e) => ['pendiente', 'validada', 'rechazada', 'revisar'].indexOf(e) > -1;\n    const porGenerar = n(['validada', 'generando']);\n    $('vInscripciones').innerHTML = '<div class=\"pn-vista\">' + cab('Inscripciones',\n      '<button class=\"boton\" id=\"irImportar\">' + ic('hoja') + 'Importar de una hoja</button><button class=\"boton primario\" id=\"irGenerar\"' + (porGenerar ? '' : ' disabled') + '>' + ic('paleta') + 'Generar certificados (' + porGenerar + ')</button>',\n      'Comprueba quién participó y con qué rol, y valida. Las personas validadas pasan a «Diseñar y generar».') +\n      '<div class=\"filtros\">' + selectorAct('selAct', acts, P.actSel) +\n      '<div class=\"seg\" id=\"segFiltro\" role=\"tablist\">' + [['todas', 'Todas', lista.length], ['pendiente', 'Por validar', n(['pendiente'])], ['validada', 'Validadas', porGenerar],\n        ['curso', 'En curso', n(['generado', 'firma', 'firmado', 'revisar'])], ['enviado', 'Enviadas', n(['enviado'])], ['rechazada', 'Rechazadas', n(['rechazada'])]]\n        .map((f) => '<button role=\"tab\" aria-selected=\"' + (f[0] === filtro) + '\" data-f=\"' + f[0] + '\" class=\"' + (f[0] === filtro ? 'activo' : '') + '\">' + f[1] + ' (' + f[2] + ')</button>').join('') + '</div></div>' +\n      (vis.length ? '<div class=\"tabla-env\"><table class=\"tabla\"><thead><tr><th><input type=\"checkbox\" id=\"selTodas\" aria-label=\"Seleccionar todas\"></th><th>Persona</th><th>DNI/NIE</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>' +\n        vis.map((i) => '<tr data-reg=\"' + i.reg + '\"><td>' + (editable(i.estado) ? '<input type=\"checkbox\" class=\"sel\" aria-label=\"Seleccionar a ' + esc(i.nombreCompleto) + '\">' : '') + '</td>' +\n          '<td><b>' + esc(i.nombreCompleto) + '</b><div class=\"ayuda\">' + (i.emailOculto ? esc(i.emailOculto) : '<span style=\"color:var(--mal)\">sin correo</span>') + ' · ' + esc(i.fecha) + ' · ' + (ORIGEN[i.origen] || esc(i.origen)) +\n            (i.notas ? '<br><span style=\"color:var(--mal)\">' + esc(i.notas) + '</span>' : '') + '</div></td>' +\n          '<td style=\"white-space:nowrap\"><span class=\"dni\">' + esc(i.dniOculto) + '</span> <button class=\"boton peq icono fantasma ver\" aria-label=\"Ver el DNI completo\" title=\"Ver DNI (queda registrado)\">' + ic('ojo', 'peq') + '</button></td>' +\n          '<td>' + (editable(i.estado) ? '<select class=\"rol\" aria-label=\"Rol\">' + roles.map((r) => '<option' + (r === i.rol ? ' selected' : '') + '>' + r + '</option>').join('') + '</select>' : esc(i.rol)) + '</td>' +\n          '<td>' + chip(i.estado, i.codigo) + '</td>' +\n          '<td class=\"acc\"><button class=\"boton peq corregir\">' + ic('lapiz', 'peq') + 'Corregir</button></td></tr>').join('') + '</tbody></table></div>'\n        : vacio('personas', 'No hay inscripciones en este filtro', 'Comparte el formulario de inscripción o importa una hoja de Drive.')) +\n      '<div class=\"barra-lote oculto\" id=\"lote\"><span id=\"loteN\"></span><span style=\"margin-left:auto\"></span>' +\n      '<button class=\"boton primario\" data-lote=\"validada\">' + ic('ok') + 'Validar</button><button class=\"boton\" data-lote=\"rechazada\">Rechazar</button><button class=\"boton\" data-lote=\"pendiente\">Volver a pendiente</button></div></div>';\n    const v = $('vInscripciones');\n    $('selAct').onchange = () => { P.actSel = $('selAct').value; vInscripciones(); };\n    v.querySelectorAll('#segFiltro button').forEach((b) => { b.onclick = () => { P.filtroIns = b.dataset.f; vInscripciones(); }; });\n    $('irGenerar').onclick = () => ir('editor', { act: P.actSel, tab: 'generar' });\n    $('irImportar').onclick = () => ir('importar', { act: P.actSel });\n    const actualizarLote = () => { const n2 = v.querySelectorAll('.sel:checked').length; $('lote').classList.toggle('oculto', !n2); $('loteN').textContent = n2 + ' seleccionada(s)'; };\n    v.querySelectorAll('.sel').forEach((c) => { c.onchange = actualizarLote; });\n    if ($('selTodas')) $('selTodas').onchange = () => { v.querySelectorAll('.sel').forEach((c) => { c.checked = $('selTodas').checked; }); actualizarLote(); };\n    v.querySelectorAll('[data-lote]').forEach((b) => {\n      b.onclick = async () => {\n        const regs = [...v.querySelectorAll('.sel:checked')].map((c) => c.closest('tr').dataset.reg);\n        try { const k = await llamar('api_cambiarInscripciones', regs, { estado: b.dataset.lote }); aviso(k + ' actualizada(s).'); await actividades(); vInscripciones(); }\n        catch (e) { aviso(e.message); }\n      };\n    });\n    v.querySelectorAll('select.rol').forEach((s) => {\n      s.onchange = async () => { try { await llamar('api_cambiarInscripciones', [s.closest('tr').dataset.reg], { rol: s.value }); aviso('Rol cambiado.'); } catch (e) { aviso(e.message); } };\n    });\n    v.querySelectorAll('button.ver').forEach((a) => {\n      a.onclick = async () => { const tr = a.closest('tr'); try { tr.querySelector('.dni').textContent = await llamar('api_revelarDni', tr.dataset.reg); a.remove(); } catch (x) { aviso(x.message); } };\n    });\n    v.querySelectorAll('button.corregir').forEach((b) => { b.onclick = () => modalCorregir(lista.find((x) => x.reg === b.closest('tr').dataset.reg), () => vInscripciones()); });\n  }\n  function modalCorregir(i, despues) {\n    modal('<h2>Corregir datos</h2><p class=\"ayuda\">Se aplican a todas las inscripciones de esta persona y quedan anotados en el registro.</p>' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"cNombre\">Nombre</label><input type=\"text\" id=\"cNombre\" value=\"' + esc(i.nombre) + '\"></div><div><label class=\"etq\" for=\"cApellidos\">Apellidos</label><input type=\"text\" id=\"cApellidos\" value=\"' + esc(i.apellidos) + '\"></div></div>' +\n      '<label class=\"etq\" for=\"cDni\">DNI/NIE <small>(déjalo vacío para no cambiarlo)</small></label><input type=\"text\" id=\"cDni\" placeholder=\"' + esc(i.dniOculto) + '\">' +\n      '<label class=\"etq\" for=\"cEmail\">Correo <small>(déjalo vacío para no cambiarlo)</small></label><input type=\"email\" id=\"cEmail\" placeholder=\"' + esc(i.emailOculto || 'sin correo') + '\">' +\n      '<div class=\"pie\"><button class=\"boton\" data-cerrar>Cancelar</button><button class=\"boton primario\" id=\"cGuardar\">Guardar</button></div>', (f, cerrar) => {\n      f.querySelector('#cGuardar').onclick = async () => {\n        const c = { nombre: f.querySelector('#cNombre').value, apellidos: f.querySelector('#cApellidos').value };\n        if (f.querySelector('#cDni').value.trim()) c.dni = f.querySelector('#cDni').value;\n        if (f.querySelector('#cEmail').value.trim()) c.email = f.querySelector('#cEmail').value;\n        try { await llamar('api_corregirPersona', i.persona, c); cerrar(); aviso('Datos corregidos.'); if (despues) despues(); } catch (e) { aviso(e.message); }\n      };\n    });\n  }\n\n  // ─────────── FORMULARIOS ───────────\n  const NOMBRE_TIPO = { escala: 'Escala 1–5', unica: 'Una opción', multiple: 'Varias opciones', corto: 'Respuesta corta', largo: 'Respuesta larga' };\n  const CLAVES = { '': '—', general: 'Valoración general', comentario: 'Comentario (lo que se lleva)', mejora: 'Propuesta de mejora' };\n  async function vFormularios(op) {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    if (op && op.act) P.actSel = op.act;\n    if (!P.actSel || !acts.some((a) => a.id === P.actSel)) P.actSel = (acts[0] || {}).id || '';\n    if (!acts.length) { $('vFormularios').innerHTML = '<div class=\"pn-vista\">' + cab('Formularios') + vacio('calendario', 'Primero crea una actividad') + '</div>'; return; }\n    P.tipoForm = (op && op.tipo) || P.tipoForm || 'inscripcion';\n    const d = await llamar('api_formularios', P.actSel);\n    const F = { def: JSON.parse(JSON.stringify(d[P.tipoForm])), guardado: '' };\n    F.guardado = JSON.stringify(F.def);\n    const tipo = P.tipoForm, esEval = tipo === 'evaluacion';\n    const abierto = esEval ? d.actividad.evaluacion : d.actividad.abierta;\n    $('vFormularios').innerHTML = '<div class=\"pn-vista\">' + cab('Formularios', '',\n      'Diseña lo que ve el alumnado. La inscripción siempre pide nombre, apellidos, DNI, correo, rol y los consentimientos; aquí añades lo demás. La evaluación es anónima.') +\n      '<div class=\"filtros\">' + selectorAct('fSelAct', acts, P.actSel) +\n      '<div class=\"seg\" role=\"tablist\"><button role=\"tab\" data-t=\"inscripcion\" aria-selected=\"' + !esEval + '\" class=\"' + (!esEval ? 'activo' : '') + '\">Inscripción</button>' +\n      '<button role=\"tab\" data-t=\"evaluacion\" aria-selected=\"' + esEval + '\" class=\"' + (esEval ? 'activo' : '') + '\">Evaluación</button></div></div>' +\n      '<div class=\"fb\"><div>' +\n        '<div class=\"caja\"><h3>' + ic('enlace') + (esEval ? 'Enlace de la evaluación' : 'Enlace de la inscripción') + '<span class=\"acciones\">' + interruptor('fAbierto', abierto, abierto ? 'Abierto' : 'Cerrado') + '</span></h3>' +\n          '<div class=\"lista-enlaces\">' + enlaceFila(d.actividad.nombre, d.urls[tipo]) + '</div></div>' +\n        '<div class=\"caja\"><h3>' + ic('formulario') + 'Cabecera<span class=\"acciones\">' + (d.ia ? '<button class=\"boton peq ia\" id=\"fIa\">' + ic('ia', 'peq') + 'Proponer con IA</button>' : '') + '</span></h3>' +\n          '<label class=\"etq\" for=\"fTitulo\">Título</label><input type=\"text\" id=\"fTitulo\" maxlength=\"140\">' +\n          '<label class=\"etq\" for=\"fIntro\">Introducción</label><textarea id=\"fIntro\" rows=\"3\" maxlength=\"1200\"></textarea>' +\n          '<span class=\"etq\">Color</span><div class=\"colores\" id=\"fColores\"></div>' +\n          '<label class=\"etq\" for=\"fCierre\">Mensaje al terminar</label><input type=\"text\" id=\"fCierre\" maxlength=\"400\"></div>' +\n        '<div class=\"caja\"><h3>' + ic('lista') + 'Preguntas' + (esEval ? '' : ' adicionales') + '</h3><div id=\"fPreguntas\"></div>' +\n          '<div style=\"display:flex;gap:6px;flex-wrap:wrap\">' + Object.keys(NOMBRE_TIPO).map((k) => '<button class=\"boton peq suave\" data-anadir=\"' + k + '\">' + ic('mas', 'peq') + NOMBRE_TIPO[k] + '</button>').join('') + '</div>' +\n          (esEval ? '<p class=\"ayuda\" style=\"margin:12px 0 0\">Marca qué pregunta es la <b>valoración general</b>, cuál recoge <b>lo que se llevan</b> y cuál las <b>propuestas de mejora</b>: así salen en el informe.</p>' : '<p class=\"ayuda\" style=\"margin:12px 0 0\">No pidas datos de salud, religión ni otros datos sensibles: no hacen falta para el certificado.</p>') + '</div>' +\n        '<div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center\"><button class=\"boton primario\" id=\"fGuardar\">' + ic('ok') + 'Guardar formulario</button>' +\n          (d.propio[tipo] ? '<button class=\"boton\" id=\"fRestablecer\">Volver al formulario base</button>' : '') + '<span class=\"ayuda\" id=\"fEstado\"></span></div>' +\n      '</div><div><div class=\"movil-marco\" aria-label=\"Vista previa en un móvil\"><div class=\"pantalla\" id=\"fVista\"></div></div><p class=\"ayuda\" style=\"text-align:center\">Vista previa: así lo verá el alumnado en el móvil.</p></div></div></div>';\n    const v = $('vFormularios');\n    $('fSelAct').onchange = async () => { if (cambiado() && !(await preguntar('Hay cambios sin guardar', '¿Cambiar de actividad igualmente?', 'Cambiar'))) { $('fSelAct').value = P.actSel; return; } P.actSel = $('fSelAct').value; vFormularios(); };\n    v.querySelectorAll('[data-t]').forEach((b) => { b.onclick = async () => { if (cambiado() && !(await preguntar('Hay cambios sin guardar', '¿Cambiar de formulario igualmente?', 'Cambiar'))) return; P.tipoForm = b.dataset.t; vFormularios(); }; });\n    enlazarEnlaces(v);\n    $('fAbierto').onchange = async () => {\n      const c = $('fAbierto');\n      try { await llamar('api_guardarActividad', { id: P.actSel, [esEval ? 'evaluacion' : 'abierta']: c.checked }); c.nextElementSibling.nextElementSibling.textContent = c.checked ? 'Abierto' : 'Cerrado'; aviso(c.checked ? 'Formulario abierto.' : 'Formulario cerrado.'); actividades(); }\n      catch (e) { c.checked = !c.checked; aviso(e.message); }\n    };\n    const cambiado = () => JSON.stringify(F.def) !== F.guardado;\n    const estado = () => { $('fEstado').textContent = cambiado() ? 'Cambios sin guardar' : 'Guardado'; $('fEstado').style.color = cambiado() ? 'var(--aviso)' : ''; };\n    const cabecera = () => {\n      $('fTitulo').value = F.def.titulo; $('fIntro').value = F.def.intro; $('fCierre').value = F.def.cierre || '';\n      $('fColores').innerHTML = PALETA.map((p) => '<button class=\"muestra' + (p[1].toLowerCase() === F.def.color.toLowerCase() ? ' activo' : '') + '\" style=\"background:' + p[1] + '\" data-color=\"' + p[1] + '\" aria-label=\"' + p[0] + '\" title=\"' + p[0] + '\"></button>').join('') +\n        '<input type=\"color\" id=\"fColor\" value=\"' + F.def.color + '\" aria-label=\"Otro color\">';\n      $('fColores').querySelectorAll('[data-color]').forEach((b) => { b.onclick = () => { F.def.color = b.dataset.color; cabecera(); cambio(); }; });\n      $('fColor').oninput = () => { F.def.color = $('fColor').value; cambio(); };\n    };\n    ['fTitulo', 'fIntro', 'fCierre'].forEach((id) => { $(id).oninput = () => { F.def[{ fTitulo: 'titulo', fIntro: 'intro', fCierre: 'cierre' }[id]] = $(id).value; cambio(); }; });\n    const preguntas = () => {\n      $('fPreguntas').innerHTML = F.def.preguntas.length ? F.def.preguntas.map((q, k) => '<div class=\"preg\" data-k=\"' + k + '\">' +\n        '<div class=\"preg-cab\"><span class=\"n\">' + (k + 1) + '</span><select data-campo=\"tipo\" aria-label=\"Tipo de pregunta\">' + Object.keys(NOMBRE_TIPO).map((t) => '<option value=\"' + t + '\"' + (t === q.tipo ? ' selected' : '') + '>' + NOMBRE_TIPO[t] + '</option>').join('') + '</select>' +\n          (esEval ? '<select data-campo=\"clave\" aria-label=\"Uso en el informe\">' + Object.keys(CLAVES).map((c) => '<option value=\"' + c + '\"' + (c === (q.clave || '') ? ' selected' : '') + '>' + CLAVES[c] + '</option>').join('') + '</select>' : '') +\n          '<span class=\"der\"><button class=\"boton peq icono fantasma\" data-mover=\"-1\" aria-label=\"Subir\"' + (k ? '' : ' disabled') + '>' + ic('arriba', 'peq') + '</button>' +\n          '<button class=\"boton peq icono fantasma\" data-mover=\"1\" aria-label=\"Bajar\"' + (k < F.def.preguntas.length - 1 ? '' : ' disabled') + '>' + ic('abajo', 'peq') + '</button>' +\n          '<button class=\"boton peq icono fantasma peligro\" data-quitar aria-label=\"Quitar la pregunta\">' + ic('papelera', 'peq') + '</button></span></div>' +\n        '<label class=\"etq\">Pregunta</label><input type=\"text\" data-campo=\"texto\" value=\"' + esc(q.texto) + '\" maxlength=\"300\">' +\n        ((q.tipo === 'unica' || q.tipo === 'multiple') ? '<label class=\"etq\">Opciones <small>(una por línea)</small></label><textarea data-campo=\"opciones\" rows=\"3\">' + esc((q.opciones || []).join('\\n')) + '</textarea>' : '') +\n        '<div style=\"margin-top:6px\">' + interruptor('', q.obligatoria, 'Obligatoria', ' data-campo=\"obligatoria\"') + '</div></div>').join('')\n        : '<p class=\"ayuda\" style=\"margin:0 0 12px\">' + (esEval ? 'Añade al menos una pregunta.' : 'Sin preguntas adicionales: solo se pedirán los datos para el certificado.') + '</p>';\n      $('fPreguntas').querySelectorAll('.preg').forEach((el) => {\n        const q = F.def.preguntas[Number(el.dataset.k)];\n        el.querySelectorAll('[data-campo]').forEach((c) => {\n          const campo = c.dataset.campo;\n          const ev = c.tagName === 'SELECT' || c.type === 'checkbox' ? 'onchange' : 'oninput';\n          c[ev] = () => {\n            if (campo === 'obligatoria') q.obligatoria = c.checked;\n            else if (campo === 'opciones') q.opciones = c.value.split('\\n');\n            else if (campo === 'clave') { if (c.value) q.clave = c.value; else delete q.clave; }\n            else q[campo] = c.value;\n            if (campo === 'tipo') { if ((q.tipo === 'unica' || q.tipo === 'multiple') && !(q.opciones || []).length) q.opciones = ['Sí', 'No']; preguntas(); }\n            cambio();\n          };\n        });\n        el.querySelectorAll('[data-mover]').forEach((b) => { b.onclick = () => { const k = Number(el.dataset.k), j = k + Number(b.dataset.mover); const l = F.def.preguntas; [l[k], l[j]] = [l[j], l[k]]; preguntas(); cambio(); }; });\n        el.querySelector('[data-quitar]').onclick = () => { F.def.preguntas.splice(Number(el.dataset.k), 1); preguntas(); cambio(); };\n      });\n    };\n    v.querySelectorAll('[data-anadir]').forEach((b) => {\n      b.onclick = () => {\n        const t = b.dataset.anadir;\n        F.def.preguntas.push({ id: 'q' + Date.now().toString(36), tipo: t, texto: '', obligatoria: false, opciones: t === 'unica' || t === 'multiple' ? ['Sí', 'No'] : undefined });\n        preguntas(); cambio();\n        const ult = $('fPreguntas').querySelector('.preg:last-child input[data-campo=\"texto\"]'); if (ult) ult.focus();\n      };\n    });\n    const vista = () => {\n      const def = F.def;\n      const valida = Object.assign({}, def, { preguntas: def.preguntas.filter((q) => q.texto && (!(q.tipo === 'unica' || q.tipo === 'multiple') || (q.opciones || []).filter(String).length >= 2))\n        .map((q) => Object.assign({}, q, { opciones: (q.opciones || []).filter(String) })) });\n      $('fVista').innerHTML = '<div class=\"pv-cab\" style=\"background:' + esc(def.color) + '\"><small>' + (esEval ? 'Evaluación · ' : 'Inscripción · ') + esc(d.actividad.tipo || 'Pastoral') + '</small><h2>' + esc(def.titulo) + '</h2><p>' + esc(def.intro) + '</p></div>' +\n        '<div class=\"pv-cuerpo\">' + (esEval ? '' : '<div class=\"pv-fijo\">' + ic('candado', 'peq') + ' Siempre se piden: nombre, apellidos, DNI/NIE, correo y cómo participaste, y los dos consentimientos RGPD.</div>') +\n        '<div id=\"fvPrev\"></div><button class=\"boton primario\" style=\"width:100%\" tabindex=\"-1\" aria-hidden=\"true\">' + (esEval ? 'Enviar mi valoración' : 'Enviar inscripción') + '</button></div>';\n      window.FV.montar($('fvPrev'), valida, 'pv_');\n    };\n    const cambio = () => { estado(); clearTimeout(F.t); F.t = setTimeout(vista, 120); };\n    $('fGuardar').onclick = async () => {\n      try { F.def = await llamar('api_guardarFormulario', P.actSel, tipo, F.def); F.guardado = JSON.stringify(F.def); cabecera(); preguntas(); vista(); estado(); aviso('Formulario guardado.'); }\n      catch (e) { aviso(e.message); }\n    };\n    if ($('fRestablecer')) $('fRestablecer').onclick = async () => {\n      if (!(await preguntar('¿Volver al formulario base?', 'Se descartará el formulario propio de esta actividad.', 'Volver al base', true))) return;\n      try { await llamar('api_guardarFormulario', P.actSel, tipo, null); vFormularios(); } catch (e) { aviso(e.message); }\n    };\n    if ($('fIa')) $('fIa').onclick = async () => {\n      if (!d.actividad.contexto) aviso('Consejo: escribe el contexto de la actividad en «Actividades > Editar» para que la propuesta sea más precisa.');\n      try { cargando(true, 'La IA está preparando una propuesta…'); const s = await llamar('api_iaFormulario', P.actSel, tipo); F.def = s; cabecera(); preguntas(); cambio(); aviso('Propuesta lista: revísala y guarda si te convence.'); }\n      catch (e) { aviso(e.message); } finally { cargando(false); }\n    };\n    cabecera(); preguntas(); vista(); estado();\n  }\n\n  // ─────────── IMPORTAR DE DRIVE ───────────\n  async function vImportar(op) {\n    const acts = P.actividades.length ? P.actividades : await actividades();\n    if (op && op.act) P.actSel = op.act;\n    if (!P.actSel || !acts.some((a) => a.id === P.actSel)) P.actSel = (acts[0] || {}).id || '';\n    const enlazadas = acts.filter((a) => a.enlace);\n    $('vImportar').innerHTML = '<div class=\"pn-vista\">' + cab('Importar de Drive', '',\n      'Trae las respuestas de un formulario de Google (o cualquier hoja de cálculo) a una actividad. Los DNI y correos van directos a la bóveda. Si la dejas <b>enlazada</b>, cada hora se importan solas las respuestas nuevas.') +\n      (acts.length ? '' : vacio('calendario', 'Primero crea una actividad')) +\n      '<div class=\"caja\"><h2>' + ic('hoja') + '1. La hoja de cálculo</h2>' +\n        '<label class=\"etq\" for=\"hUrl\">Dirección de la hoja <small>(en Google Forms: Respuestas › Ver en Hojas de cálculo, y copia la dirección)</small></label>' +\n        '<div class=\"enlace-copia\"><input type=\"url\" id=\"hUrl\" placeholder=\"https://docs.google.com/spreadsheets/d/…\" value=\"' + esc(P.hojaUrl || '') + '\"><button class=\"boton primario\" id=\"hAbrir\">Abrir</button></div>' +\n        '<p class=\"ayuda\" style=\"margin:10px 0 0\">Si la hoja es de otra cuenta, compártela como lectora con la cuenta propietaria de la app.</p></div>' +\n      '<div id=\"hPaso2\"></div>' +\n      (enlazadas.length ? '<div class=\"caja\"><h2>' + ic('enlace') + 'Hojas enlazadas</h2><div class=\"lista-enlaces\">' + enlazadas.map((a) =>\n        '<div data-id=\"' + a.id + '\"><b>' + esc(a.nombre) + '<div class=\"ayuda\" style=\"font-weight:600\">' + esc(a.enlace.nombre || '') + ' › ' + esc(a.enlace.hoja || '') + ' · última vez: ' + esc(a.enlace.ultima || '—') + ' · ' + a.enlace.total + ' importadas</div></b>' +\n        '<button class=\"boton peq\" data-sinc>' + ic('recargar', 'peq') + 'Sincronizar ahora</button><button class=\"boton peq peligro\" data-desen>Desenlazar</button></div>').join('') + '</div></div>' : '') + '</div>';\n    $('hAbrir').onclick = () => abrirHoja();\n    $('hUrl').onkeydown = (e) => { if (e.key === 'Enter') abrirHoja(); };\n    $('vImportar').querySelectorAll('[data-sinc]').forEach((b) => {\n      b.onclick = async () => { const id = b.closest('[data-id]').dataset.id; try { cargando(true, 'Sincronizando…'); mostrarResultado(await llamar('api_hojaSincronizar', id)); await actividades(); } catch (e) { aviso(e.message); } finally { cargando(false); } };\n    });\n    $('vImportar').querySelectorAll('[data-desen]').forEach((b) => {\n      b.onclick = async () => { const id = b.closest('[data-id]').dataset.id; if (!(await preguntar('¿Desenlazar la hoja?', 'Lo ya importado se queda. Simplemente dejarán de traerse respuestas nuevas.', 'Desenlazar', true))) return; try { await llamar('api_hojaDesenlazar', id); await actividades(); vImportar(); } catch (e) { aviso(e.message); } };\n    });\n  }\n  async function abrirHoja(nombreHoja) {\n    P.hojaUrl = $('hUrl').value.trim();\n    if (!P.hojaUrl) return aviso('Pega la dirección de la hoja.');\n    let h;\n    try { cargando(true, 'Abriendo la hoja…'); h = await llamar('api_hojaAbrir', P.hojaUrl, nombreHoja || ''); } catch (e) { aviso(e.message); return; } finally { cargando(false); }\n    const acts = P.actividades;\n    const opciones = (sel) => '<option value=\"\">— no está —</option>' + h.cabeceras.map((c, i) => '<option value=\"' + i + '\"' + (sel === i ? ' selected' : '') + '>' + esc(c || ('Columna ' + (i + 1))) + '</option>').join('');\n    const ejemplo = (i) => i === undefined || i === '' ? '' : h.ejemplos.map((f) => f[i]).filter(String).slice(0, 2).join(' · ');\n    $('hPaso2').innerHTML = '<div class=\"caja\"><h2>' + ic('lista') + '2. Qué columna es cada dato</h2>' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"hHoja\">Pestaña</label><select id=\"hHoja\">' + h.hojas.map((x) => '<option' + (x === h.hoja ? ' selected' : '') + '>' + esc(x) + '</option>').join('') + '</select></div>' +\n      '<div><label class=\"etq\" for=\"hAct\">Actividad a la que se importan</label>' + selectorAct('hAct', acts, P.actSel) + '</div></div>' +\n      '<p class=\"ayuda\">«' + esc(h.nombre) + '» · ' + h.filas + ' fila(s) con respuestas. Los ejemplos aparecen enmascarados.</p>' +\n      '<div class=\"mapa\">' + Object.keys(h.campos).map((k) => '<label class=\"etq\" style=\"margin:0\" for=\"hc_' + k + '\">' + esc(h.campos[k]) + (k === 'dni' ? ' *' : '') + '</label>' +\n        '<select id=\"hc_' + k + '\" data-campo=\"' + k + '\">' + opciones(h.sugerencia[k]) + '</select><span class=\"ej\" data-ej=\"' + k + '\">' + esc(ejemplo(h.sugerencia[k])) + '</span>').join('') + '</div>' +\n      '<div class=\"fila2\"><div><label class=\"etq\" for=\"hRol\">Rol si la hoja no lo dice</label><select id=\"hRol\">' + h.roles.map((r) => '<option>' + r + '</option>').join('') + '</select></div>' +\n      '<div><label class=\"etq\" for=\"hFiltro\">Solo filas cuya actividad contenga <small>(si el formulario sirve para varias)</small></label><input type=\"text\" id=\"hFiltro\" placeholder=\"Por ejemplo: Adviento\"></div></div>' +\n      '<label class=\"interruptor\" style=\"margin-top:14px;align-items:flex-start\"><input type=\"checkbox\" id=\"hConsent\"><span class=\"pista\" aria-hidden=\"true\" style=\"margin-top:2px\"></span><span>Confirmo que el formulario informa de la privacidad y recoge el consentimiento del alumnado (RGPD arts. 6.1.a y 9.2.a).</span></label>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:16px\"><button class=\"boton\" id=\"hUnaVez\">' + ic('descargar') + 'Importar una vez</button>' +\n      '<button class=\"boton primario\" id=\"hEnlazar\">' + ic('enlace') + 'Importar y dejar enlazada</button></div><div id=\"hResultado\"></div></div>';\n    $('hHoja').onchange = () => abrirHoja($('hHoja').value);\n    $('hAct').onchange = () => { P.actSel = $('hAct').value; };\n    $('hPaso2').querySelectorAll('[data-campo]').forEach((s) => { s.onchange = () => { $('hPaso2').querySelector('[data-ej=\"' + s.dataset.campo + '\"]').textContent = ejemplo(s.value === '' ? undefined : Number(s.value)); }; });\n    const importar = async (enlazar) => {\n      const columnas = {};\n      $('hPaso2').querySelectorAll('[data-campo]').forEach((s) => { if (s.value !== '') columnas[s.dataset.campo] = Number(s.value); });\n      const cfg = { id: h.id, hoja: $('hHoja').value, columnas, rol: $('hRol').value, filtro: $('hFiltro').value, consentimiento: $('hConsent').checked };\n      try { cargando(true, 'Importando…'); const r = await llamar('api_hojaImportar', $('hAct').value, cfg, enlazar); mostrarResultado(r, enlazar); await actividades(); }\n      catch (e) { aviso(e.message); } finally { cargando(false); }\n    };\n    $('hUnaVez').onclick = () => importar(false);\n    $('hEnlazar').onclick = () => importar(true);\n  }\n  function mostrarResultado(r, enlazada) {\n    const html = '<div class=\"' + (r.errores.length ? 'aviso' : 'exito-msg') + '\" style=\"margin-top:16px\">' + ic(r.errores.length ? 'aviso' : 'ok') + '<div><b>' + r.nuevas + ' inscripción(es) nuevas</b> · ' + r.repetidas + ' ya estaban · ' +\n     